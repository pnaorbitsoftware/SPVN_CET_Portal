<%- include('../partials/head') %>
<%
  const carriedTest = importDraft.testDefaults || {};
  const carriedGroups = (carriedTest.groupIds || []).map(id => id.toString());
  const carriedCourses = carriedTest.courses || [];
%>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 min-w-0">
    <header class="sticky top-0 z-20 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
          <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <a href="/admin/questions/smart-import" class="text-slate-400 hover:text-slate-700">←</a>
          <div class="min-w-0">
            <h1 class="text-lg font-bold text-slate-900">Review Scanned Questions</h1>
            <p class="text-xs text-slate-500 truncate"><%= importDraft.sourceFiles.map(file => file.name).join(' · ') %></p>
          </div>
        </div>
        <form action="/admin/questions/smart-import/<%= importDraft._id %>/discard" method="POST" onsubmit="return confirm('Discard this import draft?')">
          <button type="submit" class="text-xs font-semibold text-rose-600 border border-rose-200 bg-rose-50 hover:bg-rose-100 rounded-lg px-3 py-2">Discard</button>
        </form>
      </div>
    </header>

    <div class="p-5 lg:p-8 max-w-6xl mx-auto">
      <%- include('../partials/flash') %>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
        <div class="bg-white border border-slate-200 rounded-xl p-4"><p class="text-2xl font-bold text-slate-900"><%= importDraft.questions.length %></p><p class="text-xs text-slate-500">Detected questions</p></div>
        <div class="bg-white border border-slate-200 rounded-xl p-4"><p class="text-2xl font-bold text-emerald-600"><%= importDraft.questions.filter(q => q.confidence >= 0.85 && (q.questionType === 'NUMERICAL' ? (q.numericalAnswer?.value !== null || (q.numericalAnswer?.min !== null && q.numericalAnswer?.max !== null)) : q.questionType === 'MULTIPLE_CORRECT' ? q.correctAnswers?.length >= 2 : q.correctAnswer !== 'UNKNOWN')).length %></p><p class="text-xs text-slate-500">High confidence</p></div>
        <div class="bg-white border border-slate-200 rounded-xl p-4"><p class="text-2xl font-bold text-amber-600"><%= importDraft.questions.filter(q => q.confidence < 0.85 || (q.questionType === 'NUMERICAL' ? (q.numericalAnswer?.value === null && (q.numericalAnswer?.min === null || q.numericalAnswer?.max === null)) : q.questionType === 'MULTIPLE_CORRECT' ? q.correctAnswers?.length < 2 : q.correctAnswer === 'UNKNOWN')).length %></p><p class="text-xs text-slate-500">Needs attention</p></div>
        <div class="bg-white border border-slate-200 rounded-xl p-4"><p class="text-sm font-bold text-indigo-700 truncate mt-1"><%= ['openai','gemini'].includes(importDraft.extractionMethod) ? importDraft.extractionModel : 'Direct parser' %></p><p class="text-xs text-slate-500 mt-1">Extraction method</p></div>
      </div>

      <% if (importDraft.warnings.length) { %>
      <details class="mb-6 bg-amber-50 border border-amber-200 rounded-xl p-4" open>
        <summary class="cursor-pointer text-sm font-bold text-amber-900"><%= importDraft.warnings.length %> scanner warning(s) — review these carefully</summary>
        <ul class="mt-3 space-y-1.5 text-xs text-amber-800 list-disc pl-5 max-h-40 overflow-y-auto">
          <% importDraft.warnings.forEach(warning => { %><li><%= warning %></li><% }) %>
        </ul>
      </details>
      <% } %>

      <form id="reviewForm" action="/admin/questions/smart-import/<%= importDraft._id %>/commit" method="POST" onsubmit="return validateAndSubmit(event)">
        <input id="importActionInput" type="hidden" name="importAction" value=""/>
        <div class="sticky top-[73px] z-10 bg-slate-50/95 backdrop-blur border border-slate-200 rounded-xl p-3 mb-4 shadow-sm flex flex-wrap items-center gap-2">
          <span id="selectedCount" class="text-sm font-bold text-slate-800 mr-2"></span>
          <button type="button" onclick="setSelection('all')" class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50">Select all</button>
          <button type="button" onclick="setSelection('none')" class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50">Select none</button>
          <button type="button" onclick="setSelection('confident')" class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-emerald-200 text-emerald-700 bg-emerald-50 hover:bg-emerald-100">Only high confidence</button>
          <label class="ml-auto flex items-center gap-2 text-xs text-slate-600 cursor-pointer">
            <input id="attentionOnly" type="checkbox" onchange="filterAttention()" class="rounded"/>
            Show only needs attention
          </label>
        </div>

        <div id="questionCards" class="space-y-4">
          <% importDraft.questions.forEach((q, index) => {
            const answerMissing = q.questionType === 'NUMERICAL' ? (q.numericalAnswer?.value === null && (q.numericalAnswer?.min === null || q.numericalAnswer?.max === null)) : q.questionType === 'MULTIPLE_CORRECT' ? q.correctAnswers?.length < 2 : q.correctAnswer === 'UNKNOWN';
            const optionsMissing = !['NUMERICAL','TRUE_FALSE'].includes(q.questionType) && (!q.optionA || !q.optionB || !q.optionC || !q.optionD);
            const needsAttention = q.confidence < 0.85 || answerMissing || !q.question || optionsMissing;
            const confidencePct = Math.round(q.confidence * 100);
          %>
          <article class="question-card bg-white rounded-2xl border <%= needsAttention ? 'border-amber-300' : 'border-slate-200' %> shadow-sm overflow-hidden" data-attention="<%= needsAttention ? '1' : '0' %>" data-confidence="<%= q.confidence %>">
            <div class="flex items-center gap-3 px-4 lg:px-5 py-3 <%= needsAttention ? 'bg-amber-50' : 'bg-slate-50' %> border-b <%= needsAttention ? 'border-amber-200' : 'border-slate-200' %>">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="questions[<%= index %>][selected]" value="1" class="question-select rounded w-4 h-4" <%= q.isSelected ? 'checked' : '' %> onchange="updateSelectionCount()"/>
                <span class="font-bold text-slate-800">Q<%= index + 1 %></span>
              </label>
              <span class="text-[11px] font-semibold rounded-full px-2.5 py-1 <%= q.confidence >= 0.85 ? 'bg-emerald-100 text-emerald-700' : q.confidence >= 0.65 ? 'bg-amber-100 text-amber-700' : 'bg-rose-100 text-rose-700' %>"><%= confidencePct %>% confidence</span>
              <% if (answerMissing) { %><span class="text-[11px] font-semibold bg-rose-100 text-rose-700 rounded-full px-2.5 py-1">Answer required</span><% } %>
              <span class="ml-auto text-[11px] text-slate-400 truncate max-w-[45%]" title="<%= q.sourceLabel %>"><%= q.sourceLabel || 'Source location unavailable' %></span>
            </div>

            <div class="p-4 lg:p-5 space-y-4">
              <div data-math-field>
                <label class="block text-xs font-semibold text-slate-600 mb-1.5">Question</label>
                <textarea name="questions[<%= index %>][question]" rows="2" class="math-input review-field w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"><%= q.question %></textarea>
                <div class="math-preview hidden mt-2 overflow-x-auto rounded-xl border border-indigo-100 bg-white px-4 py-3 text-slate-900"></div>
              </div>

              <input type="hidden" name="questions[<%= index %>][questionImage]" value="<%= q.questionImage || '' %>"/>
              <% if (q.questionImage) { %>
              <div class="rounded-xl border border-indigo-100 bg-indigo-50/60 p-3 overflow-x-auto">
                <p class="text-xs font-bold text-indigo-700 mb-2">Detected question image / diagram</p>
                <img src="<%= q.questionImage %>" alt="Detected visual for question <%= index + 1 %>" class="block w-auto h-auto max-w-full rounded-lg border border-white bg-white" loading="eager" decoding="async"/>
              </div>
              <% } %>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <% ['A','B','C','D'].forEach(letter => { %>
                <div data-math-field>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Option <%= letter %></label>
                  <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center text-xs font-bold shrink-0"><%= letter %></span>
                    <input type="text" name="questions[<%= index %>][option<%= letter %>]" value="<%= q['option'+letter] %>" class="math-input review-field w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"/>
                  </div>
                  <div class="math-preview hidden ml-9 mt-2 overflow-x-auto rounded-xl border border-indigo-100 bg-white px-3 py-2 text-slate-900"></div>
                </div>
                <% }) %>
              </div>

              <div class="grid grid-cols-2 lg:grid-cols-6 gap-3">
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Question type</label>
                  <select name="questions[<%= index %>][questionType]" class="type-field w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm">
                    <% ['SINGLE_CORRECT','MULTIPLE_CORRECT','NUMERICAL','TRUE_FALSE'].forEach(type => { %><option value="<%= type %>" <%= q.questionType === type ? 'selected' : '' %>><%= type.replaceAll('_',' ') %></option><% }) %>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Correct answer</label>
                  <select name="questions[<%= index %>][correctAnswer]" class="answer-field w-full border <%= q.correctAnswer === 'UNKNOWN' ? 'border-rose-300 bg-rose-50' : 'border-slate-200' %> rounded-xl px-3 py-2.5 text-sm">
                    <option value="" <%= q.correctAnswer === 'UNKNOWN' ? 'selected' : '' %>>Choose…</option>
                    <% ['A','B','C','D'].forEach(letter => { %><option value="<%= letter %>" <%= q.correctAnswer === letter ? 'selected' : '' %>><%= letter %></option><% }) %>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Multiple answers</label>
                  <input name="questions[<%= index %>][correctAnswers]" value="<%= (q.correctAnswers || []).join(',') %>" placeholder="A,B" class="multiple-answer-field w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/>
                </div>
                <div class="col-span-1 lg:col-span-2">
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Subject</label>
                  <select name="questions[<%= index %>][subject]" class="review-field w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm">
                    <% SUBJECTS.forEach(subject => { %><option value="<%= subject %>" <%= q.subject === subject ? 'selected' : '' %>><%= subject %></option><% }) %>
                    <% if (!SUBJECTS.includes(q.subject)) { %><option value="<%= q.subject %>" selected><%= q.subject %></option><% } %>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Difficulty</label>
                  <select name="questions[<%= index %>][difficulty]" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm">
                    <% ['Easy','Medium','Hard'].forEach(level => { %><option value="<%= level %>" <%= q.difficulty === level ? 'selected' : '' %>><%= level %></option><% }) %>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Marks</label>
                  <input type="number" name="questions[<%= index %>][marks]" value="<%= q.marks %>" min="0.25" max="100" step="0.25" class="review-field w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Answer source</label>
                  <div class="h-[42px] flex items-center text-xs font-medium text-slate-600 bg-slate-100 rounded-xl px-3"><%= q.answerSource.replace('_',' ') %></div>
                </div>
              </div>

              <div class="grid grid-cols-2 md:grid-cols-5 gap-3 bg-violet-50 border border-violet-100 rounded-xl p-3">
                <label class="text-xs font-semibold text-violet-800">Sub-Type<select name="questions[<%= index %>][questionSubType]" class="mt-1 w-full border border-violet-200 rounded-lg px-2 py-2 bg-white"><option value="">Not set</option><% ['conceptual','numerical','assertion_reason','statement_based','match_based','diagram_based','comprehension','formula_based','custom'].forEach(type => { %><option value="<%= type %>" <%= q.questionSubType === type ? 'selected' : '' %>><%= type.replaceAll('_',' ') %></option><% }) %></select></label>
                <label class="text-xs font-semibold text-violet-800">Exact Value<input type="number" step="any" name="questions[<%= index %>][numericalValue]" value="<%= q.numericalAnswer?.value ?? '' %>" class="numerical-value-field mt-1 w-full border border-violet-200 rounded-lg px-2 py-2 bg-white"/></label>
                <label class="text-xs font-semibold text-violet-800">Range Min<input type="number" step="any" name="questions[<%= index %>][numericalMin]" value="<%= q.numericalAnswer?.min ?? '' %>" class="mt-1 w-full border border-violet-200 rounded-lg px-2 py-2 bg-white"/></label>
                <label class="text-xs font-semibold text-violet-800">Range Max<input type="number" step="any" name="questions[<%= index %>][numericalMax]" value="<%= q.numericalAnswer?.max ?? '' %>" class="mt-1 w-full border border-violet-200 rounded-lg px-2 py-2 bg-white"/></label>
                <label class="text-xs font-semibold text-violet-800">Tolerance<input type="number" min="0" step="any" name="questions[<%= index %>][numericalTolerance]" value="<%= q.numericalAnswer?.tolerance ?? 0 %>" class="mt-1 w-full border border-violet-200 rounded-lg px-2 py-2 bg-white"/></label>
                <label class="text-xs font-semibold text-violet-800 col-span-full">Tags<input name="questions[<%= index %>][tags]" value="<%= (q.tags || []).join(', ') %>" placeholder="PYQ, Practice" class="mt-1 w-full border border-violet-200 rounded-lg px-2 py-2 bg-white"/></label>
              </div>

              <details>
                <summary class="text-xs font-semibold text-indigo-600 cursor-pointer">Topic, subtopic and explanation</summary>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-3">
                  <input type="text" name="questions[<%= index %>][topic]" value="<%= q.topic || '' %>" placeholder="Topic" class="border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/>
                  <input type="text" name="questions[<%= index %>][subtopic]" value="<%= q.subtopic || '' %>" placeholder="Subtopic" class="border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/>
                  <div data-math-field class="md:col-span-2">
                    <textarea name="questions[<%= index %>][explanation]" rows="2" placeholder="Explanation (optional)" class="math-input w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"><%= q.explanation || '' %></textarea>
                    <div class="math-preview hidden mt-2 overflow-x-auto rounded-xl border border-indigo-100 bg-white px-3 py-2 text-slate-900"></div>
                  </div>
                </div>
              </details>
            </div>
          </article>
          <% }) %>
        </div>

        <section class="mt-7 bg-white border border-indigo-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="flex items-start gap-3 p-5 lg:p-6 bg-indigo-50">
            <span class="w-9 h-9 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center shrink-0">🚀</span>
            <span>
              <strong class="block text-indigo-950">Test details for publishing</strong>
              <span class="block text-xs text-indigo-700 mt-1">These details are used only when you click “Save &amp; Publish Test”.</span>
            </span>
          </div>

          <div id="testPanel" class="p-5 lg:p-6 space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="md:col-span-2">
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Test title *</label>
                <input id="testTitle" type="text" name="testTitle" value="<%= carriedTest.title || ('Smart Import — ' + new Date().toLocaleDateString('en-IN')) %>" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Timing mode</label>
                <select id="timingMode" name="timingMode" onchange="updateTimingFields()" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"><% TIMING_MODES.forEach(mode => { %><option value="<%= mode %>" <%= (carriedTest.timingMode||'PERSONAL_DURATION')===mode?'selected':'' %>><%= mode.replaceAll('_',' ') %></option><% }) %></select>
              </div>
              <div id="durationField">
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Personal duration (minutes)</label>
                <input id="durationInput" type="number" name="duration" value="<%= carriedTest.duration || 180 %>" min="1" max="1440" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Negative marking</label>
                <input type="number" name="negativeMarking" value="<%= carriedTest.negativeMarking ?? 0.25 %>" min="0" step="0.25" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Start time</label>
                <input id="startTimeInput" type="datetime-local" name="startTime" value="<%= formatDateTimeLocal(carriedTest.startTime) %>" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">End time</label>
                <input id="endTimeInput" type="datetime-local" name="endTime" value="<%= formatDateTimeLocal(carriedTest.endTime) %>" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/>
                <p id="timingHint" class="mt-1 text-[10px] text-slate-400"></p>
              </div>
              <div class="md:col-span-2">
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Description</label>
                <textarea name="testDescription" rows="2" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm" placeholder="Optional student-facing description"><%= carriedTest.description || '' %></textarea>
              </div>
              <div class="md:col-span-2">
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Instructions</label>
                <textarea name="instructions" rows="2" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm" placeholder="Instructions for students"><%= carriedTest.instructions || '' %></textarea>
              </div>
              <label class="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2.5 text-sm font-semibold text-slate-700"><input id="testAccessEnabled" type="checkbox" name="testAccessEnabled" value="on" onchange="updateAccessField()" class="rounded"/> Require password / PIN</label>
              <div id="testAccessField" class="opacity-50"><label class="block text-xs font-semibold text-slate-700 mb-1.5">Password / PIN</label><input id="testAccessPassword" type="password" name="testAccessPassword" minlength="4" maxlength="64" disabled autocomplete="new-password" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm" placeholder="4–64 characters"/></div>
            </div>

            <div>
              <label class="block text-sm font-bold text-slate-800 mb-2">Assign batches</label>
              <% if (groups.length) { %>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
                <% groups.forEach(group => { %>
                <label class="flex items-center gap-2 border border-slate-200 rounded-xl px-3 py-2.5 cursor-pointer hover:bg-slate-50">
                  <input type="checkbox" name="groupIds" value="<%= group._id %>" class="group-checkbox rounded" <%= carriedGroups.includes(group._id.toString()) ? 'checked' : '' %>/>
                  <span class="text-sm text-slate-700"><%= group.name %><% if (group.course) { %> <span class="text-xs text-slate-400">(<%= group.course %>)</span><% } %></span>
                </label>
                <% }) %>
              </div>
              <% } else { %>
              <p class="text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-xl p-3">No active batch exists. You can still save to Question Bank, but create a batch before publishing a test.</p>
              <% } %>
            </div>

            <div>
              <label class="block text-sm font-bold text-slate-800 mb-2">Course tags</label>
              <div class="flex flex-wrap gap-2">
                <% COURSES.forEach(course => { %>
                <label class="flex items-center gap-2 border border-slate-200 rounded-xl px-3 py-2 cursor-pointer hover:bg-slate-50">
                  <input type="checkbox" name="courses" value="<%= course %>" class="rounded" <%= carriedCourses.includes(course) ? 'checked' : '' %>/>
                  <span class="text-sm text-slate-700"><%= course %></span>
                </label>
                <% }) %>
              </div>
            </div>

            <div class="flex flex-wrap gap-5 pt-2 border-t border-slate-100">
              <label class="flex items-center gap-2 text-sm cursor-pointer"><input type="checkbox" name="shuffleQuestions" value="on" checked class="rounded"/> Shuffle questions</label>
              <label class="flex items-center gap-2 text-sm cursor-pointer"><input type="checkbox" name="shuffleOptions" value="on" class="rounded"/> Shuffle options</label>
            </div>
          </div>
        </section>

        <div class="mt-6 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4 bg-slate-950 rounded-2xl p-4 lg:p-5 text-white">
          <div>
            <p class="font-bold">Choose what to do with the selected questions</p>
            <p class="text-xs text-slate-300 mt-1">Save only to Question Bank, or create and publish a test to students.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <button id="saveQuestionsButton" type="submit" value="save_questions" class="w-full sm:w-auto bg-white hover:bg-slate-100 text-slate-950 font-bold rounded-xl px-6 py-3 transition-colors">Save to Question Bank</button>
            <button id="publishTestButton" type="submit" value="publish_test" class="w-full sm:w-auto bg-indigo-500 hover:bg-indigo-400 text-white font-bold rounded-xl px-6 py-3 transition-colors">Save &amp; Publish Test</button>
          </div>
        </div>
      </form>
    </div>
  </main>
</div>

<div id="saveOverlay" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-6">
  <div class="bg-white rounded-2xl p-7 max-w-sm w-full text-center shadow-2xl">
    <div class="w-14 h-14 border-4 border-indigo-100 border-t-indigo-600 rounded-full animate-spin mx-auto mb-5"></div>
    <h3 id="saveOverlayTitle" class="font-bold text-slate-900 text-lg">Saving questions…</h3>
    <p id="saveOverlayText" class="text-sm text-slate-500 mt-2">Your selected questions are being saved safely.</p>
  </div>
</div>

<script>
const questionCards = Array.from(document.querySelectorAll('.question-card'));

function updateTimingFields() {
  const mode = document.getElementById('timingMode').value;
  const duration = document.getElementById('durationInput');
  const start = document.getElementById('startTimeInput');
  const end = document.getElementById('endTimeInput');
  document.getElementById('durationField').classList.toggle('opacity-50', mode !== 'PERSONAL_DURATION');
  duration.disabled = mode !== 'PERSONAL_DURATION';
  duration.required = mode === 'PERSONAL_DURATION';
  start.required = mode === 'FIXED_WINDOW';
  end.required = mode === 'FIXED_WINDOW';
  document.getElementById('timingHint').textContent = mode === 'FIXED_WINDOW'
    ? 'Required. Every attempt ends at this closing time.'
    : mode === 'UNTIMED' ? 'Optional access window; no countdown.' : 'Optional access window.';
}
function updateAccessField() {
  const enabled = document.getElementById('testAccessEnabled').checked;
  const password = document.getElementById('testAccessPassword');
  document.getElementById('testAccessField').classList.toggle('opacity-50', !enabled);
  password.disabled = !enabled;
  password.required = enabled;
}

function updateSelectionCount() {
  const selected = document.querySelectorAll('.question-select:checked').length;
  document.getElementById('selectedCount').textContent = `${selected} of ${questionCards.length} selected`;
}

function setSelection(mode) {
  questionCards.forEach(card => {
    const checkbox = card.querySelector('.question-select');
    if (mode === 'all') checkbox.checked = true;
    if (mode === 'none') checkbox.checked = false;
    if (mode === 'confident') checkbox.checked = Number(card.dataset.confidence) >= 0.85 && card.dataset.attention === '0';
  });
  updateSelectionCount();
}

function filterAttention() {
  const attentionOnly = document.getElementById('attentionOnly').checked;
  questionCards.forEach(card => {
    card.classList.toggle('hidden', attentionOnly && card.dataset.attention !== '1');
  });
}

function validateAndSubmit(event) {
  const action = event.submitter?.value || 'save_questions';
  document.getElementById('importActionInput').value = action;
  const selectedCards = questionCards.filter(card => card.querySelector('.question-select').checked);
  questionCards.forEach(card => card.classList.remove('ring-2','ring-rose-500'));
  if (!selectedCards.length) {
    alert('Select at least one question.');
    return false;
  }

  const invalidCard = selectedCards.find(card => {
    const fields = Array.from(card.querySelectorAll('.review-field'));
    const type = card.querySelector('.type-field').value;
    const answer = card.querySelector('.answer-field');
    const questionMissing = !String(fields[0]?.value || '').trim();
    const subjectMissing = !String(card.querySelector('select[name$="[subject]"]')?.value || '').trim();
    const options = Array.from(card.querySelectorAll('input[name*="[option"]'));
    const optionsMissing = !['NUMERICAL','TRUE_FALSE'].includes(type) && options.some(field => !String(field.value || '').trim());
    const answerMissing = type === 'MULTIPLE_CORRECT'
      ? card.querySelector('.multiple-answer-field').value.split(',').filter(Boolean).length < 2
      : type === 'NUMERICAL'
        ? !card.querySelector('.numerical-value-field').value && !(card.querySelector('input[name$="[numericalMin]"]').value && card.querySelector('input[name$="[numericalMax]"]').value)
        : !answer.value;
    return questionMissing || subjectMissing || optionsMissing || answerMissing;
  });
  if (invalidCard) {
    invalidCard.classList.add('ring-2','ring-rose-500');
    invalidCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
    alert('Fix the highlighted selected question. Required text, answer configuration, subject and marks must be complete for its question type.');
    return false;
  }

  if (action === 'publish_test') {
    if (!document.getElementById('testTitle').value.trim()) {
      alert('Enter a test title.');
      return false;
    }
    const selectedGroups = document.querySelectorAll('.group-checkbox:checked').length;
    if (!selectedGroups) {
      alert('Select at least one batch before publishing to student dashboards.');
      return false;
    }
  }

  document.getElementById('saveQuestionsButton').disabled = true;
  document.getElementById('publishTestButton').disabled = true;
  document.getElementById('saveOverlayTitle').textContent = action === 'publish_test' ? 'Publishing test…' : 'Saving to Question Bank…';
  document.getElementById('saveOverlayText').textContent = action === 'publish_test'
    ? 'Questions are being saved and the test is being sent to selected student dashboards.'
    : 'Questions are being saved without creating or publishing a test.';
  document.getElementById('saveOverlay').classList.remove('hidden');
  return true;
}

updateSelectionCount();
updateTimingFields();
updateAccessField();
</script>

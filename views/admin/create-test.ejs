          <div class="mt-4 bg-indigo-50 border border-indigo-200 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center gap-3">
            <div class="flex-1">
              <p class="text-sm font-bold text-indigo-950">Scan → edit questions → select batches → publish</p>
              <p class="text-xs text-indigo-700 mt-1">The test details and batches filled above are carried to the review screen automatically.</p>
            </div>
            <button form="smartScanForm" type="submit" class="shrink-0 bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-5 py-2.5 rounded-xl transition-colors">✨ Scan &amp; Review</button>
          </div>
        </div>

        <div class="flex gap-4">
          <button type="submit" class="flex-1 bg-navy-950 text-white font-bold py-4 rounded-xl hover:bg-navy-800 transition-colors text-base shadow-lg">Create Test</button>
          <a href="/admin/tests" class="px-8 py-4 border-2 border-slate-200 text-slate-700 font-semibold rounded-xl hover:bg-slate-50">Cancel</a>
        </div>
      </form>
      <form id="smartScanForm" action="/admin/questions/smart-import/scan" method="POST" enctype="multipart/form-data" class="hidden" onsubmit="return prepareEmbeddedSmartScan()">
        <input type="hidden" name="fromCreateTest" value="1"/>
        <input type="hidden" name="subject" id="smartDefaultSubject" value="Physics"/>
        <input type="hidden" name="difficulty" value="Medium"/>
        <input type="hidden" name="marks" value="1"/>
        <input type="hidden" name="testTitle" id="smartTestTitle"/>
        <input type="hidden" name="testDescription" id="smartTestDescription"/>
        <input type="hidden" name="testDuration" id="smartTestDuration"/>
        <input type="hidden" name="testNegativeMarking" id="smartTestNegativeMarking"/>
        <input type="hidden" name="testStartTime" id="smartTestStartTime"/>
        <input type="hidden" name="testEndTime" id="smartTestEndTime"/>
        <input type="hidden" name="testInstructions" id="smartTestInstructions"/>
        <div id="smartCarriedSelections"></div>
      </form>
    </div>
  </main>
</div>
<div id="embeddedScanOverlay" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-6">
  <div class="bg-white rounded-2xl p-7 max-w-sm w-full text-center shadow-2xl">
    <div class="w-14 h-14 border-4 border-indigo-100 border-t-indigo-600 rounded-full animate-spin mx-auto mb-5"></div>
    <h3 class="font-bold text-slate-900 text-lg">Scanning every question…</h3>
    <p class="text-sm text-slate-500 mt-2">Please keep this page open. You will review the detected questions next.</p>
  </div>
</div>
<script>
// ── Counter ───────────────────────────────────────────────────────────────
function updCount() {
  const selected = [...document.querySelectorAll('input[name="questionIds"]:checked')];
  const total = selected.reduce((sum, checkbox) => sum + Number(checkbox.closest('.q-item').querySelector('.mark-positive')?.value || 0), 0);
  document.getElementById('selCount').textContent = `${selected.length} selected · ${total.toFixed(2)} marks`;
  updateSelectAllVisibleLabel();
}

function applyBulkMarking() {
  const scope = document.getElementById('bulkScope').value;
  const type = document.getElementById('bulkType').value;
  const subject = document.getElementById('ctSubject').value;
  const rows = [...document.querySelectorAll('.q-item')].filter(row => {
    if (scope === 'selected') return row.querySelector('input[name="questionIds"]').checked;
    if (scope === 'section') return subject && row.dataset.subj === subject;
    if (scope === 'type') return row.dataset.type === type;
    return true;
  });
  if (!rows.length) return alert(scope === 'section' ? 'Choose a subject filter first.' : 'No questions match this scope.');
  const positive = Number(document.getElementById('bulkPositive').value);
  const negative = Number(document.getElementById('bulkNegative').value);
  const partial = Number(document.getElementById('bulkPartial').value);
  if (![positive, negative, partial].every(value => Number.isFinite(value) && value >= 0)) return alert('Enter valid non-negative marking values.');
  const preview = `${rows.length} question(s) will be overwritten: +${positive}, -${negative}, partial ${partial}.`;
  if (!confirm(`${preview}\n\nContinue?`)) return;
  rows.forEach(row => {
    row.querySelector('.mark-positive').value = positive;
    row.querySelector('.mark-negative').value = negative;
    row.querySelector('.mark-partial').value = partial;
  });
  updCount();
}

// ── Current filter state ──────────────────────────────────────────────────
const ctState = { course:'', subject:'', topic:'', subtopic:'', diff:'', search:'' };
const hierarchyKey = value => String(value || '').replace(/\s+/g, ' ').trim().toLocaleLowerCase();
const topicKey = value => hierarchyKey(value).replace(/^unit\s*\d+\s*[—-]\s*/, '');
const sameHierarchyValue = (left, right) => hierarchyKey(left) === hierarchyKey(right);
const sameTopicValue = (left, right) => topicKey(left) === topicKey(right);
let ctTopicRows = [];
const hierarchyWords = value => topicKey(value)
  .replace(/trigonometric/g, 'trig')
  .replace(/[^a-z0-9]+/g, ' ')
  .split(' ')
  .map(word => word.replace(/ies$/, 'y').replace(/s$/, ''))
  .filter(word => word.length > 2 && !['and', 'the', 'for', 'with', 'from', 'into', 'using', 'basic', 'general', 'standard'].includes(word));
function questionMatchesSelectedTopic(questionTopic, selectedTopicName) {
  if (!selectedTopicName || sameTopicValue(questionTopic, selectedTopicName)) return true;
  const selectedTopic = ctTopicRows.find(topic => sameTopicValue(topic.name, selectedTopicName));
  if (!selectedTopic) return false;
  const questionWords = [...new Set(hierarchyWords(questionTopic))];
  const syllabusWords = new Set(hierarchyWords([selectedTopic.name, ...(selectedTopic.subtopics || [])].join(' ')));
  const matchedWords = questionWords.filter(word => syllabusWords.has(word)).length;
  return matchedWords >= Math.min(2, questionWords.length);
}

// ── Apply all filters ─────────────────────────────────────────────────────
function applyCtFilters() {
  ctState.course   = document.getElementById('ctCourse').value;
  ctState.subject  = document.getElementById('ctSubject').value;
  ctState.topic    = document.getElementById('ctTopic').value;
  ctState.subtopic = document.getElementById('ctSubtopic').value;
  ctState.diff     = document.querySelector('.diff-chip.active')?.dataset.diff || '';
  ctState.search   = (document.getElementById('ctSearch').value || '').toLowerCase();

  const questionRows = [...document.querySelectorAll('.q-item')];
  const matchesWithoutSubtopic = row => {
    const matchSubj    = !ctState.subject  || sameHierarchyValue(row.dataset.subj, ctState.subject);
    const matchTopic   = questionMatchesSelectedTopic(row.dataset.topic, ctState.topic);
    const matchDiff    = !ctState.diff     || row.dataset.diff     === ctState.diff;
    const matchSearch  = !ctState.search   || row.dataset.text.includes(ctState.search);
    return matchSubj && matchTopic && matchDiff && matchSearch;
  };
  const hasSubtopicMatch = !ctState.subtopic || questionRows.some(row =>
    matchesWithoutSubtopic(row) && sameHierarchyValue(row.dataset.subtopic, ctState.subtopic)
  );

  questionRows.forEach(row => {
    const matchSub = !ctState.subtopic
      || !hasSubtopicMatch
      || sameHierarchyValue(row.dataset.subtopic, ctState.subtopic);
    row.style.display = (matchesWithoutSubtopic(row) && matchSub) ? '' : 'none';
  });

  // Show/hide group headers — only show if they have at least one visible q-item
  document.querySelectorAll('.q-group-header').forEach(header => {
    if (!header.dataset.topic) {
      // Subject header — show if any q-item below with same subject is visible
      const subj = header.dataset.subj;
      const hasVisible = [...document.querySelectorAll('.q-item')]
        .some(r => r.dataset.subj === subj && r.style.display !== 'none');
      header.style.display = hasVisible ? '' : 'none';
    } else {
      // Topic header
      const subj  = header.dataset.subj;
      const topic = header.dataset.topic;
      const hasVisible = [...document.querySelectorAll('.q-item')]
        .some(r => r.dataset.subj === subj && r.dataset.topic === topic && r.style.display !== 'none');
      header.style.display = hasVisible ? '' : 'none';
    }
  });

  updateBreadcrumb();
  updateSelectAllVisibleLabel();
}

// ── Course and subject hierarchy ─────────────────────────────────────────
async function onCtCourseChange(course) {
  const subjectSelect = document.getElementById('ctSubject');
  const topicSelect = document.getElementById('ctTopic');
  const subtopicSelect = document.getElementById('ctSubtopic');
  subjectSelect.innerHTML = '<option value="">Select Subject</option>';
  topicSelect.innerHTML = '<option value="">Select Unit</option>';
  subtopicSelect.innerHTML = '<option value="">Select Subtopic</option>';
  subjectSelect.disabled = !course;
  topicSelect.disabled = true;
  subtopicSelect.disabled = true;
  ctTopicRows = [];
  document.getElementById('ctAddStatus').textContent = '';
  if (course) {
    const subjects = await fetchSubjects(course);
    subjects.forEach(subject => subjectSelect.innerHTML += `<option value="${subject}">${subject}</option>`);
    document.getElementById('ctAddStatus').textContent = `${subjects.length} subject(s) available`;
  }
  applyCtFilters();
}

async function onCtSubjectChange(subject) {
  const tSel  = document.getElementById('ctTopic');
  const stSel = document.getElementById('ctSubtopic');
  tSel.innerHTML  = '<option value="">Select Unit</option>';
  stSel.innerHTML = '<option value="">Select Subtopic</option>';
  tSel.disabled = !subject;
  stSel.disabled = true;
  ctTopicRows = [];
  if (subject) {
    const topics = await fetchTopics(document.getElementById('ctCourse').value, subject);
    ctTopicRows = topics;
    topics.forEach(t => tSel.innerHTML += `<option value="${t.name}">${t.name}</option>`);
    document.getElementById('ctAddStatus').textContent = topics.length
      ? `${topics.length} unit(s) available`
      : 'No configured syllabus units';
  }
  applyCtFilters();
}

// ── Topic change ──────────────────────────────────────────────────────────
async function onCtTopicChange(topic) {
  const stSel = document.getElementById('ctSubtopic');
  const course = document.getElementById('ctCourse').value;
  const subj  = document.getElementById('ctSubject').value;
  stSel.innerHTML = '<option value="">Select Subtopic</option>';
  stSel.disabled = !topic;
  if (topic) {
    const subs = await fetchSubtopics(course, subj, topic);
    if (subs.length) {
      subs.forEach(s => stSel.innerHTML += `<option value="${s}">${s}</option>`);
      document.getElementById('ctAddStatus').textContent = `${subs.length} subtopic(s) available`;
    } else {
      stSel.innerHTML = '<option value="">No subtopics - use whole unit</option>';
      document.getElementById('ctAddStatus').textContent = 'This unit has no subtopics';
    }
  }
  applyCtFilters();
}

// ── Difficulty chip filter ────────────────────────────────────────────────
function filterDiff(diff) {
  document.querySelectorAll('.diff-chip').forEach(b => {
    b.classList.remove('active','bg-slate-900','text-white');
    if (!b.dataset.diff) b.dataset.diff = b.textContent.trim() === 'All' ? '' : b.textContent.trim();
  });
  event.target.classList.add('active','bg-slate-900','text-white');
  ctState.diff = diff;
  applyCtFilters();
}

// ── Reset all filters ─────────────────────────────────────────────────────
function resetCtFilters() {
  document.getElementById('ctCourse').value = '';
  document.getElementById('ctSubject').innerHTML = '<option value="">Select Course First</option>';
  document.getElementById('ctTopic').innerHTML   = '<option value="">Select Unit</option>';
  document.getElementById('ctSubtopic').innerHTML = '<option value="">Select Subtopic</option>';
  document.getElementById('ctSubject').disabled = true;
  document.getElementById('ctTopic').disabled = true;
  document.getElementById('ctSubtopic').disabled = true;
  document.getElementById('ctQuestionCount').value = '1';
  document.getElementById('ctAddStatus').textContent = '';
  document.getElementById('ctSearch').value   = '';
  document.querySelectorAll('.diff-chip').forEach(b => b.classList.remove('active','bg-slate-900','text-white'));
  document.querySelector('.diff-chip').classList.add('active','bg-slate-900','text-white');
  Object.keys(ctState).forEach(k => ctState[k] = '');
  document.querySelectorAll('.q-item,.q-group-header').forEach(r => r.style.display = '');
  updateBreadcrumb();
}

function addQuestionsByHierarchy() {
  applyCtFilters();
  const course = document.getElementById('ctCourse').value;
  const subject = document.getElementById('ctSubject').value;
  const topic = document.getElementById('ctTopic').value;
  const subtopicSelect = document.getElementById('ctSubtopic');
  const configuredSubtopics = Array.from(subtopicSelect.options).some(option => option.value);
  const subtopic = subtopicSelect.value;
  const requestedCount = Number.parseInt(document.getElementById('ctQuestionCount').value, 10);

  if (!course) {
    alert('Select a course first.');
    return;
  }
  if (!subject) {
    alert('Select a subject first.');
    return;
  }
  if (!topic) {
    alert('Select a syllabus unit.');
    return;
  }
  if (configuredSubtopics && !subtopic) {
    alert('Select a subtopic.');
    return;
  }
  if (!Number.isInteger(requestedCount) || requestedCount < 1) {
    alert('Enter a valid number of questions.');
    return;
  }

  const topicRows = Array.from(document.querySelectorAll('.q-item')).filter(row =>
    row.style.display !== 'none'
    && sameHierarchyValue(row.dataset.subj, subject)
    && questionMatchesSelectedTopic(row.dataset.topic, topic)
  );
  const exactSubtopicRows = subtopic
    ? topicRows.filter(row => sameHierarchyValue(row.dataset.subtopic, subtopic))
    : topicRows;
  const matchingRows = exactSubtopicRows.length ? exactSubtopicRows : topicRows;
  const availableRows = matchingRows.filter(row => !row.querySelector('input[name="questionIds"]').checked);
  const rowsToAdd = availableRows.slice(0, requestedCount);
  rowsToAdd.forEach(row => {
    row.querySelector('input[name="questionIds"]').checked = true;
  });

  const subjectTag = document.querySelector(`input[name="subjects"][value="${CSS.escape(subject)}"]`);
  if (subjectTag) subjectTag.checked = true;
  const courseTag = document.querySelector(`input[name="courses"][value="${CSS.escape(course)}"]`);
  if (courseTag) courseTag.checked = true;
  updCount();

  const status = document.getElementById('ctAddStatus');
  status.textContent = rowsToAdd.length
    ? `${rowsToAdd.length} question(s) added`
    : 'No unselected matching questions';
  status.className = rowsToAdd.length
    ? 'text-[11px] font-semibold text-emerald-600'
    : 'text-[11px] font-semibold text-rose-600';
  if (rowsToAdd.length < requestedCount) {
    alert(`Only ${rowsToAdd.length} unselected matching question(s) were available.`);
  }
}

// ── Breadcrumb display ────────────────────────────────────────────────────
function updateBreadcrumb() {
  const crumb = document.getElementById('ctBreadcrumb');
  const inner = document.getElementById('ctBreadcrumbInner');
  const parts = [];
  if (ctState.course)   parts.push(`<span class="bg-slate-900 text-white px-2 py-0.5 rounded-full text-xs font-semibold">${ctState.course}</span>`);
  if (ctState.subject)  parts.push(`<span class="bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full text-xs font-semibold">${ctState.subject}</span>`);
  if (ctState.topic)    parts.push(`<span class="text-slate-400 text-xs">›</span><span class="bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full text-xs font-semibold">${ctState.topic}</span>`);
  if (ctState.subtopic) parts.push(`<span class="text-slate-400 text-xs">›</span><span class="bg-orange-100 text-orange-600 px-2 py-0.5 rounded-full text-xs font-semibold">${ctState.subtopic}</span>`);
  inner.innerHTML = parts.join('');
  crumb.style.display = parts.length ? 'flex' : 'none';
}

// ── Select / Deselect helpers ─────────────────────────────────────────────
function selectAllVisible() {
  const visibleCheckboxes = [...document.querySelectorAll('.q-item')]
    .filter(row => row.style.display !== 'none')
    .map(row => row.querySelector('input[type="checkbox"]'));
  const shouldSelect = visibleCheckboxes.some(checkbox => !checkbox.checked);
  visibleCheckboxes.forEach(checkbox => { checkbox.checked = shouldSelect; });
  updCount();
}

function updateSelectAllVisibleLabel() {
  const button = document.querySelector('button[onclick="selectAllVisible()"]');
  if (!button) return;
  const visibleCheckboxes = [...document.querySelectorAll('.q-item')]
    .filter(row => row.style.display !== 'none')
    .map(row => row.querySelector('input[type="checkbox"]'));
  const allSelected = visibleCheckboxes.length > 0 && visibleCheckboxes.every(checkbox => checkbox.checked);
  button.textContent = allSelected ? '✕ Deselect all visible' : '✅ Select all visible';
}

function deselectAll() {
  document.querySelectorAll('input[name="questionIds"]').forEach(cb => cb.checked = false);
  updCount();
}

// ── AJAX topic/subtopic fetchers ──────────────────────────────────────────
async function fetchSubjects(course) {
  try {
    const r = await fetch(`/admin/ajax/subjects/${encodeURIComponent(course)}`);
    return await r.json();
  } catch { return []; }
}

async function fetchTopics(course, subject) {
  try {
    const r = await fetch(`/admin/ajax/topics?course=${encodeURIComponent(course)}&subject=${encodeURIComponent(subject)}`);
    return await r.json();
  } catch { return []; }
}

async function fetchSubtopics(course, subject, topic) {
  try {
    const r = await fetch(`/admin/ajax/subtopics?course=${encodeURIComponent(course)}&subject=${encodeURIComponent(subject)}&topic=${encodeURIComponent(topic)}`);
    return await r.json();
  } catch { return []; }
}

// ── Test detail page: load subjects on course select ──────────────────────
function loadSubjects(course) {
  if (!course) return;
  fetch(`/admin/ajax/subjects/${course}`).then(r => r.json()).then(subjects => {
    const sel = document.getElementById('subjectSelect');
    sel.innerHTML = '<option value="">Select Subject</option>' + subjects.map(s => `<option value="${s}">${s}</option>`).join('');
  }).catch(() => {});
}

// ── Sort questions in the list ────────────────────────────────────────────
function applyCtSort() {
  const sort = document.getElementById('ctSort').value;
  const list = document.getElementById('ctQuestionList');

  // Collect all q-items with their checked state
  const items = [...list.querySelectorAll('.q-item')].map(el => ({
    el,
    subj: el.dataset.subj || '',
    topic: el.dataset.topic || '',
    subtopic: el.dataset.subtopic || '',
    diff: el.dataset.diff || '',
    idx: parseInt(el.dataset.idx || '0'),
  }));

  const diffOrder = { Easy: 0, Medium: 1, Hard: 2 };

  items.sort((a, b) => {
    if (sort === 'difficulty') {
      const d = (diffOrder[a.diff] ?? 9) - (diffOrder[b.diff] ?? 9);
      if (d !== 0) return d;
      return a.subj.localeCompare(b.subj) || a.topic.localeCompare(b.topic);
    } else if (sort === 'newest') {
      return b.idx - a.idx; // higher idx = newer
    } else {
      // subject → topic → subtopic
      return a.subj.localeCompare(b.subj) || a.topic.localeCompare(b.topic) || a.subtopic.localeCompare(b.subtopic);
    }
  });

  // Remove all existing headers + items; re-append sorted items with fresh headers
  list.querySelectorAll('.q-item, .q-group-header').forEach(el => el.remove());

  let lastSubj = null, lastTopic = null;
  items.forEach(({ el, subj, topic, subtopic, diff }) => {
    if (sort === 'subject') {
      if (subj !== lastSubj) {
        lastSubj = subj; lastTopic = null;
        const sh = document.createElement('div');
        sh.className = 'q-group-header px-4 py-2 bg-blue-50 border-b border-blue-100 sticky top-0 z-[1]';
        sh.dataset.subj = subj; sh.dataset.topic = ''; sh.dataset.subtopic = '';
        sh.innerHTML = '<span class="text-xs font-bold text-blue-700 uppercase tracking-wider">📚 ' + (subj || 'No Subject') + '</span>';
        list.appendChild(sh);
      }
      if (topic && topic !== lastTopic) {
        lastTopic = topic;
        const th = document.createElement('div');
        th.className = 'q-group-header px-5 py-1.5 bg-purple-50 border-b border-purple-100';
        th.dataset.subj = subj; th.dataset.topic = topic; th.dataset.subtopic = '';
        th.innerHTML = '<span class="text-xs font-semibold text-purple-600">📌 ' + topic + '</span>' +
          (subtopic ? '<span class="text-purple-400 mx-1">›</span><span class="text-xs text-purple-500">' + subtopic + '</span>' : '');
        list.appendChild(th);
      }
    } else if (sort === 'difficulty') {
      if (diff !== lastSubj) { // reuse lastSubj for diff grouping
        lastSubj = diff;
        const dh = document.createElement('div');
        const colors = { Easy: 'bg-green-50 border-green-100 text-green-700', Medium: 'bg-yellow-50 border-yellow-100 text-yellow-700', Hard: 'bg-red-50 border-red-100 text-red-700' };
        const cls = colors[diff] || 'bg-slate-50 border-slate-100 text-slate-600';
        dh.className = 'q-group-header px-4 py-2 border-b sticky top-0 z-[1] ' + cls;
        dh.dataset.subj = ''; dh.dataset.topic = ''; dh.dataset.subtopic = '';
        dh.innerHTML = '<span class="text-xs font-bold uppercase tracking-wider">' + (diff || 'No Difficulty') + '</span>';
        list.appendChild(dh);
      }
    }
    list.appendChild(el);
  });

  // Re-apply current filters so visibility is correct
  applyCtFilters();
}

// Set data-diff on diff chips on load
document.querySelectorAll('.diff-chip').forEach(b => {
  const t = b.textContent.trim();
  b.dataset.diff = t === 'All' ? '' : t;
});
</script>

<script>
function toggleAutoSubmit(checked) {
  const limits = document.getElementById('violationLimits');
  if (checked) limits.classList.remove('hidden');
  else limits.classList.add('hidden');
}
</script>
<script>
function showEmbeddedFiles(input, targetId) {
  const target = document.getElementById(targetId);
  target.innerHTML = Array.from(input.files).map(file => {
    const size = file.size < 1024 * 1024
      ? `${(file.size / 1024).toFixed(1)} KB`
      : `${(file.size / 1024 / 1024).toFixed(1)} MB`;
    const item = document.createElement('div');
    item.textContent = `✓ ${file.name} · ${size}`;
    return `<p class="text-xs text-emerald-700 bg-emerald-50 border border-emerald-100 rounded-lg px-2.5 py-1.5">${item.innerHTML}</p>`;
  }).join('');
}

function sourceValue(name) {
  return document.querySelector(`form[action="/admin/tests"] [name="${name}"]`)?.value || '';
}

function prepareEmbeddedSmartScan() {
  const questionFiles = document.getElementById('embeddedQuestionFiles');
  const answerFiles = document.getElementById('embeddedAnswerFiles');
  const allFiles = [...questionFiles.files, ...answerFiles.files];
  if (!questionFiles.files.length) {
    alert('Choose at least one question paper, spreadsheet, or handwritten photo.');
    return false;
  }
  if (allFiles.length > 10) {
    alert('Upload a maximum of 10 files at once.');
    return false;
  }
  if (allFiles.reduce((sum, file) => sum + file.size, 0) > 40 * 1024 * 1024) {
    alert('Combined upload size must be below 40 MB.');
    return false;
  }

  document.getElementById('smartDefaultSubject').value =
    document.querySelector('form[action="/admin/tests"] input[name="subjects"]:checked')?.value || 'Physics';
  document.getElementById('smartTestTitle').value = sourceValue('title');
  document.getElementById('smartTestDescription').value = sourceValue('description');
  document.getElementById('smartTestDuration').value = sourceValue('duration');
  document.getElementById('smartTestNegativeMarking').value = sourceValue('negativeMarking');
  document.getElementById('smartTestStartTime').value = sourceValue('startTime');
  document.getElementById('smartTestEndTime').value = sourceValue('endTime');
  document.getElementById('smartTestInstructions').value = sourceValue('instructions');

  const carried = document.getElementById('smartCarriedSelections');
  carried.innerHTML = '';
  document.querySelectorAll('form[action="/admin/tests"] input[name="courses"]:checked').forEach(field => {
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'testCourses';
    input.value = field.value;
    carried.appendChild(input);
  });
  document.querySelectorAll('form[action="/admin/tests"] input[name="groupIds"]:checked').forEach(field => {
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'testGroupIds';
    input.value = field.value;
    carried.appendChild(input);
  });
  document.getElementById('embeddedScanOverlay').classList.remove('hidden');
  return true;
}
</script>
</body></html>

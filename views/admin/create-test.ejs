              <div id="embeddedQuestionList" class="mt-2 space-y-1"></div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">✅ Answer key / model answers <span class="font-normal text-slate-400">(optional)</span></label>
              <label class="block border-2 border-dashed border-emerald-300 rounded-xl p-7 text-center cursor-pointer hover:border-emerald-500 hover:bg-emerald-50 transition-all">
                <span class="block text-3xl mb-2">🔑</span>
                <span class="block text-sm font-semibold text-emerald-700">Choose answer-key files</span>
                <span class="block text-xs text-slate-400 mt-1">PDF, Word, CSV, Excel or marked photos</span>
                <input id="embeddedAnswerFiles" form="smartScanForm" type="file" name="questionFiles" multiple
                  accept=".pdf,.doc,.docx,.rtf,.odt,.txt,.md,.csv,.xls,.xlsx,.jpg,.jpeg,.png,.webp,.gif,.heic,.heif,.tif,.tiff,.bmp"
                  class="sr-only" onchange="showEmbeddedFiles(this,'embeddedAnswerList')"/>
              </label>
              <div id="embeddedAnswerList" class="mt-2 space-y-1"></div>
            </div>

        <!-- Smart question scan -->
        <div class="bg-white rounded-xl border-2 border-indigo-200 p-6 shadow-sm">
          <div class="flex items-center justify-between gap-3 mb-2 flex-wrap">
            <div class="flex items-center gap-2">

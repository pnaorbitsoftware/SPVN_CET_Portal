          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">📝 Question paper / handwritten pages *</label>
              <label class="block border-2 border-dashed border-indigo-300 rounded-xl p-7 text-center cursor-pointer hover:border-indigo-500 hover:bg-indigo-50 transition-all">
                <span class="block text-3xl mb-2">📄</span>
                <span class="block text-sm font-semibold text-indigo-700">Choose question files</span>
                <span class="block text-xs text-slate-400 mt-1">PDF, Word, CSV, Excel or multiple photos</span>
                <input id="embeddedQuestionFiles" form="smartScanForm" type="file" name="questionFiles" multiple required
                  accept=".pdf,.doc,.docx,.rtf,.odt,.txt,.md,.csv,.xls,.xlsx,.jpg,.jpeg,.png,.webp,.gif,.heic,.heif,.tif,.tiff,.bmp"
                  class="sr-only" onchange="showEmbeddedFiles(this,'embeddedQuestionList')"/>

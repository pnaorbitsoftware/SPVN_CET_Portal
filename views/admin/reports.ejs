<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto bg-slate-50">
    <header class="sticky top-0 z-20 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4 flex items-center justify-between gap-4">
      <div><h1 class="text-xl font-bold text-slate-900">Reports Center</h1><p class="text-xs text-slate-400 mt-0.5">Filtered operational and performance analytics from real submissions</p></div>
      <a href="/admin/reports/export?<%= exportQuery %>" class="bg-emerald-600 text-white rounded-xl px-4 py-2.5 text-sm font-semibold hover:bg-emerald-700">Export Excel</a>
    </header>
    <div class="p-5 lg:p-8 space-y-6">
      <%- include('../partials/flash') %>

      <form method="GET" action="/admin/reports" class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
        <input type="hidden" name="reportType" value="<%= filters.reportType %>"/>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
          <div><label class="block text-xs font-bold text-slate-600 mb-1">From</label><input type="date" name="startDate" value="<%= filters.startDate?filters.startDate.toISOString().slice(0,10):'' %>" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/></div>
          <div><label class="block text-xs font-bold text-slate-600 mb-1">To</label><input type="date" name="endDate" value="<%= filters.endDate?filters.endDate.toISOString().slice(0,10):'' %>" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/></div>
          <div><label class="block text-xs font-bold text-slate-600 mb-1">Batch</label><select name="groupId" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"><option value="">All batches</option><% options.groups.forEach(row=>{ %><option value="<%= row._id %>" <%= filters.groupId===String(row._id)?'selected':'' %>><%= row.name %></option><% }) %></select></div>
          <div><label class="block text-xs font-bold text-slate-600 mb-1">Student</label><select name="studentId" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"><option value="">All students</option><% options.students.forEach(row=>{ %><option value="<%= row._id %>" <%= filters.studentId===String(row._id)?'selected':'' %>><%= row.rollNo %> — <%= row.name %></option><% }) %></select></div>
          <div><label class="block text-xs font-bold text-slate-600 mb-1">Test</label><select name="testId" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"><option value="">All tests</option><% options.tests.forEach(row=>{ %><option value="<%= row._id %>" <%= filters.testId===String(row._id)?'selected':'' %>><%= row.title %></option><% }) %></select></div>
          <div><label class="block text-xs font-bold text-slate-600 mb-1">Course</label><select name="course" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"><option value="">All courses</option><% ['JEE','CET','NEET'].forEach(value=>{ %><option value="<%= value %>" <%= filters.course===value?'selected':'' %>><%= value %></option><% }) %></select></div>
          <div><label class="block text-xs font-bold text-slate-600 mb-1">Subject</label><select name="subject" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"><option value="">All subjects</option><% ['Physics','Chemistry','Mathematics','Biology','English','General Knowledge'].forEach(value=>{ %><option value="<%= value %>" <%= filters.subject===value?'selected':'' %>><%= value %></option><% }) %></select></div>
          <div class="flex items-end gap-2"><button class="flex-1 bg-slate-950 text-white rounded-xl px-4 py-2.5 text-sm font-semibold">Apply Filters</button><a href="/admin/reports?reportType=<%= filters.reportType %>" class="border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600">Reset</a></div>
        </div>
      </form>

      <nav class="flex gap-2 overflow-x-auto pb-1">
        <% [{id:'overview',label:'Overview'},{id:'student',label:'Student Reports'},{id:'batch',label:'Batch Reports'},{id:'test',label:'Test Reports'},{id:'subject',label:'Subject & Topic'},{id:'question',label:'Question Analytics'}].forEach(tab=>{ const tabParams=new URLSearchParams(exportQuery); tabParams.set('reportType',tab.id); %>
        <a href="/admin/reports?<%= tabParams.toString() %>" class="whitespace-nowrap rounded-xl px-4 py-2.5 text-sm font-semibold <%= filters.reportType===tab.id?'bg-navy-950 text-white':'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>"><%= tab.label %></a>
        <% }) %>
      </nav>

      <div class="grid grid-cols-2 lg:grid-cols-4 xl:grid-cols-7 gap-3">
        <% [{label:'Students',value:reports.summary.students},{label:'Active',value:reports.summary.activeStudents},{label:'Batches',value:reports.summary.batches},{label:'Tests',value:reports.summary.tests},{label:'Attempts',value:reports.summary.completedAttempts},{label:'Avg Score',value:reports.summary.averagePercentage+'%'},{label:'Accuracy',value:reports.summary.averageAccuracy+'%'}].forEach(card=>{ %>
        <div class="bg-white border border-slate-200 rounded-2xl p-4"><p class="text-xl font-bold text-slate-900"><%= card.value %></p><p class="text-[11px] font-semibold text-slate-400 mt-1"><%= card.label %></p></div>
        <% }) %>
      </div>

      <% if (filters.reportType === 'overview') { %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <section class="bg-white border border-slate-200 rounded-2xl overflow-hidden"><div class="px-5 py-4 border-b"><h2 class="font-bold text-slate-900">Top Performers</h2></div><div class="divide-y divide-slate-100"><% reports.studentReports.slice(0,8).forEach((row,index)=>{ %><div class="px-5 py-3 flex items-center gap-3"><span class="w-8 text-sm font-bold text-slate-400">#<%= index+1 %></span><div class="flex-1"><p class="text-sm font-semibold"><%= row.student?.name %></p><p class="text-xs text-slate-400"><%= row.student?.rollNo %> · <%= row.testsCompleted %> test(s)</p></div><strong class="text-emerald-600"><%= row.averagePercentage %>%</strong></div><% }) %><% if(!reports.studentReports.length){ %><p class="p-8 text-center text-sm text-slate-400">No matching submissions.</p><% } %></div></section>
        <section class="bg-white border border-slate-200 rounded-2xl overflow-hidden"><div class="px-5 py-4 border-b"><h2 class="font-bold text-slate-900">Subject Performance</h2></div><div class="divide-y divide-slate-100"><% reports.subjectReports.forEach(row=>{ %><div class="px-5 py-3"><div class="flex justify-between text-sm"><span class="font-semibold"><%= row.name %></span><strong><%= row.percentage %>%</strong></div><div class="h-2 bg-slate-100 rounded-full mt-2"><div class="h-2 bg-indigo-500 rounded-full" style="width:<%= Math.max(0,Math.min(100,row.percentage)) %>%"></div></div><p class="text-[11px] text-slate-400 mt-1">Accuracy <%= row.accuracy %>% · <%= row.resultCount %> result(s)</p></div><% }) %><% if(!reports.subjectReports.length){ %><p class="p-8 text-center text-sm text-slate-400">No subject data.</p><% } %></div></section>
      </div>
      <section class="bg-white border border-slate-200 rounded-2xl overflow-hidden"><div class="px-5 py-4 border-b"><h2 class="font-bold text-slate-900">Batch Participation</h2></div><div class="overflow-x-auto"><table class="w-full text-sm"><thead class="bg-slate-50 text-xs text-slate-500 uppercase"><tr><th class="px-5 py-3 text-left">Batch</th><th class="px-5 py-3 text-left">Students</th><th class="px-5 py-3 text-left">Tests</th><th class="px-5 py-3 text-left">Attempts</th><th class="px-5 py-3 text-left">Participation</th><th class="px-5 py-3 text-left">Average</th></tr></thead><tbody class="divide-y"><% reports.batchReports.forEach(row=>{ %><tr><td class="px-5 py-3 font-semibold"><a class="text-indigo-600 hover:underline" href="/admin/reports?reportType=batch&groupId=<%= row.groupId %>"><%= row.name %></a></td><td class="px-5 py-3"><%= row.totalStudents %></td><td class="px-5 py-3"><%= row.testsAssigned %></td><td class="px-5 py-3"><%= row.completedAttempts %></td><td class="px-5 py-3"><%= row.participationRate %>%</td><td class="px-5 py-3"><%= row.averagePercentage %>%</td></tr><% }) %></tbody></table></div></section>
      <% } %>

      <% if (filters.reportType === 'student') { %>
      <section class="space-y-4"><% pageData.rows.forEach(row=>{ %><article class="bg-white border border-slate-200 rounded-2xl p-5"><div class="flex flex-col md:flex-row md:items-center gap-4"><div class="flex-1"><h2 class="font-bold text-slate-900"><%= row.student?.name %></h2><p class="text-xs text-slate-400"><%= row.student?.rollNo %> · <%= row.testsCompleted %> completed</p></div><div class="grid grid-cols-2 sm:grid-cols-5 gap-3 text-center"><div><strong><%= row.averagePercentage %>%</strong><p class="text-[10px] text-slate-400">Average</p></div><div><strong><%= row.bestPercentage %>%</strong><p class="text-[10px] text-slate-400">Best</p></div><div><strong><%= row.averageAccuracy %>%</strong><p class="text-[10px] text-slate-400">Accuracy</p></div><div><strong><%= row.averageTimeMinutes %>m</strong><p class="text-[10px] text-slate-400">Avg time</p></div><div><strong class="<%= row.trend>=0?'text-emerald-600':'text-rose-600' %>"><%= row.trend>=0?'+':'' %><%= row.trend %></strong><p class="text-[10px] text-slate-400">Trend</p></div></div></div><details class="mt-4"><summary class="cursor-pointer text-sm font-semibold text-indigo-600">Test and rank history</summary><div class="overflow-x-auto mt-3"><table class="w-full text-xs"><thead class="bg-slate-50"><tr><th class="p-2 text-left">Test</th><th class="p-2">Score %</th><th class="p-2">Accuracy</th><th class="p-2">Rank</th><th class="p-2">Time</th><th class="p-2">Date</th></tr></thead><tbody><% row.history.forEach(item=>{ %><tr class="border-t"><td class="p-2"><%= item.testTitle %></td><td class="p-2 text-center"><%= item.percentage %>%</td><td class="p-2 text-center"><%= item.accuracy %>%</td><td class="p-2 text-center"><%= item.rank||'—' %></td><td class="p-2 text-center"><%= item.timeMinutes %>m</td><td class="p-2 text-center"><%= item.submittedAt?new Date(item.submittedAt).toLocaleDateString('en-IN'):'—' %></td></tr><% }) %></tbody></table></div></details></article><% }) %></section>
      <% } %>

      <% if (filters.reportType === 'batch') { %>
      <section class="space-y-5"><% pageData.rows.forEach(row=>{ %><article class="bg-white border border-slate-200 rounded-2xl overflow-hidden"><div class="p-5 bg-slate-950 text-white flex items-center justify-between"><div><h2 class="font-bold text-lg"><%= row.name %></h2><p class="text-xs text-white/60"><%= row.course||'All courses' %></p></div><strong class="text-2xl"><%= row.participationRate %>%</strong></div><div class="p-5 grid grid-cols-2 md:grid-cols-4 xl:grid-cols-8 gap-4 text-center"><% [['Students',row.totalStudents],['Active',row.activeStudents],['Tests',row.testsAssigned],['Attempts',row.completedAttempts],['Average',row.averagePercentage+'%'],['Accuracy',row.averageAccuracy+'%'],['Highest',row.highestPercentage+'%'],['Lowest',row.lowestPercentage+'%']].forEach(item=>{ %><div><strong><%= item[1] %></strong><p class="text-[10px] text-slate-400"><%= item[0] %></p></div><% }) %></div><div class="grid grid-cols-1 lg:grid-cols-3 gap-4 px-5 pb-5"><div class="rounded-xl bg-emerald-50 p-4"><h3 class="text-sm font-bold text-emerald-900">Top performers</h3><% row.topPerformers.forEach(item=>{ %><p class="text-xs mt-2"><%= item.student?.name %> — <strong><%= item.averagePercentage %>%</strong></p><% }) %><% if(!row.topPerformers.length){ %><p class="text-xs text-emerald-700 mt-2">No attempts.</p><% } %></div><div class="rounded-xl bg-rose-50 p-4"><h3 class="text-sm font-bold text-rose-900">Needs attention (&lt;40%)</h3><% row.lowPerformers.forEach(item=>{ %><p class="text-xs mt-2"><%= item.student?.name %> — <strong><%= item.averagePercentage %>%</strong></p><% }) %><% if(!row.lowPerformers.length){ %><p class="text-xs text-rose-700 mt-2">No students below threshold.</p><% } %></div><div class="rounded-xl bg-indigo-50 p-4"><h3 class="text-sm font-bold text-indigo-900">Test-wise performance</h3><% row.testWise.slice(0,6).forEach(item=>{ %><p class="text-xs mt-2 truncate"><%= item.title %> — <strong><%= item.attempts %> / <%= item.averagePercentage %>%</strong></p><% }) %></div></div></article><% }) %></section>
      <% } %>

      <% if (filters.reportType === 'test') { %>
      <section class="space-y-5"><% pageData.rows.forEach(row=>{ %><article class="bg-white border border-slate-200 rounded-2xl p-5"><div class="flex items-start justify-between gap-4"><div><h2 class="font-bold text-slate-900"><%= row.title %></h2><p class="text-xs text-slate-400 mt-1"><%= row.status %> · <%= row.scheduledStudents %> scheduled</p></div><strong class="text-indigo-600"><%= row.completionRate %>% complete</strong></div><div class="grid grid-cols-2 md:grid-cols-4 xl:grid-cols-8 gap-4 text-center mt-5"><% [['Attempts',row.attempts],['Avg score',row.averageScore],['Avg %',row.averagePercentage+'%'],['Accuracy',row.averageAccuracy+'%'],['Highest',row.highestScore],['Lowest',row.lowestScore],['Avg time',row.averageTimeMinutes+'m'],['Sec/question',row.averageTimePerQuestionSeconds]].forEach(item=>{ %><div class="bg-slate-50 rounded-xl p-3"><strong><%= item[1] %></strong><p class="text-[10px] text-slate-400"><%= item[0] %></p></div><% }) %></div><details class="mt-4"><summary class="cursor-pointer text-sm font-semibold text-rose-600">Most incorrect questions</summary><div class="mt-3 space-y-2"><% row.mostIncorrect.forEach(item=>{ %><div class="rounded-xl border p-3 text-xs"><strong><%= item.wrongPercentage %>% wrong</strong> · <%= item.question %><span class="text-slate-400"> · <%= item.averageResponseSeconds %> sec avg</span></div><% }) %></div></details></article><% }) %></section>
      <% } %>

      <% if (filters.reportType === 'subject') { %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6"><section class="bg-white border rounded-2xl overflow-hidden"><div class="p-5 border-b"><h2 class="font-bold">Subject Performance</h2></div><div class="divide-y"><% pageData.rows.forEach(row=>{ %><div class="p-5"><div class="flex justify-between"><strong><%= row.name %></strong><strong><%= row.percentage %>%</strong></div><p class="text-xs text-slate-400 mt-1"><%= row.marks %>/<%= row.total %> marks · Accuracy <%= row.accuracy %>% · <%= row.resultCount %> results</p></div><% }) %></div></section><section class="bg-white border rounded-2xl overflow-hidden"><div class="p-5 border-b"><h2 class="font-bold">Topic Strengths & Weaknesses</h2></div><div class="divide-y"><% reports.topicReports.forEach(row=>{ %><div class="p-4 flex items-center gap-3"><div class="flex-1"><strong class="text-sm"><%= row.name %></strong><p class="text-xs text-slate-400"><%= row.resultCount %> result(s) · Accuracy <%= row.accuracy %>%</p></div><span class="font-bold <%= row.percentage>=60?'text-emerald-600':row.percentage<40?'text-rose-600':'text-amber-600' %>"><%= row.percentage %>%</span></div><% }) %></div></section></div>
      <% } %>

      <% if (filters.reportType === 'question') { %>
      <section class="bg-white border border-slate-200 rounded-2xl overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-xs"><thead class="bg-slate-50 text-slate-500 uppercase"><tr><th class="p-3 text-left">Question</th><th class="p-3">Type</th><th class="p-3">Responses</th><th class="p-3">Correct</th><th class="p-3">Wrong</th><th class="p-3">Skipped</th><th class="p-3">Avg Time</th><th class="p-3">Discrimination</th></tr></thead><tbody class="divide-y"><% pageData.rows.forEach(row=>{ %><tr><td class="p-3 max-w-md"><p class="font-semibold line-clamp-2"><%= row.question %></p><p class="text-[10px] text-slate-400"><%= row.testTitle %> · <%= row.subject %> / <%= row.topic %></p></td><td class="p-3 text-center"><%= row.difficulty %></td><td class="p-3 text-center"><%= row.totalResponses %></td><td class="p-3 text-center text-emerald-600 font-bold"><%= row.correctPercentage %>%</td><td class="p-3 text-center text-rose-600 font-bold"><%= row.wrongPercentage %>%</td><td class="p-3 text-center"><%= row.skippedPercentage %>%</td><td class="p-3 text-center"><%= row.averageResponseSeconds %>s</td><td class="p-3 text-center"><p class="font-bold"><%= row.discrimination===null?'—':row.discrimination+' pts' %></p><p class="text-[10px] text-slate-400"><%= row.usefulness %></p></td></tr><% }) %></tbody></table></div></section>
      <% } %>

      <% if (filters.reportType !== 'overview' && !pageData.total) { %><div class="bg-white border border-slate-200 rounded-2xl py-16 text-center text-slate-400">No report data matches these filters.</div><% } %>
      <% if (filters.reportType !== 'overview' && pageData.totalPages > 1) { %><div class="flex justify-center items-center gap-3"><% for(let p=1;p<=pageData.totalPages;p++){ const pageParams=new URLSearchParams(exportQuery); pageParams.set('page',p); %><a href="/admin/reports?<%= pageParams.toString() %>" class="w-9 h-9 flex items-center justify-center rounded-lg text-sm font-bold <%= pageData.page===p?'bg-navy-950 text-white':'bg-white border text-slate-600' %>"><%= p %></a><% } %></div><% } %>
    </div>
  </main>
</div>
</body></html>

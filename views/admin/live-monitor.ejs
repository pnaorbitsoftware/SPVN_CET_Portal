<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto bg-slate-50">
    <header class="sticky top-0 z-20 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4 flex items-center justify-between gap-4">
      <div><h1 class="text-xl font-bold text-slate-900">Live Exam Monitor</h1><p class="text-xs text-slate-400 mt-0.5">Real attempt activity · refreshes every 10 seconds</p></div>
      <div class="flex items-center gap-2"><span id="refreshState" class="text-xs text-emerald-600 font-semibold">Live</span><button onclick="refreshMonitor()" class="border border-slate-200 rounded-xl px-4 py-2 text-sm font-semibold hover:bg-slate-50">Refresh now</button></div>
    </header>
    <div class="p-5 lg:p-8 space-y-6">
      <%- include('../partials/flash') %>
      <div id="testCards" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"></div>
      <section class="bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-5 py-4 border-b flex flex-col md:flex-row md:items-center gap-3 justify-between"><div><h2 id="selectedTestTitle" class="font-bold text-slate-900">Attempt activity</h2><p id="lastUpdated" class="text-xs text-slate-400 mt-0.5"></p></div><div class="flex items-center gap-2"><label class="text-xs font-bold text-slate-500">Test</label><select id="testSelector" onchange="selectTest(this.value)" class="border border-slate-200 rounded-xl px-3 py-2 text-sm"></select></div></div>
        <div id="monitorError" class="hidden px-5 py-3 bg-rose-50 text-rose-700 text-sm"></div>
        <div class="overflow-x-auto"><table class="w-full text-xs"><thead class="bg-slate-50 text-slate-500 uppercase"><tr><th class="p-3 text-left">Student</th><th class="p-3 text-left">Status</th><th class="p-3 text-left">Start / Activity</th><th class="p-3 text-left">Progress</th><th class="p-3 text-center">Tab</th><th class="p-3 text-center">Focus</th><th class="p-3 text-center">Fullscreen</th><th class="p-3 text-center">Violations</th><th class="p-3"></th></tr></thead><tbody id="studentRows" class="divide-y"></tbody></table></div>
        <div id="emptyMonitor" class="hidden py-14 text-center text-slate-400 text-sm">No students are scheduled for this test.</div>
      </section>
    </div>
  </main>
</div>
<div id="attemptModal" class="hidden fixed inset-0 z-50 bg-slate-950/60 p-4 items-center justify-center" onclick="if(event.target===this)closeAttempt()"><div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full p-6"><div class="flex justify-between gap-4"><div><h2 id="attemptName" class="font-bold text-lg"></h2><p id="attemptRoll" class="text-xs text-slate-400"></p></div><button onclick="closeAttempt()" class="text-slate-400 text-xl">×</button></div><div id="attemptBody" class="grid grid-cols-2 gap-3 mt-5"></div><div id="attemptWarning" class="mt-4 rounded-xl bg-rose-50 text-rose-700 p-4 text-sm"></div></div></div>
<script>
let monitor=<%- JSON.stringify(snapshot).replace(/</g,'\\u003c') %>;
let selectedTestId=monitor.selectedTestId;
const e=value=>String(value??'').replace(/[&<>'"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
const duration=seconds=>{seconds=Number(seconds)||0;const h=Math.floor(seconds/3600),m=Math.floor(seconds%3600/60),s=seconds%60;return h?`${h}h ${m}m`:`${m}m ${s}s`;};
function statusLabel(row){if(row.currentlyActive)return 'ACTIVE';return String(row.status||'not_started').replaceAll('_',' ').toUpperCase();}
function renderMonitor(){
  const cards=document.getElementById('testCards');
  cards.innerHTML=monitor.tests.map(test=>`<button onclick="selectTest('${e(test.testId)}')" class="text-left bg-white border ${test.testId===selectedTestId?'border-indigo-500 ring-2 ring-indigo-100':'border-slate-200'} rounded-2xl p-5 hover:border-indigo-300"><div class="flex justify-between gap-3"><div><h2 class="font-bold text-slate-900">${e(test.title)}</h2><p class="text-xs text-slate-400 mt-1">${e(test.batchNames.join(', ')||'No batch')}</p></div><span class="text-xs font-bold ${test.currentlyActive?'text-emerald-600':'text-slate-400'}">${test.currentlyActive} active</span></div><div class="grid grid-cols-4 gap-2 mt-4 text-center"><div><strong>${test.scheduled}</strong><p class="text-[9px] text-slate-400">Scheduled</p></div><div><strong>${test.started}</strong><p class="text-[9px] text-slate-400">Started</p></div><div><strong>${test.submitted}</strong><p class="text-[9px] text-slate-400">Submitted</p></div><div><strong class="text-rose-600">${test.violationCount}</strong><p class="text-[9px] text-slate-400">Violations</p></div></div><div class="h-2 bg-slate-100 rounded-full mt-4"><div class="h-2 bg-indigo-500 rounded-full" style="width:${Math.min(100,test.averageProgress)}%"></div></div><p class="text-[10px] text-slate-400 mt-1">${test.averageProgress}% average progress · ${test.autoSubmitted} auto-submitted · ${test.notStarted} not started</p></button>`).join('');
  const selector=document.getElementById('testSelector');selector.innerHTML=monitor.tests.map(test=>`<option value="${e(test.testId)}" ${test.testId===selectedTestId?'selected':''}>${e(test.title)}</option>`).join('');
  const current=monitor.tests.find(test=>test.testId===selectedTestId);document.getElementById('selectedTestTitle').textContent=current?current.title:'No active test';
  document.getElementById('lastUpdated').textContent=`Last refreshed ${new Date(monitor.generatedAt).toLocaleTimeString()} · active means activity within ${monitor.activeWithinSeconds} seconds`;
  const body=document.getElementById('studentRows');
  body.innerHTML=monitor.students.map(row=>`<tr class="${row.suspicious?'bg-rose-50/40':''}"><td class="p-3"><p class="font-semibold text-slate-900">${e(row.name)}</p><p class="text-[10px] text-slate-400">${e(row.rollNo)} · ${e(row.batchNames.join(', '))}</p></td><td class="p-3"><span class="rounded-full px-2 py-1 text-[10px] font-bold ${row.currentlyActive?'bg-emerald-100 text-emerald-700':row.status==='not_started'?'bg-slate-100 text-slate-500':row.status==='auto_submitted'?'bg-rose-100 text-rose-700':'bg-blue-100 text-blue-700'}">${e(statusLabel(row))}</span></td><td class="p-3"><p>${row.startedAt?new Date(row.startedAt).toLocaleTimeString():'—'}</p><p class="text-[10px] text-slate-400">${row.lastActivitySeconds===null?'No activity':`${duration(row.lastActivitySeconds)} ago`} · elapsed ${duration(row.elapsedSeconds)}</p></td><td class="p-3 min-w-40"><div class="flex justify-between"><span>${row.answered}/${row.totalQuestions}</span><strong>${row.progress}%</strong></div><div class="h-1.5 bg-slate-100 rounded-full mt-1"><div class="h-1.5 bg-indigo-500 rounded-full" style="width:${row.progress}%"></div></div><p class="text-[10px] text-slate-400">${row.remaining} remaining</p></td><td class="p-3 text-center">${row.tabSwitches}</td><td class="p-3 text-center">${row.focusLosses}</td><td class="p-3 text-center">${row.fullscreenExits}</td><td class="p-3 text-center font-bold ${row.totalViolations?'text-rose-600':''}">${row.totalViolations}</td><td class="p-3"><button onclick="showAttempt('${e(row.studentId)}')" class="text-indigo-600 font-semibold">Inspect</button></td></tr>`).join('');
  document.getElementById('emptyMonitor').classList.toggle('hidden',monitor.students.length>0);
}
async function refreshMonitor(){const state=document.getElementById('refreshState'),error=document.getElementById('monitorError');state.textContent='Refreshing…';state.className='text-xs text-amber-600 font-semibold';try{const response=await fetch(`/admin/live-monitor/data?testId=${encodeURIComponent(selectedTestId||'')}`,{headers:{Accept:'application/json'}});const data=await response.json();if(!response.ok)throw new Error(data.error||'Refresh failed');monitor=data;selectedTestId=data.selectedTestId;error.classList.add('hidden');renderMonitor();state.textContent='Live';state.className='text-xs text-emerald-600 font-semibold';}catch(err){error.textContent=err.message;error.classList.remove('hidden');state.textContent='Connection issue';state.className='text-xs text-rose-600 font-semibold';}}
function selectTest(id){selectedTestId=id;refreshMonitor();}
function showAttempt(studentId){const row=monitor.students.find(item=>item.studentId===studentId);if(!row)return;document.getElementById('attemptName').textContent=row.name;document.getElementById('attemptRoll').textContent=`${row.rollNo} · ${row.batchNames.join(', ')}`;document.getElementById('attemptBody').innerHTML=[['Status',statusLabel(row)],['Progress',`${row.answered}/${row.totalQuestions} (${row.progress}%)`],['Elapsed',duration(row.elapsedSeconds)],['Last activity',row.lastActivitySeconds===null?'Never':`${duration(row.lastActivitySeconds)} ago`],['Tab switches',row.tabSwitches],['Focus losses',row.focusLosses],['Fullscreen exits',row.fullscreenExits],['Total violations',row.totalViolations]].map(([label,value])=>`<div class="rounded-xl bg-slate-50 p-3"><p class="text-[10px] text-slate-400">${e(label)}</p><strong class="text-sm">${e(value)}</strong></div>`).join('');const warning=document.getElementById('attemptWarning');warning.textContent=row.suspicious?'This attempt has recorded anti-cheat violations. Review the counts and submitted result before taking any action.':'No anti-cheat violations are currently recorded for this attempt.';warning.className=`mt-4 rounded-xl p-4 text-sm ${row.suspicious?'bg-rose-50 text-rose-700':'bg-emerald-50 text-emerald-700'}`;const modal=document.getElementById('attemptModal');modal.classList.remove('hidden');modal.classList.add('flex');}
function closeAttempt(){const modal=document.getElementById('attemptModal');modal.classList.add('hidden');modal.classList.remove('flex');}
renderMonitor();setInterval(refreshMonitor,10000);
</script>
</body></html>

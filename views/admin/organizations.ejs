<%- include('../partials/head') %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 min-w-0">
    <header class="sticky top-0 z-10 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4 flex items-center gap-4">
      <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div class="flex-1">
        <h1 class="text-lg font-bold text-slate-900">Organization Settings</h1>
        <p class="text-xs text-slate-400">Identity, academic defaults, exam defaults and activation</p>
      </div>
      <% if (currentUser.isSuperAdmin) { %>
      <button type="button" onclick="document.getElementById('createOrganization').classList.remove('hidden')" class="bg-navy-950 text-white px-4 py-2.5 rounded-xl text-sm font-semibold hover:bg-navy-900">+ Organization</button>
      <% } %>
    </header>

    <div class="p-5 lg:p-8 space-y-6">
      <%- include('../partials/flash') %>
      <% organizations.forEach(org => {
        const settings = org.settings || {};
        const academic = settings.academicDefaults || {};
        const exam = settings.examDefaults || {};
        const result = settings.resultDefaults || {};
        const branding = settings.branding || {};
      %>
      <section class="bg-white rounded-2xl border border-slate-100 shadow-card overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center gap-3">
          <div class="flex items-center gap-3 flex-1 min-w-0">
            <% if (org.logo) { %>
            <img src="<%= org.logo %>" alt="" class="w-11 h-11 object-contain rounded-xl border border-slate-100 p-1"/>
            <% } else { %>
            <div class="w-11 h-11 rounded-xl bg-navy-950 text-white font-bold flex items-center justify-center"><%= org.organizationCode.charAt(0) %></div>
            <% } %>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h2 class="font-bold text-slate-900 truncate"><%= org.organizationName %></h2>
                <% if (org.isDefault) { %><span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700">DEFAULT</span><% } %>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full <%= org.status === 'active' ? 'bg-emerald-50 text-emerald-700' : org.status === 'inactive' ? 'bg-slate-100 text-slate-600' : 'bg-rose-50 text-rose-700' %>"><%= org.status.toUpperCase() %></span>
              </div>
              <p class="text-xs text-slate-400 mt-0.5"><%= org.organizationCode %><% if (org.email) { %> · <%= org.email %><% } %></p>
            </div>
          </div>
          <% if (currentUser.isSuperAdmin) { %>
          <form action="/admin/organizations/<%= org.id %>/status" method="POST" class="flex gap-2" onsubmit="return confirm('Change organization status? Student access is affected immediately.')">
            <select name="status" class="border border-slate-200 rounded-lg px-3 py-2 text-xs bg-white">
              <% statusValues.forEach(value => { %><option value="<%= value %>" <%= org.status === value ? 'selected' : '' %>><%= value.charAt(0).toUpperCase() + value.slice(1) %></option><% }) %>
            </select>
            <button class="border border-slate-200 text-slate-700 px-3 py-2 rounded-lg text-xs font-semibold hover:bg-slate-50">Apply</button>
          </form>
          <% } %>
        </div>

        <form action="/admin/organizations/<%= org.id %>" method="POST" class="p-6 space-y-7">
          <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Organization profile</h3>
            <div class="grid md:grid-cols-2 gap-4">
              <label class="text-xs font-semibold text-slate-600">Organization Name *
                <input name="organizationName" required value="<%= org.organizationName %>" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"/>
              </label>
              <label class="text-xs font-semibold text-slate-600">Organization Code
                <input value="<%= org.organizationCode %>" disabled class="mt-1.5 w-full border border-slate-200 bg-slate-50 rounded-xl px-4 py-2.5 text-sm text-slate-500"/>
              </label>
              <label class="text-xs font-semibold text-slate-600">Email
                <input type="email" name="email" value="<%= org.email || '' %>" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"/>
              </label>
              <label class="text-xs font-semibold text-slate-600">Phone
                <input name="phone" value="<%= org.phone || '' %>" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"/>
              </label>
              <label class="text-xs font-semibold text-slate-600 md:col-span-2">Logo URL / Path
                <input name="logo" value="<%= org.logo || '' %>" placeholder="/uploads/logo.png or https://…" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"/>
              </label>
              <label class="text-xs font-semibold text-slate-600 md:col-span-2">Address
                <textarea name="address" rows="2" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"><%= org.address || '' %></textarea>
              </label>
              <label class="text-xs font-semibold text-slate-600 md:col-span-2">Description
                <textarea name="description" rows="2" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"><%= org.description || '' %></textarea>
              </label>
              <% if (currentUser.isSuperAdmin) { %>
              <label class="text-xs font-semibold text-slate-600 md:col-span-2">Administrator
                <select name="administrator" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm bg-white">
                  <option value="">Not assigned</option>
                  <% administrators.forEach(admin => { %><option value="<%= admin.id %>" <%= String(org.administrator?._id || org.administrator || '') === String(admin.id) ? 'selected' : '' %>><%= admin.name %> (<%= admin.email %>)</option><% }) %>
                </select>
              </label>
              <% } %>
            </div>
          </div>

          <div class="grid lg:grid-cols-3 gap-5">
            <fieldset class="border border-slate-100 bg-slate-50/50 rounded-2xl p-4 space-y-3">
              <legend class="px-2 text-xs font-bold text-slate-500 uppercase tracking-wider">Academic</legend>
              <label class="block text-xs font-semibold text-slate-600">Academic Year
                <input name="academicYear" value="<%= academic.academicYear || academicYear %>" class="mt-1.5 w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm bg-white"/>
              </label>
              <div><p class="text-xs font-semibold text-slate-600 mb-2">Courses</p><div class="flex flex-wrap gap-2">
                <% courseValues.forEach(course => { %><label class="text-xs border border-slate-200 bg-white rounded-lg px-2.5 py-2"><input type="checkbox" name="defaultCourses" value="<%= course %>" <%= (academic.courses || []).includes(course) ? 'checked' : '' %>/> <%= course %></label><% }) %>
              </div></div>
              <label class="block text-xs font-semibold text-slate-600">Timezone
                <input name="timezone" value="<%= settings.timezone || 'Asia/Kolkata' %>" class="mt-1.5 w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm bg-white"/>
              </label>
            </fieldset>

            <fieldset class="border border-slate-100 bg-slate-50/50 rounded-2xl p-4 space-y-3">
              <legend class="px-2 text-xs font-bold text-slate-500 uppercase tracking-wider">Exam defaults</legend>
              <label class="block text-xs font-semibold text-slate-600">Duration (minutes)
                <input type="number" min="1" max="1440" name="defaultDuration" value="<%= exam.duration || 180 %>" class="mt-1.5 w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm bg-white"/>
              </label>
              <label class="block text-xs font-semibold text-slate-600">Timing Mode
                <select name="defaultTimingMode" class="mt-1.5 w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm bg-white">
                  <% ['PERSONAL_DURATION','FIXED_WINDOW','UNTIMED'].forEach(mode => { %><option value="<%= mode %>" <%= exam.timingMode === mode ? 'selected' : '' %>><%= mode.replaceAll('_',' ') %></option><% }) %>
                </select>
              </label>
              <label class="block text-xs font-semibold text-slate-600">Negative Marking
                <input type="number" min="0" step="0.01" name="defaultNegativeMarking" value="<%= exam.negativeMarking ?? 0.25 %>" class="mt-1.5 w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm bg-white"/>
              </label>
              <label class="block text-xs text-slate-600"><input type="checkbox" name="defaultShuffleQuestions" <%= exam.shuffleQuestions !== false ? 'checked' : '' %>/> Shuffle questions</label>
              <label class="block text-xs text-slate-600"><input type="checkbox" name="defaultShuffleOptions" <%= exam.shuffleOptions ? 'checked' : '' %>/> Shuffle options</label>
            </fieldset>

            <fieldset class="border border-slate-100 bg-slate-50/50 rounded-2xl p-4 space-y-3">
              <legend class="px-2 text-xs font-bold text-slate-500 uppercase tracking-wider">Result &amp; branding</legend>
              <label class="block text-xs font-semibold text-slate-600">Default Result Release
                <select name="defaultReleaseMode" class="mt-1.5 w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm bg-white">
                  <% ['IMMEDIATE','AFTER_TEST_END','SCHEDULED','MANUAL'].forEach(mode => { %><option value="<%= mode %>" <%= result.releaseMode === mode ? 'selected' : '' %>><%= mode.replaceAll('_',' ') %></option><% }) %>
                </select>
              </label>
              <input type="hidden" name="defaultRankingSchemaCode" value="<%= result.rankingSchemaCode || 'SCORE_TIME' %>"/>
              <label class="block text-xs font-semibold text-slate-600">Portal Name
                <input name="portalName" value="<%= branding.portalName || org.organizationName %>" class="mt-1.5 w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm bg-white"/>
              </label>
              <label class="block text-xs font-semibold text-slate-600">Short Name
                <input name="shortName" value="<%= branding.shortName || org.organizationCode %>" class="mt-1.5 w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm bg-white"/>
              </label>
              <div class="grid grid-cols-2 gap-3">
                <label class="text-xs font-semibold text-slate-600">Primary<input type="color" name="primaryColor" value="<%= branding.primaryColor || '#131330' %>" class="mt-1.5 block w-full h-10 border border-slate-200 rounded-lg bg-white"/></label>
                <label class="text-xs font-semibold text-slate-600">Accent<input type="color" name="accentColor" value="<%= branding.accentColor || '#f59e0b' %>" class="mt-1.5 block w-full h-10 border border-slate-200 rounded-lg bg-white"/></label>
              </div>
            </fieldset>
          </div>
          <div class="flex justify-end"><button class="bg-navy-950 text-white px-6 py-3 rounded-xl text-sm font-semibold hover:bg-navy-900">Save Organization Settings</button></div>
        </form>
      </section>
      <% }) %>
    </div>
  </main>
</div>

<% if (currentUser.isSuperAdmin) { %>
<div id="createOrganization" class="hidden fixed inset-0 z-50 bg-black/50 p-4 overflow-y-auto">
  <div class="bg-white max-w-xl mx-auto my-8 rounded-2xl shadow-2xl overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between"><div><h2 class="font-bold text-slate-900">Create Organization</h2><p class="text-xs text-slate-400">New organizations start active.</p></div><button type="button" onclick="document.getElementById('createOrganization').classList.add('hidden')" class="text-slate-400 text-2xl">&times;</button></div>
    <form action="/admin/organizations" method="POST" class="p-6 grid md:grid-cols-2 gap-4">
      <label class="text-xs font-semibold text-slate-600">Name *<input required name="organizationName" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"/></label>
      <label class="text-xs font-semibold text-slate-600">Code *<input required name="organizationCode" pattern="[A-Za-z0-9_-]{2,32}" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm uppercase"/></label>
      <label class="text-xs font-semibold text-slate-600">Email<input type="email" name="email" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"/></label>
      <label class="text-xs font-semibold text-slate-600">Phone<input name="phone" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"/></label>
      <label class="text-xs font-semibold text-slate-600">Academic Year<input name="academicYear" value="<%= academicYear %>" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"/></label>
      <label class="text-xs font-semibold text-slate-600">Timezone<input name="timezone" value="Asia/Kolkata" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"/></label>
      <label class="text-xs font-semibold text-slate-600 md:col-span-2">Administrator<select name="administrator" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm bg-white"><option value="">Assign later</option><% administrators.forEach(admin => { %><option value="<%= admin.id %>"><%= admin.name %> (<%= admin.email %>)</option><% }) %></select></label>
      <label class="text-xs font-semibold text-slate-600 md:col-span-2">Address<textarea name="address" rows="2" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"></textarea></label>
      <label class="text-xs font-semibold text-slate-600 md:col-span-2">Description<textarea name="description" rows="2" class="mt-1.5 w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"></textarea></label>
      <div class="md:col-span-2 flex gap-3"><button class="flex-1 bg-navy-950 text-white py-3 rounded-xl font-semibold text-sm">Create Organization</button><button type="button" onclick="document.getElementById('createOrganization').classList.add('hidden')" class="flex-1 border border-slate-200 py-3 rounded-xl font-semibold text-sm">Cancel</button></div>
    </form>
  </div>
</div>
<% } %>
</body>
</html>

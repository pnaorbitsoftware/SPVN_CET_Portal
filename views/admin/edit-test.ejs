<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto">
    <header class="sticky top-0 z-10 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4">
      <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800 mr-3 shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div class="flex items-center gap-3">
        <a href="/admin/tests" class="text-slate-400 hover:text-slate-600">←</a>
        <h1 class="text-lg font-bold text-slate-900">Edit Test</h1>
      </div>
    </header>
    <div class="p-5 lg:p-8 max-w-4xl mx-auto">
      <%- include('../partials/flash') %>
      <form action="/admin/tests/<%= test.id %>/edit" method="POST" enctype="multipart/form-data" class="space-y-6">

        <!-- Basic Info -->
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <h3 class="font-bold text-slate-900 mb-4">📝 Test Details</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2"><label class="block text-sm font-semibold mb-1.5">Title *</label>
              <input type="text" name="title" required value="<%= test.title %>" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-navy-500" placeholder="e.g. CET Mock Test 1 — Physics"/></div>
            <div class="md:col-span-2"><label class="block text-sm font-semibold mb-1.5">Description</label>
              <textarea name="description" rows="2" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-navy-500"><%= test.description || '' %></textarea></div>
            <div><label class="block text-sm font-semibold mb-1.5">Test Type *</label><select name="testType" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"><% TEST_TYPES.forEach(type=>{ %><option value="<%= type %>" <%= (test.testType||'CUSTOM')===type?'selected':'' %>><%= type.replaceAll('_',' ') %></option><% }) %></select></div>
            <div><label class="block text-sm font-semibold mb-1.5">Test Pattern *</label><select id="testPatternSelect" name="testPattern" required onchange="applyPatternDefaults(this.value)" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"><% const currentPatternId=String(test.testPattern?._id||test.testPattern||''); patterns.forEach(pattern=>{ %><option value="<%= pattern.id %>" <%= currentPatternId===String(pattern.id)||(!currentPatternId&&pattern.code==='CUSTOM')?'selected':'' %>><%= pattern.name %> (<%= pattern.code %>)</option><% }) %></select></div>
            <div><label class="block text-sm font-semibold mb-1.5">Ranking Schema *</label><select id="rankingSchemaSelect" name="rankingSchema" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"><% const currentRankingId=String(test.rankingSchema?._id||test.rankingSchema||''); rankingSchemas.forEach(schema=>{ %><option value="<%= schema.id %>" <%= currentRankingId===String(schema.id)||(!currentRankingId&&schema.code==='SCHEME_1')?'selected':'' %>><%= schema.name %></option><% }) %></select></div>
            <div class="rounded-xl bg-indigo-50 p-3 text-xs text-indigo-700"><strong>Snapshot-safe:</strong> this test stores the selected pattern and ranking configuration.</div>
            <div class="md:col-span-2">
              <label class="block text-sm font-semibold mb-2">Course</label>
              <div class="flex flex-wrap gap-2">
                <% COURSES.forEach(c => { %>
                <label class="flex items-center gap-2 border border-slate-200 rounded-lg px-3 py-2 cursor-pointer hover:bg-slate-50 transition-colors">
                  <input type="checkbox" name="courses" value="<%= c %>" class="rounded" <%= (test.course||[]).includes(c)?'checked':'' %>/>
                  <span class="text-sm font-medium text-slate-700"><%= c %></span>
                </label>
                <% }) %>
              </div>
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-semibold mb-2">Subject</label>
              <div class="flex flex-wrap gap-2">
                <% SUBJECTS.forEach(s => { %>
                <label class="flex items-center gap-2 border border-slate-200 rounded-lg px-3 py-2 cursor-pointer hover:bg-slate-50 transition-colors">
                  <input type="checkbox" name="subjects" value="<%= s %>" class="rounded" <%= (test.subject||[]).includes(s)?'checked':'' %>/>
                  <span class="text-sm font-medium text-slate-700"><%= s %></span>
                </label>
                <% }) %>
              </div>
            </div>
            <div><label class="block text-sm font-semibold mb-1.5">Timing Mode *</label><select id="timingMode" name="timingMode" onchange="updateTimingFields()" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"><% TIMING_MODES.forEach(mode=>{ %><option value="<%= mode %>" <%= (test.timingMode||'PERSONAL_DURATION')===mode?'selected':'' %>><%= mode.replaceAll('_',' ') %></option><% }) %></select></div>
            <div id="durationField"><label class="block text-sm font-semibold mb-1.5">Personal Duration (minutes) *</label>
              <input id="durationInput" type="number" name="duration" value="<%= test.duration||180 %>" min="1" max="1440" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-navy-500"/></div>
            <div><label class="block text-sm font-semibold mb-1.5">Negative Marking</label>
              <input type="number" name="negativeMarking" value="<%= test.negativeMarking %>" step="0.25" min="0" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-navy-500"/></div>
            <div><label class="block text-sm font-semibold mb-1.5">Start Time</label>
              <input id="startTimeInput" type="datetime-local" name="startTime" value="<%= formatDateTimeLocal(test.startTime) %>" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"/></div>
            <div><label class="block text-sm font-semibold mb-1.5">End Time</label>
              <input id="endTimeInput" type="datetime-local" name="endTime" value="<%= formatDateTimeLocal(test.endTime) %>" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"/><p id="timingHint" class="mt-1 text-[10px] text-slate-400"></p></div>
            <div class="md:col-span-2"><label class="block text-sm font-semibold mb-1.5">Instructions</label>
              <textarea name="instructions" rows="2" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm" placeholder="Instructions for students..."><%= test.instructions||'' %></textarea></div>
          </div>
          <div class="flex flex-wrap gap-5 mt-4">
            <label class="flex items-center gap-2 cursor-pointer text-sm"><input type="checkbox" name="shuffleQuestions" value="on" <%= test.shuffleQuestions?'checked':'' %> class="rounded"/> Shuffle Questions</label>
            <label class="flex items-center gap-2 cursor-pointer text-sm"><input type="checkbox" name="shuffleOptions" value="on" <%= test.shuffleOptions?'checked':'' %> class="rounded"/> Shuffle Options</label>
          </div>
        </div>

        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <h3 class="font-bold text-slate-900 mb-1">🔑 Test Access</h3>
          <p class="text-xs text-slate-500 mb-4">The saved secret is never displayed. Leave the password blank to keep the current one.</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-end">
            <label class="flex items-center gap-3 rounded-xl border border-slate-200 p-4 text-sm font-semibold text-slate-700"><input id="testAccessEnabled" type="checkbox" name="testAccessEnabled" value="on" onchange="updateAccessField()" class="rounded" <%= test.testAccessEnabled?'checked':'' %>/> Enable Test Password / PIN</label>
            <div id="testAccessField"><label class="block text-sm font-semibold mb-1.5">New Password / PIN</label><input id="testAccessPassword" type="password" name="testAccessPassword" minlength="4" maxlength="64" autocomplete="new-password" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm" placeholder="<%= testAccessConfigured?'Leave blank to keep saved secret':'Enter 4–64 characters' %>"/></div>
          </div>
        </div>

        <!-- Anti-Cheat & Proctoring Settings -->
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <h3 class="font-bold text-slate-900 mb-1 flex items-center gap-2">🔒 Anti-Cheat & Proctoring</h3>
          <p class="text-xs text-slate-500 mb-4">Control exam security behaviour. Violations are always logged regardless of these settings.</p>
          <div class="grid grid-cols-1 gap-5">
            <!-- Auto-submit on violation -->
            <div class="border border-slate-200 rounded-xl p-4">
              <div class="flex items-center justify-between mb-3">
                <div>
                  <p class="text-sm font-semibold text-slate-800">Auto-Submit on Violation</p>
                  <p class="text-xs text-slate-500 mt-0.5">Exam is force-submitted when limits are exceeded</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" name="autoSubmitOnViolation" value="on" id="autoSubmitToggle" onchange="toggleAutoSubmit(this.checked)" class="sr-only peer">
                  <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-red-600"></div>
                </label>
              </div>
              <div id="violationLimits" class="space-y-3 hidden">
                <div>
                  <label class="text-xs font-semibold text-slate-600 block mb-1">Max Tab Switches allowed <span class="text-red-500">*</span></label>
                  <div class="flex items-center gap-2">
                    <input type="range" name="maxTabSwitches" id="tabRange" min="1" max="10" value="3" oninput="document.getElementById('tabVal').textContent=this.value" class="flex-1 accent-red-600"/>
                    <span id="tabVal" class="text-sm font-bold text-red-600 w-6 text-center">3</span>
                  </div>
                  <p class="text-xs text-slate-400 mt-0.5">Exam auto-submits after this many tab switches</p>
                </div>
                <div>
                  <label class="text-xs font-semibold text-slate-600 block mb-1">Max Focus Losses allowed</label>
                  <div class="flex items-center gap-2">
                    <input type="range" name="maxFocusLosses" id="focusRange" min="1" max="15" value="5" oninput="document.getElementById('focusVal').textContent=this.value" class="flex-1 accent-orange-500"/>
                    <span id="focusVal" class="text-sm font-bold text-orange-600 w-6 text-center">5</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Block copy/paste & fullscreen -->
            <div class="border border-slate-200 rounded-xl p-4 space-y-3">
              <p class="text-sm font-semibold text-slate-800 mb-2">Exam Restrictions</p>
              <label class="flex items-center justify-between cursor-pointer">
                <div>
                  <p class="text-sm text-slate-700">Block Copy / Paste</p>
                  <p class="text-xs text-slate-400">Prevents Ctrl+C, Ctrl+V, right-click</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" name="blockCopyPaste" value="on" checked class="sr-only peer">
                  <div class="w-11 h-6 bg-slate-200 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-slate-800"></div>
                </label>
              </label>
              <label class="flex items-center justify-between cursor-pointer">
                <div>
                  <p class="text-sm text-slate-700">Require Fullscreen</p>
                  <p class="text-xs text-slate-400">Force fullscreen; exit counts as violation</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" name="requireFullscreen" value="on" class="sr-only peer">
                  <div class="w-11 h-6 bg-slate-200 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-slate-800"></div>
                </label>
              </label>
            </div>
          </div>
          <div class="mt-4 bg-amber-50 border border-amber-200 rounded-xl p-3 text-xs text-amber-700 flex items-start gap-2">
            <span class="text-base">⚠</span>
            <span>All violations (tab switches, focus losses, fullscreen exits) are always <strong>logged and visible</strong> to admin in the result page regardless of these settings.</span>
          </div>
        </div>

        <!-- Assign Groups -->
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <h3 class="font-bold text-slate-900 mb-4">👥 Assign to Groups</h3>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
            <% if (!groups.length) { %><p class="text-sm text-slate-400 col-span-3">No groups yet. Create groups first.</p><% } %>
            <% groups.forEach(g => { %>
            <label class="flex items-center gap-2 p-3 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 transition-colors">
              <input type="checkbox" name="groupIds" value="<%= g.id %>" class="rounded" <%= (test.groups||[]).map(x=>x.id||x.toString()).includes(g.id)?'checked':'' %>/>
              <span class="text-sm font-medium text-slate-700"><%= g.name %></span>
            </label>
            <% }) %>
          </div>
        </div>

        <!-- Select Questions -->
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-bold text-slate-900">❓ Select Questions</h3>
            <span id="selCount" class="text-sm font-semibold text-green-700 bg-green-50 px-3 py-1 rounded-full">0 selected</span>
          </div>

          <!-- Course → Subject → Unit → Subtopic cascade -->
          <div class="bg-slate-50 rounded-xl p-3 border border-slate-200 mb-3">
            <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2.5">Filter by syllabus hierarchy</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
              <!-- Course -->
              <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1">Course</label>
                <select id="ctCourse" onchange="onCtCourseChange(this.value)"
                  class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-slate-900 transition-all">
                  <option value="">All Courses</option>
                  <% COURSES.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %>
                </select>
              </div>
              <!-- Subject -->
              <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1">Subject</label>
                <select id="ctSubject" onchange="onCtSubjectChange(this.value)" disabled
                  class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-slate-900 transition-all">
                  <option value="">Select course first</option>
                </select>
              </div>
              <!-- Unit (AJAX) -->
              <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1">Unit</label>
                <select id="ctTopic" onchange="onCtTopicChange(this.value)" disabled
                  class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-slate-900 transition-all">
                  <option value="">All Units</option>
                </select>
              </div>
              <!-- Subtopic (AJAX) -->
              <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1">Subtopic</label>
                <select id="ctSubtopic" onchange="applyCtFilters()" disabled
                  class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-slate-900 transition-all">
                  <option value="">All Subtopics</option>
                </select>
              </div>
            </div>

            <!-- Active breadcrumb + reset -->
            <div class="flex items-center justify-between mt-2.5" id="ctBreadcrumb" style="display:none">
              <div class="flex items-center gap-1.5 flex-wrap" id="ctBreadcrumbInner"></div>
              <button type="button" onclick="resetCtFilters()" class="text-xs text-slate-400 hover:text-slate-700 font-medium shrink-0 transition-colors">Clear filters</button>
            </div>
          </div>

          <!-- Difficulty quick filter chips + Sort -->
          <div class="flex flex-wrap gap-1.5 mb-3 items-center">
            <button type="button" onclick="filterDiff('')"  class="diff-chip active text-xs px-3 py-1 rounded-full font-semibold bg-slate-900 text-white transition-all">All</button>
            <button type="button" onclick="filterDiff('Easy')"   class="diff-chip text-xs px-3 py-1 rounded-full font-semibold bg-green-100 text-green-700 hover:bg-green-200 transition-all">Easy</button>
            <button type="button" onclick="filterDiff('Medium')" class="diff-chip text-xs px-3 py-1 rounded-full font-semibold bg-yellow-100 text-yellow-700 hover:bg-yellow-200 transition-all">Medium</button>
            <button type="button" onclick="filterDiff('Hard')"   class="diff-chip text-xs px-3 py-1 rounded-full font-semibold bg-red-100 text-red-700 hover:bg-red-200 transition-all">Hard</button>
            <div class="ml-auto flex items-center gap-2">
              <select id="ctSort" onchange="applyCtSort()" class="border border-slate-200 rounded-lg px-2 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-slate-900 transition-all">
                <option value="subject">Sort: Subject → Topic</option>
                <option value="difficulty">Sort: Difficulty</option>
                <option value="newest">Sort: Newest</option>
              </select>
              <input type="text" placeholder="Search questions..." id="ctSearch" onkeyup="applyCtFilters()"
                class="border border-slate-200 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-slate-900 w-40 transition-all"/>
            </div>
          </div>

          <!-- Questions list -->
          <div class="mb-3 rounded-xl border border-indigo-200 bg-indigo-50 p-3">
            <div class="flex flex-wrap items-end gap-2">
              <label class="text-[11px] font-semibold text-indigo-900">Apply to<select id="bulkScope" class="mt-1 block rounded-lg border border-indigo-200 bg-white px-2 py-1.5 text-xs"><option value="selected">Selected questions</option><option value="all">All questions</option><option value="section">Current subject filter</option><option value="type">Question type</option></select></label>
              <label class="text-[11px] font-semibold text-indigo-900">Type<select id="bulkType" class="mt-1 block rounded-lg border border-indigo-200 bg-white px-2 py-1.5 text-xs"><option value="SINGLE_CORRECT">Single</option><option value="MULTIPLE_CORRECT">Multiple</option><option value="NUMERICAL">Numerical</option><option value="TRUE_FALSE">True/False</option></select></label>
              <label class="text-[11px] font-semibold text-indigo-900">Positive<input id="bulkPositive" type="number" min="0" step="0.25" value="1" class="mt-1 block w-20 rounded-lg border border-indigo-200 px-2 py-1.5 text-xs"/></label>
              <label class="text-[11px] font-semibold text-indigo-900">Negative<input id="bulkNegative" type="number" min="0" step="0.25" value="<%= test.negativeMarking %>" class="mt-1 block w-20 rounded-lg border border-indigo-200 px-2 py-1.5 text-xs"/></label>
              <label class="text-[11px] font-semibold text-indigo-900">Partial<input id="bulkPartial" type="number" min="0" step="0.25" value="0" class="mt-1 block w-20 rounded-lg border border-indigo-200 px-2 py-1.5 text-xs"/></label>
              <button type="button" onclick="applyBulkMarking()" class="rounded-lg bg-indigo-700 px-3 py-2 text-xs font-bold text-white">Preview &amp; apply</button>
            </div>
            <p class="mt-2 text-[11px] text-indigo-700">Bulk changes show the affected count and require confirmation before overwriting per-question values.</p>
          </div>
          <div class="border border-slate-200 rounded-xl overflow-hidden max-h-96 overflow-y-auto" id="ctQuestionList">
            <% if (!questions.length) { %>
            <p class="p-6 text-sm text-slate-400 text-center">No questions in bank. <a href="/admin/questions" class="text-navy-600 hover:underline">Add questions first →</a></p>
            <% } %>
            <% let lastSubj='', lastTopic=''; %>
            <% questions.forEach((q,i) => { %>
            <% if (q.subject !== lastSubj) { lastSubj=q.subject; lastTopic=''; %>
            <div class="q-group-header px-4 py-2 bg-blue-50 border-b border-blue-100 sticky top-0 z-[1]"
                 data-subj="<%= q.subject %>" data-topic="" data-subtopic="">
              <span class="text-xs font-bold text-blue-700 uppercase tracking-wider">📚 <%= q.subject %></span>
            </div>
            <% } %>
            <% if (q.topic && q.topic !== lastTopic) { lastTopic=q.topic; %>
            <div class="q-group-header px-5 py-1.5 bg-purple-50 border-b border-purple-100"
                 data-subj="<%= q.subject %>" data-topic="<%= q.topic %>" data-subtopic="">
              <span class="text-xs font-semibold text-purple-600">📌 <%= q.topic %></span>
              <% if (q.subtopic) { %><span class="text-purple-400 mx-1">›</span><span class="text-xs text-purple-500"><%= q.subtopic %></span><% } %>
            </div>
            <% } %>
            <% const cfg = questionConfigMap.get(String(q.id)) || {}; %>
            <label class="q-item flex items-start gap-3 p-4 border-b border-slate-100 cursor-pointer hover:bg-slate-50 transition-colors"
              data-subj="<%= q.subject %>"
              data-topic="<%= q.topic || '' %>"
              data-subtopic="<%= q.subtopic || '' %>"
              data-diff="<%= q.difficulty %>"
              data-type="<%= q.questionType || 'SINGLE_CORRECT' %>"
              data-text="<%= q.question.toLowerCase() %>" data-idx="<%= i %>">
              <input type="checkbox" name="questionIds" value="<%= q.id %>" onchange="updCount()" class="mt-0.5 rounded shrink-0" <%= (test.questions||[]).map(x=>x.id||x.toString()).includes(q.id)?'checked':'' %>/>
              <div class="flex-1 min-w-0">
                <p class="math-content math-clamp-2 text-sm text-slate-800 leading-snug"><%= q.question %></p>
                <div class="flex flex-wrap gap-1.5 mt-1.5 items-center">
                  <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded font-medium"><%= q.subject %></span>
                  <% if (q.topic) { %><span class="text-slate-300 text-xs">›</span><span class="text-xs bg-purple-100 text-purple-700 px-2 py-0.5 rounded"><%= q.topic %></span><% } %>
                  <% if (q.subtopic) { %><span class="text-slate-300 text-xs">›</span><span class="text-xs bg-orange-100 text-orange-600 px-2 py-0.5 rounded"><%= q.subtopic %></span><% } %>
                  <span class="text-xs <%= q.difficulty==='Easy'?'bg-green-100 text-green-700':q.difficulty==='Hard'?'bg-red-100 text-red-700':'bg-yellow-100 text-yellow-700' %> px-2 py-0.5 rounded"><%= q.difficulty %></span>
                  <span class="text-xs text-slate-400 ml-auto"><%= q.marks %> mk</span>
                </div>
                <details class="mt-2 rounded-lg border border-slate-200 bg-white p-2" onclick="event.stopPropagation()">
                  <summary class="cursor-pointer text-[11px] font-bold text-indigo-700">Per-question marking<% if(cfg.bonus){ %> · Bonus<% } %></summary>
                  <div class="marking-grid mt-2 grid grid-cols-2 gap-2 md:grid-cols-4" data-question-id="<%= q.id %>">
                    <label class="text-[10px] font-semibold text-slate-500">Positive<input name="questionConfigs[<%= q.id %>][positiveMarks]" value="<%= cfg.positiveMarks ?? q.marks %>" type="number" min="0" step="0.25" class="mark-positive mt-1 w-full rounded border border-slate-200 px-2 py-1 text-xs"/></label>
                    <label class="text-[10px] font-semibold text-slate-500">Negative<input name="questionConfigs[<%= q.id %>][negativeMarks]" value="<%= cfg.negativeMarks ?? test.negativeMarking %>" type="number" min="0" step="0.25" class="mark-negative mt-1 w-full rounded border border-slate-200 px-2 py-1 text-xs"/></label>
                    <label class="text-[10px] font-semibold text-slate-500">Partial<input name="questionConfigs[<%= q.id %>][partialMarks]" value="<%= cfg.partialMarks ?? 0 %>" type="number" min="0" step="0.25" class="mark-partial mt-1 w-full rounded border border-slate-200 px-2 py-1 text-xs"/></label>
                    <label class="text-[10px] font-semibold text-slate-500">Mode<select name="questionConfigs[<%= q.id %>][markingMode]" class="mt-1 w-full rounded border border-slate-200 px-2 py-1 text-xs"><option value="FULL_OR_ZERO" <%= cfg.markingMode==='FULL_OR_ZERO'?'selected':'' %>>Full or zero</option><option value="PARTIAL_SUBSET" <%= cfg.markingMode==='PARTIAL_SUBSET'?'selected':'' %>>Partial subset</option><option value="PER_CORRECT_OPTION" <%= cfg.markingMode==='PER_CORRECT_OPTION'?'selected':'' %>>Per correct option</option></select></label>
                    <label class="text-[10px] font-semibold text-slate-500">Wrong selection<select name="questionConfigs[<%= q.id %>][incorrectSelectionPolicy]" class="mt-1 w-full rounded border border-slate-200 px-2 py-1 text-xs"><option value="NEGATIVE" <%= cfg.incorrectSelectionPolicy!=='ZERO'?'selected':'' %>>Negative marks</option><option value="ZERO" <%= cfg.incorrectSelectionPolicy==='ZERO'?'selected':'' %>>Zero marks</option></select></label>
                    <label class="text-[10px] font-semibold text-slate-500">Bonus<select name="questionConfigs[<%= q.id %>][bonus]" class="mark-bonus mt-1 w-full rounded border border-slate-200 px-2 py-1 text-xs"><option value="false" <%= !cfg.bonus?'selected':'' %>>No</option><option value="true" <%= cfg.bonus?'selected':'' %>>Yes</option></select></label>
                    <label class="text-[10px] font-semibold text-slate-500">Bonus marks<input name="questionConfigs[<%= q.id %>][bonusMarks]" value="<%= cfg.bonusMarks ?? cfg.positiveMarks ?? q.marks %>" type="number" min="0" step="0.25" class="mt-1 w-full rounded border border-slate-200 px-2 py-1 text-xs"/></label>
                    <label class="text-[10px] font-semibold text-slate-500">Section<input name="questionConfigs[<%= q.id %>][section]" value="<%= cfg.section || q.subject %>" class="mt-1 w-full rounded border border-slate-200 px-2 py-1 text-xs"/></label>
                    <label class="col-span-full text-[10px] font-semibold text-slate-500">Bonus reason<input name="questionConfigs[<%= q.id %>][bonusReason]" value="<%= cfg.bonusReason || '' %>" maxlength="500" class="mt-1 w-full rounded border border-slate-200 px-2 py-1 text-xs"/></label>
                  </div>
                </details>
              </div>
            </label>
            <% }) %>
          </div>

          <!-- Select all / deselect visible -->
          <div class="flex items-center justify-between mt-3 text-xs text-slate-500">
            <button type="button" onclick="selectAllVisible()" class="hover:text-slate-900 font-medium transition-colors">✅ Select all visible</button>
            <button type="button" onclick="deselectAll()" class="hover:text-red-600 font-medium transition-colors">✕ Deselect all</button>
          </div>
        </div>

        <!-- Upload Test via PDF -->
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <div class="flex items-center justify-between gap-2 mb-1 flex-wrap">
            <div class="flex items-center gap-2">
              <h3 class="font-bold text-slate-900">📄 Upload Test via PDF</h3>
              <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full font-semibold">Optional</span>
            </div>
            <a href="/admin/tests/template/pdf" target="_blank"
               class="inline-flex items-center gap-1.5 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 px-3 py-1.5 rounded-lg transition-colors shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/>
              </svg>
              Download PDF Template
            </a>
          </div>
          <p class="text-xs text-slate-500 mb-4">Upload a question paper PDF (<strong>1 question per page</strong>) and a separate model answers / solution PDF. Questions can include <strong>embedded images/diagrams</strong> — they render automatically for students. <a href="/admin/tests/template/pdf" class="text-indigo-600 hover:underline font-medium">Download template</a> to see the expected format.</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <!-- Question Paper PDF -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">
                📝 Question Paper PDF
                <span class="text-xs text-slate-400 font-normal ml-1">(1 question per page)</span>
              </label>
              <div id="qPdfDrop" onclick="document.getElementById('questionPdf').click()"
                class="relative border-2 border-dashed border-slate-300 rounded-xl p-6 text-center cursor-pointer hover:border-blue-400 hover:bg-blue-50 transition-all group">
                <div id="qPdfIcon" class="flex flex-col items-center gap-2">
                  <svg class="w-9 h-9 text-slate-300 group-hover:text-blue-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
                  </svg>
                  <p class="text-sm text-slate-400 group-hover:text-blue-500 font-medium">Click to upload question PDF</p>
                  <p class="text-xs text-slate-300">PDF only · Max 20 MB</p>
                </div>
                <div id="qPdfPreview" class="hidden flex-col items-center gap-2">
                  <svg class="w-9 h-9 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                  </svg>
                  <p id="qPdfName" class="text-sm font-semibold text-green-700 break-all"></p>
                  <p id="qPdfPages" class="text-xs text-slate-400"></p>
                  <button type="button" onclick="clearPdf('question',event)" class="text-xs text-red-500 hover:text-red-700 font-medium mt-1">✕ Remove</button>
                </div>
              </div>
              <input type="file" id="questionPdf" name="questionPdf" accept="application/pdf" class="hidden" onchange="handlePdfSelect(this,'question')"/>
            </div>

            <!-- Model Answers / Solution PDF -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">
                ✅ Model Answers / Solution PDF
                <span class="text-xs text-slate-400 font-normal ml-1">(answer key / solutions)</span>
              </label>
              <div id="sPdfDrop" onclick="document.getElementById('solutionPdf').click()"
                class="relative border-2 border-dashed border-slate-300 rounded-xl p-6 text-center cursor-pointer hover:border-green-400 hover:bg-green-50 transition-all group">
                <div id="sPdfIcon" class="flex flex-col items-center gap-2">
                  <svg class="w-9 h-9 text-slate-300 group-hover:text-green-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/>
                  </svg>
                  <p class="text-sm text-slate-400 group-hover:text-green-600 font-medium">Click to upload answer PDF</p>
                  <p class="text-xs text-slate-300">PDF only · Max 20 MB</p>
                </div>
                <div id="sPdfPreview" class="hidden flex-col items-center gap-2">
                  <svg class="w-9 h-9 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                  </svg>
                  <p id="sPdfName" class="text-sm font-semibold text-green-700 break-all"></p>
                  <p id="sPdfPages" class="text-xs text-slate-400"></p>
                  <button type="button" onclick="clearPdf('solution',event)" class="text-xs text-red-500 hover:text-red-700 font-medium mt-1">✕ Remove</button>
                </div>
              </div>
              <input type="file" id="solutionPdf" name="solutionPdf" accept="application/pdf" class="hidden" onchange="handlePdfSelect(this,'solution')"/>
            </div>
          </div>

          <!-- Info banner -->
          <div class="mt-4 bg-blue-50 border border-blue-200 rounded-xl p-3 flex items-start gap-2 text-xs text-blue-700">
            <span class="text-base shrink-0">ℹ️</span>
            <div>
              <span>The question PDF must have <strong>exactly 1 question per page</strong>. Page count = question count. Total marks = pages × marks/question.</span>
              <span class="block mt-1">Questions <strong>with images or diagrams</strong> are fully supported — embed the image directly into the PDF page using any editor (Adobe, LibreOffice, Canva). Students see the full page including all visuals.</span>
              <a href="/admin/tests/template/pdf" class="inline-flex items-center gap-1 mt-1.5 text-indigo-700 font-semibold hover:underline">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                Download sample PDF template (5 questions incl. 2 with image placeholders)
              </a>
            </div>
          </div>
        </div>

        <div class="flex gap-4">
          <button type="submit" class="flex-1 bg-navy-950 text-white font-bold py-4 rounded-xl hover:bg-navy-800 transition-colors text-base shadow-lg">Save Changes</button>
          <a href="/admin/tests" class="px-8 py-4 border-2 border-slate-200 text-slate-700 font-semibold rounded-xl hover:bg-slate-50">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</div>
<script>
const TEST_PATTERN_OPTIONS = <%- JSON.stringify(patternOptions).replace(/</g, '\\u003c') %>;
function applyPatternDefaults(patternId) {
  const pattern = TEST_PATTERN_OPTIONS.find(item => item.id === patternId);
  if (!pattern || !confirm(`Apply ${pattern.code} marking and shuffle defaults to every question? Existing overrides will be replaced.`)) return;
  document.querySelector('input[name="negativeMarking"]').value = pattern.defaultNegativeMarks;
  document.querySelector('input[name="shuffleQuestions"]').checked = pattern.shuffleQuestionsDefault;
  document.querySelector('input[name="shuffleOptions"]').checked = pattern.shuffleOptionsDefault;
  if (pattern.rankingSchemaId) document.getElementById('rankingSchemaSelect').value = pattern.rankingSchemaId;
  if (pattern.timingMode) { document.getElementById('timingMode').value = pattern.timingMode; updateTimingFields(); }
  document.querySelectorAll('.marking-grid').forEach(grid => {
    grid.querySelector('.mark-positive').value = pattern.defaultPositiveMarks;
    grid.querySelector('.mark-negative').value = pattern.defaultNegativeMarks;
    grid.querySelector('.mark-partial').value = pattern.defaultPartialMarks;
    const mode = grid.querySelector('select[name$="[markingMode]"]');
    if (mode) mode.value = pattern.partialMarkPolicy;
  });
  updCount();
}
function updateTimingFields() {
  const mode = document.getElementById('timingMode').value;
  const duration = document.getElementById('durationInput');
  const start = document.getElementById('startTimeInput');
  const end = document.getElementById('endTimeInput');
  duration.disabled = mode !== 'PERSONAL_DURATION';
  duration.required = mode === 'PERSONAL_DURATION';
  start.required = mode === 'FIXED_WINDOW';
  end.required = mode === 'FIXED_WINDOW';
  document.getElementById('durationField').classList.toggle('opacity-50', mode !== 'PERSONAL_DURATION');
  document.getElementById('timingHint').textContent = mode === 'FIXED_WINDOW'
    ? 'Hard cutoff: every active attempt auto-submits at the end time.'
    : mode === 'UNTIMED' ? 'No countdown. Start/end only control when new attempts may begin.'
      : 'Each student receives the full personal duration after starting within the access window.';
}
function updateAccessField() {
  const enabled = document.getElementById('testAccessEnabled').checked;
  const password = document.getElementById('testAccessPassword');
  document.getElementById('testAccessField').classList.toggle('opacity-50', !enabled);
  password.disabled = !enabled;
  password.required = enabled && <%- testAccessConfigured ? 'false' : 'true' %>;
}
// ── Counter ───────────────────────────────────────────────────────────────
function updCount() {
  const selected = [...document.querySelectorAll('input[name="questionIds"]:checked')];
  const total = selected.reduce((sum, checkbox) => sum + Number(checkbox.closest('.q-item').querySelector('.mark-positive')?.value || 0), 0);
  document.getElementById('selCount').textContent = `${selected.length} selected · ${total.toFixed(2)} marks`;
}

function applyBulkMarking() {
  const scope = document.getElementById('bulkScope').value;
  const type = document.getElementById('bulkType').value;
  const subject = document.getElementById('ctSubject').value;
  const rows = [...document.querySelectorAll('.q-item')].filter(row => {
    if (scope === 'selected') return row.querySelector('input[name="questionIds"]').checked;
    if (scope === 'section') return subject && row.dataset.subj === subject;
    if (scope === 'type') return row.dataset.type === type;
    return true;
  });
  if (!rows.length) return alert(scope === 'section' ? 'Choose a subject filter first.' : 'No questions match this scope.');
  const positive = Number(document.getElementById('bulkPositive').value);
  const negative = Number(document.getElementById('bulkNegative').value);
  const partial = Number(document.getElementById('bulkPartial').value);
  if (![positive, negative, partial].every(value => Number.isFinite(value) && value >= 0)) return alert('Enter valid non-negative marking values.');
  const preview = `${rows.length} question(s) will be overwritten: +${positive}, -${negative}, partial ${partial}.`;
  if (!confirm(`${preview}\n\nContinue?`)) return;
  rows.forEach(row => {
    row.querySelector('.mark-positive').value = positive;
    row.querySelector('.mark-negative').value = negative;
    row.querySelector('.mark-partial').value = partial;
  });
  updCount();
}

// ── Current filter state ──────────────────────────────────────────────────
const ctState = { course:'', subject:'', topic:'', subtopic:'', diff:'', search:'' };

// ── Apply all filters ─────────────────────────────────────────────────────
function applyCtFilters() {
  ctState.course   = document.getElementById('ctCourse').value;
  ctState.subject  = document.getElementById('ctSubject').value;
  ctState.topic    = document.getElementById('ctTopic').value;
  ctState.subtopic = document.getElementById('ctSubtopic').value;
  ctState.diff     = document.querySelector('.diff-chip.active')?.dataset.diff || '';
  ctState.search   = (document.getElementById('ctSearch').value || '').toLowerCase();

  // Filter question rows
  document.querySelectorAll('.q-item').forEach(row => {
    const matchSubj    = !ctState.subject  || row.dataset.subj     === ctState.subject;
    const matchTopic   = !ctState.topic    || row.dataset.topic    === ctState.topic;
    const matchSub     = !ctState.subtopic || row.dataset.subtopic === ctState.subtopic;
    const matchDiff    = !ctState.diff     || row.dataset.diff     === ctState.diff;
    const matchSearch  = !ctState.search   || row.dataset.text.includes(ctState.search);
    row.style.display  = (matchSubj && matchTopic && matchSub && matchDiff && matchSearch) ? '' : 'none';
  });

  // Show/hide group headers — only show if they have at least one visible q-item
  document.querySelectorAll('.q-group-header').forEach(header => {
    if (!header.dataset.topic) {
      // Subject header — show if any q-item below with same subject is visible
      const subj = header.dataset.subj;
      const hasVisible = [...document.querySelectorAll('.q-item')]
        .some(r => r.dataset.subj === subj && r.style.display !== 'none');
      header.style.display = hasVisible ? '' : 'none';
    } else {
      // Topic header
      const subj  = header.dataset.subj;
      const topic = header.dataset.topic;
      const hasVisible = [...document.querySelectorAll('.q-item')]
        .some(r => r.dataset.subj === subj && r.dataset.topic === topic && r.style.display !== 'none');
      header.style.display = hasVisible ? '' : 'none';
    }
  });

  updateBreadcrumb();
}

// ── Course and subject hierarchy ─────────────────────────────────────────
async function onCtCourseChange(course) {
  const subjectSelect = document.getElementById('ctSubject');
  const topicSelect = document.getElementById('ctTopic');
  const subtopicSelect = document.getElementById('ctSubtopic');
  subjectSelect.innerHTML = '<option value="">All Subjects</option>';
  topicSelect.innerHTML = '<option value="">All Units</option>';
  subtopicSelect.innerHTML = '<option value="">All Subtopics</option>';
  subjectSelect.disabled = !course;
  topicSelect.disabled = true;
  subtopicSelect.disabled = true;
  if (course) {
    const subjects = await fetchSubjects(course);
    subjects.forEach(subject => subjectSelect.innerHTML += `<option value="${subject}">${subject}</option>`);
  }
  applyCtFilters();
}

async function onCtSubjectChange(subject) {
  const tSel  = document.getElementById('ctTopic');
  const stSel = document.getElementById('ctSubtopic');
  tSel.innerHTML  = '<option value="">All Units</option>';
  stSel.innerHTML = '<option value="">All Subtopics</option>';
  tSel.disabled = !subject;
  stSel.disabled = true;
  if (subject) {
    const topics = await fetchTopics(document.getElementById('ctCourse').value, subject);
    topics.forEach(t => tSel.innerHTML += `<option value="${t.name}">${t.name}</option>`);
  }
  applyCtFilters();
}

// ── Topic change ──────────────────────────────────────────────────────────
async function onCtTopicChange(topic) {
  const stSel = document.getElementById('ctSubtopic');
  const course = document.getElementById('ctCourse').value;
  const subj  = document.getElementById('ctSubject').value;
  stSel.innerHTML = '<option value="">All Subtopics</option>';
  stSel.disabled = !topic;
  if (topic) {
    const subs = await fetchSubtopics(course, subj, topic);
    subs.forEach(s => stSel.innerHTML += `<option value="${s}">${s}</option>`);
  }
  applyCtFilters();
}

// ── Difficulty chip filter ────────────────────────────────────────────────
function filterDiff(diff) {
  document.querySelectorAll('.diff-chip').forEach(b => {
    b.classList.remove('active','bg-slate-900','text-white');
    if (!b.dataset.diff) b.dataset.diff = b.textContent.trim() === 'All' ? '' : b.textContent.trim();
  });
  event.target.classList.add('active','bg-slate-900','text-white');
  ctState.diff = diff;
  applyCtFilters();
}

// ── Reset all filters ─────────────────────────────────────────────────────
function resetCtFilters() {
  document.getElementById('ctCourse').value = '';
  document.getElementById('ctSubject').innerHTML = '<option value="">Select course first</option>';
  document.getElementById('ctTopic').innerHTML   = '<option value="">All Units</option>';
  document.getElementById('ctSubtopic').innerHTML = '<option value="">All Subtopics</option>';
  document.getElementById('ctSubject').disabled = true;
  document.getElementById('ctTopic').disabled = true;
  document.getElementById('ctSubtopic').disabled = true;
  document.getElementById('ctSearch').value   = '';
  document.querySelectorAll('.diff-chip').forEach(b => b.classList.remove('active','bg-slate-900','text-white'));
  document.querySelector('.diff-chip').classList.add('active','bg-slate-900','text-white');
  Object.keys(ctState).forEach(k => ctState[k] = '');
  document.querySelectorAll('.q-item,.q-group-header').forEach(r => r.style.display = '');
  updateBreadcrumb();
}

// ── Breadcrumb display ────────────────────────────────────────────────────
function updateBreadcrumb() {
  const crumb = document.getElementById('ctBreadcrumb');
  const inner = document.getElementById('ctBreadcrumbInner');
  const parts = [];
  if (ctState.course)   parts.push(`<span class="bg-slate-900 text-white px-2 py-0.5 rounded-full text-xs font-semibold">${ctState.course}</span>`);
  if (ctState.subject)  parts.push(`<span class="bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full text-xs font-semibold">${ctState.subject}</span>`);
  if (ctState.topic)    parts.push(`<span class="text-slate-400 text-xs">›</span><span class="bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full text-xs font-semibold">${ctState.topic}</span>`);
  if (ctState.subtopic) parts.push(`<span class="text-slate-400 text-xs">›</span><span class="bg-orange-100 text-orange-600 px-2 py-0.5 rounded-full text-xs font-semibold">${ctState.subtopic}</span>`);
  inner.innerHTML = parts.join('');
  crumb.style.display = parts.length ? 'flex' : 'none';
}

// ── Select / Deselect helpers ─────────────────────────────────────────────
function selectAllVisible() {
  document.querySelectorAll('.q-item').forEach(row => {
    if (row.style.display !== 'none') row.querySelector('input[type="checkbox"]').checked = true;
  });
  updCount();
}

function deselectAll() {
  document.querySelectorAll('input[name="questionIds"]').forEach(cb => cb.checked = false);
  updCount();
}

// ── AJAX topic/subtopic fetchers ──────────────────────────────────────────
async function fetchSubjects(course) {
  try {
    const r = await fetch(`/admin/ajax/subjects/${encodeURIComponent(course)}`);
    return await r.json();
  } catch { return []; }
}

async function fetchTopics(course, subject) {
  try {
    const r = await fetch(`/admin/ajax/topics?course=${encodeURIComponent(course)}&subject=${encodeURIComponent(subject)}`);
    return await r.json();
  } catch { return []; }
}

async function fetchSubtopics(course, subject, topic) {
  try {
    const r = await fetch(`/admin/ajax/subtopics?course=${encodeURIComponent(course)}&subject=${encodeURIComponent(subject)}&topic=${encodeURIComponent(topic)}`);
    return await r.json();
  } catch { return []; }
}

// ── Test detail page: load subjects on course select ──────────────────────
function loadSubjects(course) {
  if (!course) return;
  fetch(`/admin/ajax/subjects/${course}`).then(r => r.json()).then(subjects => {
    const sel = document.getElementById('subjectSelect');
    sel.innerHTML = '<option value="">Select Subject</option>' + subjects.map(s => `<option value="${s}">${s}</option>`).join('');
  }).catch(() => {});
}

// ── Sort questions in the list ────────────────────────────────────────────
function applyCtSort() {
  const sort = document.getElementById('ctSort').value;
  const list = document.getElementById('ctQuestionList');

  // Collect all q-items with their checked state
  const items = [...list.querySelectorAll('.q-item')].map(el => ({
    el,
    subj: el.dataset.subj || '',
    topic: el.dataset.topic || '',
    subtopic: el.dataset.subtopic || '',
    diff: el.dataset.diff || '',
    idx: parseInt(el.dataset.idx || '0'),
  }));

  const diffOrder = { Easy: 0, Medium: 1, Hard: 2 };

  items.sort((a, b) => {
    if (sort === 'difficulty') {
      const d = (diffOrder[a.diff] ?? 9) - (diffOrder[b.diff] ?? 9);
      if (d !== 0) return d;
      return a.subj.localeCompare(b.subj) || a.topic.localeCompare(b.topic);
    } else if (sort === 'newest') {
      return b.idx - a.idx; // higher idx = newer
    } else {
      // subject → topic → subtopic
      return a.subj.localeCompare(b.subj) || a.topic.localeCompare(b.topic) || a.subtopic.localeCompare(b.subtopic);
    }
  });

  // Remove all existing headers + items; re-append sorted items with fresh headers
  list.querySelectorAll('.q-item, .q-group-header').forEach(el => el.remove());

  let lastSubj = null, lastTopic = null;
  items.forEach(({ el, subj, topic, subtopic, diff }) => {
    if (sort === 'subject') {
      if (subj !== lastSubj) {
        lastSubj = subj; lastTopic = null;
        const sh = document.createElement('div');
        sh.className = 'q-group-header px-4 py-2 bg-blue-50 border-b border-blue-100 sticky top-0 z-[1]';
        sh.dataset.subj = subj; sh.dataset.topic = ''; sh.dataset.subtopic = '';
        sh.innerHTML = '<span class="text-xs font-bold text-blue-700 uppercase tracking-wider">📚 ' + (subj || 'No Subject') + '</span>';
        list.appendChild(sh);
      }
      if (topic && topic !== lastTopic) {
        lastTopic = topic;
        const th = document.createElement('div');
        th.className = 'q-group-header px-5 py-1.5 bg-purple-50 border-b border-purple-100';
        th.dataset.subj = subj; th.dataset.topic = topic; th.dataset.subtopic = '';
        th.innerHTML = '<span class="text-xs font-semibold text-purple-600">📌 ' + topic + '</span>' +
          (subtopic ? '<span class="text-purple-400 mx-1">›</span><span class="text-xs text-purple-500">' + subtopic + '</span>' : '');
        list.appendChild(th);
      }
    } else if (sort === 'difficulty') {
      if (diff !== lastSubj) { // reuse lastSubj for diff grouping
        lastSubj = diff;
        const dh = document.createElement('div');
        const colors = { Easy: 'bg-green-50 border-green-100 text-green-700', Medium: 'bg-yellow-50 border-yellow-100 text-yellow-700', Hard: 'bg-red-50 border-red-100 text-red-700' };
        const cls = colors[diff] || 'bg-slate-50 border-slate-100 text-slate-600';
        dh.className = 'q-group-header px-4 py-2 border-b sticky top-0 z-[1] ' + cls;
        dh.dataset.subj = ''; dh.dataset.topic = ''; dh.dataset.subtopic = '';
        dh.innerHTML = '<span class="text-xs font-bold uppercase tracking-wider">' + (diff || 'No Difficulty') + '</span>';
        list.appendChild(dh);
      }
    }
    list.appendChild(el);
  });

  // Re-apply current filters so visibility is correct
  applyCtFilters();
}

// Set data-diff on diff chips on load
document.querySelectorAll('.diff-chip').forEach(b => {
  const t = b.textContent.trim();
  b.dataset.diff = t === 'All' ? '' : t;
});
updCount();
updateTimingFields();
updateAccessField();
</script>

<script>
function toggleAutoSubmit(checked) {
  const limits = document.getElementById('violationLimits');
  if (checked) limits.classList.remove('hidden');
  else limits.classList.add('hidden');
}
</script>

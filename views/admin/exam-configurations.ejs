<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto">
    <header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 px-5 py-4 backdrop-blur lg:px-8"><h1 class="text-lg font-bold text-slate-900">Test Patterns &amp; Ranking Schemas</h1><p class="text-xs text-slate-400">Reusable configuration templates; tests retain a snapshot when saved</p></header>
    <div class="p-5 lg:p-8"><%- include('../partials/flash') %>
      <div class="grid gap-6 xl:grid-cols-2">
        <section class="space-y-4">
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <h2 class="font-bold text-slate-900"><%= editingPattern?'Edit Custom Pattern':'Create Custom Pattern' %></h2>
            <p class="mt-1 text-xs text-slate-400">System patterns remain stable; create custom templates for organization-specific rules.</p>
            <form action="<%= editingPattern?`/admin/exam-configurations/patterns/${editingPattern.id}`:'/admin/exam-configurations/patterns' %>" method="POST" class="mt-4 grid grid-cols-2 gap-3">
              <label class="text-xs font-bold text-slate-600">Name *<input name="name" required value="<%= editingPattern?editingPattern.name:'' %>" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal"/></label>
              <label class="text-xs font-bold text-slate-600">Code *<input name="code" required value="<%= editingPattern?editingPattern.code:'' %>" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-mono font-normal uppercase"/></label>
              <label class="col-span-2 text-xs font-bold text-slate-600">Description<input name="description" value="<%= editingPattern?(editingPattern.description||''):'' %>" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal"/></label>
              <fieldset class="col-span-2"><legend class="text-xs font-bold text-slate-600">Allowed Question Types *</legend><div class="mt-2 flex flex-wrap gap-2"><% QUESTION_TYPES.forEach(type=>{ %><label class="rounded-lg border border-slate-200 px-2 py-1.5 text-[10px] font-semibold"><input type="checkbox" name="allowedQuestionTypes" value="<%= type %>" class="mr-1" <%= editingPattern&&(editingPattern.allowedQuestionTypes||[]).includes(type)?'checked':'' %>/><%= type.replaceAll('_',' ') %></label><% }) %></div></fieldset>
              <label class="text-xs font-bold text-slate-600">Positive<input name="defaultPositiveMarks" type="number" min="0" step="0.25" value="<%= editingPattern?editingPattern.defaultPositiveMarks:1 %>" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal"/></label>
              <label class="text-xs font-bold text-slate-600">Negative<input name="defaultNegativeMarks" type="number" min="0" step="0.25" value="<%= editingPattern?editingPattern.defaultNegativeMarks:0 %>" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal"/></label>
              <label class="text-xs font-bold text-slate-600">Partial<input name="defaultPartialMarks" type="number" min="0" step="0.25" value="<%= editingPattern?editingPattern.defaultPartialMarks:0 %>" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal"/></label>
              <label class="text-xs font-bold text-slate-600">Partial Policy<select name="partialMarkPolicy" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal"><% ['FULL_OR_ZERO','PARTIAL_SUBSET','PER_CORRECT_OPTION'].forEach(value=>{ %><option value="<%= value %>" <%= editingPattern&&editingPattern.partialMarkPolicy===value?'selected':'' %>><%= value.replaceAll('_',' ') %></option><% }) %></select></label>
              <label class="text-xs font-bold text-slate-600">Timing Default<select name="timingMode" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal"><% TIMING_MODES.forEach(value=>{ %><option value="<%= value %>" <%= editingPattern&&editingPattern.timingMode===value?'selected':'' %>><%= value.replaceAll('_',' ') %></option><% }) %></select></label>
              <label class="text-xs font-bold text-slate-600">Ranking Default<select name="rankingSchema" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal"><% rankingSchemas.filter(item=>item.isActive).forEach(item=>{ %><option value="<%= item.id %>" <%= editingPattern&&String(editingPattern.rankingSchema)===String(item.id)?'selected':'' %>><%= item.name %></option><% }) %></select></label>
              <div class="col-span-2 flex flex-wrap gap-3 rounded-lg bg-slate-50 p-3 text-xs"><label><input type="checkbox" name="shuffleQuestionsDefault" class="mr-1" <%= !editingPattern||editingPattern.shuffleQuestionsDefault?'checked':'' %>/>Shuffle questions</label><label><input type="checkbox" name="shuffleOptionsDefault" class="mr-1" <%= editingPattern&&editingPattern.shuffleOptionsDefault?'checked':'' %>/>Shuffle options</label><label><input type="checkbox" name="cetSectionFlow" class="mr-1" <%= editingPattern&&editingPattern.cetSectionFlow?'checked':'' %>/>CET section flow</label></div>
              <button class="col-span-2 rounded-lg bg-indigo-600 py-2.5 text-xs font-bold text-white"><%= editingPattern?'Save Pattern':'Create Pattern' %></button>
              <% if(editingPattern){ %><a href="/admin/exam-configurations" class="col-span-2 text-center text-xs text-slate-500">Cancel edit</a><% } %>
            </form>
          </div>

          <% patterns.forEach(pattern=>{ %><article class="rounded-2xl border border-slate-200 bg-white p-4 <%= pattern.isActive?'':'opacity-60' %>"><div class="flex items-start justify-between gap-3"><div><p class="text-[10px] font-bold uppercase tracking-widest text-indigo-500"><%= pattern.code %> <%= pattern.isSystem?'· SYSTEM':'' %></p><h3 class="font-bold text-slate-900"><%= pattern.name %></h3><p class="mt-1 text-xs text-slate-500"><%= pattern.description||'' %></p></div><span class="rounded-full px-2 py-1 text-[10px] font-bold <%= pattern.isActive?'bg-emerald-100 text-emerald-700':'bg-slate-100 text-slate-500' %>"><%= pattern.isActive?'Active':'Disabled' %></span></div><div class="mt-3 flex flex-wrap gap-1"><% (pattern.allowedQuestionTypes||[]).forEach(type=>{ %><span class="rounded bg-slate-100 px-2 py-1 text-[9px] text-slate-600"><%= type.replaceAll('_',' ') %></span><% }) %><span class="rounded bg-amber-50 px-2 py-1 text-[9px] text-amber-700">+<%= pattern.defaultPositiveMarks %> / −<%= pattern.defaultNegativeMarks %></span></div><% if(!pattern.isSystem){ %><div class="mt-3 flex gap-2"><a href="?editPattern=<%= pattern.id %>" class="rounded-lg bg-indigo-50 px-3 py-1.5 text-[10px] font-bold text-indigo-700">Edit</a><form action="/admin/exam-configurations/patterns/<%= pattern.id %>/toggle" method="POST"><button class="rounded-lg bg-slate-100 px-3 py-1.5 text-[10px] font-bold text-slate-600"><%= pattern.isActive?'Disable':'Enable' %></button></form></div><% } %></article><% }) %>
        </section>

        <section class="space-y-4">
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <h2 class="font-bold text-slate-900"><%= editingRanking?'Edit Ranking Schema':'Create Ranking Schema' %></h2>
            <p class="mt-1 text-xs text-slate-400">Criteria are evaluated in order.</p>
            <form action="<%= editingRanking?`/admin/exam-configurations/rankings/${editingRanking.id}`:'/admin/exam-configurations/rankings' %>" method="POST" class="mt-4 grid grid-cols-2 gap-3">
              <label class="text-xs font-bold text-slate-600">Name *<input name="name" required value="<%= editingRanking?editingRanking.name:'' %>" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal"/></label>
              <label class="text-xs font-bold text-slate-600">Code *<input name="code" required value="<%= editingRanking?editingRanking.code:'' %>" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-mono font-normal uppercase"/></label>
              <label class="col-span-2 text-xs font-bold text-slate-600">Description<input name="description" value="<%= editingRanking?(editingRanking.description||''):'' %>" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal"/></label>
              <% for(let index=0;index<5;index+=1){ const criterion=editingRanking&&editingRanking.criteria[index]; %><label class="text-xs font-bold text-slate-600">Criterion <%= index+1 %><select name="criteriaFields" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal"><option value="">Unused</option><% RANK_FIELDS.forEach(field=>{ %><option value="<%= field %>" <%= criterion&&criterion.field===field?'selected':'' %>><%= field %></option><% }) %></select></label><label class="text-xs font-bold text-slate-600">Direction<select name="criteriaDirections" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal"><option value="DESC" <%= criterion&&criterion.direction==='DESC'?'selected':'' %>>Higher first</option><option value="ASC" <%= criterion&&criterion.direction==='ASC'?'selected':'' %>>Lower first</option></select></label><% } %>
              <label class="col-span-2 text-xs font-bold text-slate-600">Tie Policy<select name="tiePolicy" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal"><% ['ORDINAL','DENSE','COMPETITION'].forEach(value=>{ %><option value="<%= value %>" <%= editingRanking&&editingRanking.tiePolicy===value?'selected':'' %>><%= value %></option><% }) %></select></label>
              <button class="col-span-2 rounded-lg bg-navy-950 py-2.5 text-xs font-bold text-white"><%= editingRanking?'Save Ranking Schema':'Create Ranking Schema' %></button>
              <% if(editingRanking){ %><a href="/admin/exam-configurations" class="col-span-2 text-center text-xs text-slate-500">Cancel edit</a><% } %>
            </form>
          </div>

          <% rankingSchemas.forEach(schema=>{ %><article class="rounded-2xl border border-slate-200 bg-white p-4 <%= schema.isActive?'':'opacity-60' %>"><div class="flex items-start justify-between gap-3"><div><p class="text-[10px] font-bold uppercase tracking-widest text-violet-500"><%= schema.code %> <%= schema.isSystem?'· SYSTEM':'' %></p><h3 class="font-bold text-slate-900"><%= schema.name %></h3><p class="mt-1 text-xs text-slate-500"><%= schema.description||'' %></p></div><span class="rounded-full px-2 py-1 text-[10px] font-bold <%= schema.isActive?'bg-emerald-100 text-emerald-700':'bg-slate-100 text-slate-500' %>"><%= schema.isActive?'Active':'Disabled' %></span></div><ol class="mt-3 space-y-1"><% (schema.criteria||[]).forEach((criterion,index)=>{ %><li class="text-xs text-slate-600"><%= index+1 %>. <%= criterion.direction==='DESC'?'Higher':'Lower' %> <%= criterion.field %></li><% }) %></ol><p class="mt-2 text-[10px] text-slate-400">Tie policy: <%= schema.tiePolicy %></p><% if(!schema.isSystem){ %><div class="mt-3 flex gap-2"><a href="?editRanking=<%= schema.id %>" class="rounded-lg bg-violet-50 px-3 py-1.5 text-[10px] font-bold text-violet-700">Edit</a><form action="/admin/exam-configurations/rankings/<%= schema.id %>/toggle" method="POST"><button class="rounded-lg bg-slate-100 px-3 py-1.5 text-[10px] font-bold text-slate-600"><%= schema.isActive?'Disable':'Enable' %></button></form></div><% } %></article><% }) %>
        </section>
      </div>
    </div>
  </main>
</div>
</body></html>

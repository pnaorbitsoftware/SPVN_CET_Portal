<%- include('../partials/head') %>
<div class="flex min-h-screen">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 min-w-0">
    <header class="sticky top-0 z-10 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4">
      <div class="flex items-center gap-3">
        <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <a href="/admin/questions" class="text-slate-400 hover:text-slate-700">←</a>
        <div>
          <h1 class="text-lg font-bold text-slate-900">Smart Question Scan</h1>
          <p class="text-xs text-slate-500">PDF, Word, Excel, CSV, scans and handwritten photos</p>
        </div>
      </div>
    </header>

    <div class="p-5 lg:p-8 max-w-6xl mx-auto">
      <%- include('../partials/flash') %>

      <div class="rounded-2xl bg-gradient-to-br from-indigo-950 via-indigo-900 to-violet-800 text-white p-6 lg:p-8 mb-6 shadow-xl overflow-hidden relative">
        <div class="absolute -right-16 -top-20 w-64 h-64 rounded-full bg-white/10"></div>
        <div class="relative max-w-3xl">
          <span class="inline-flex items-center gap-1.5 bg-white/10 border border-white/20 rounded-full px-3 py-1 text-xs font-semibold mb-4">✨ AI-powered question digitization</span>
          <h2 class="text-2xl lg:text-3xl font-bold leading-tight mb-3">One page can contain any number of questions.</h2>
          <p class="text-indigo-100 text-sm lg:text-base leading-relaxed">The scanner detects real question blocks and their A/B/C/D options. It does not assume “one page = one question”. Upload a question paper and a separate answer key together when needed.</p>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mt-6 text-xs">
            <div class="bg-white/10 border border-white/10 rounded-xl p-3"><strong class="block text-white mb-1">1–100+ per page</strong><span class="text-indigo-200">Block-based detection</span></div>
            <div class="bg-white/10 border border-white/10 rounded-xl p-3"><strong class="block text-white mb-1">Handwriting</strong><span class="text-indigo-200">High-detail vision</span></div>
            <div class="bg-white/10 border border-white/10 rounded-xl p-3"><strong class="block text-white mb-1">Answer keys</strong><span class="text-indigo-200">Cross-file matching</span></div>
            <div class="bg-white/10 border border-white/10 rounded-xl p-3"><strong class="block text-white mb-1">Review first</strong><span class="text-indigo-200">Nothing auto-publishes</span></div>
          </div>
        </div>
      </div>

      <% if (!aiEnabled) { %>
      <div class="mb-6 bg-amber-50 border border-amber-300 rounded-xl p-4 flex items-start gap-3">
        <span class="text-xl">⚠️</span>
        <div>
          <p class="text-sm font-bold text-amber-900">AI scanner is not configured</p>
          <p class="text-xs text-amber-800 mt-1">Standard CSV/Excel imports work now. Add <code class="bg-amber-100 px-1.5 py-0.5 rounded">GEMINI_API_KEY</code> or <code class="bg-amber-100 px-1.5 py-0.5 rounded">OPENAI_API_KEY</code> to <code class="bg-amber-100 px-1.5 py-0.5 rounded">.env</code> and restart the server to scan PDF, Word and handwritten images.</p>
        </div>
      </div>
      <% } %>

      <form action="/admin/questions/smart-import/scan" method="POST" enctype="multipart/form-data" id="scanForm" class="grid grid-cols-1 lg:grid-cols-3 gap-6" onsubmit="return beginScan()">
        <section class="lg:col-span-2 bg-white border border-slate-200 rounded-2xl shadow-sm p-5 lg:p-6">
          <div class="flex items-center justify-between gap-3 mb-4">
            <div>
              <h3 class="font-bold text-slate-900">1. Upload source files</h3>
              <p class="text-xs text-slate-500 mt-1">Question paper, answer key, or both together</p>
            </div>
            <span class="text-[11px] text-slate-500 bg-slate-100 rounded-full px-3 py-1">Max <%= maxFiles %> files / <%= maxTotalSizeMb %> MB</span>
          </div>

          <label id="dropZone" class="block border-2 border-dashed border-slate-300 hover:border-indigo-400 hover:bg-indigo-50/50 rounded-2xl p-8 lg:p-12 text-center cursor-pointer transition-colors">
            <span class="mx-auto w-14 h-14 rounded-2xl bg-indigo-100 text-indigo-700 flex items-center justify-center text-2xl mb-4">↑</span>
            <span class="block font-bold text-slate-900">Drop files here or click to browse</span>
            <span class="block text-xs text-slate-500 mt-2">PDF · DOC/DOCX · CSV/XLS/XLSX · JPG/PNG/WEBP/HEIC · TXT/RTF/ODT</span>
            <input id="questionFiles" type="file" name="questionFiles" multiple required
              accept=".pdf,.doc,.docx,.rtf,.odt,.txt,.md,.csv,.xls,.xlsx,.jpg,.jpeg,.png,.webp,.gif,.heic,.heif,.tif,.tiff,.bmp"
              class="sr-only" onchange="showFiles(this.files)"/>
          </label>

          <div id="fileList" class="hidden mt-4 space-y-2"></div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-5">
            <div class="rounded-xl border border-slate-200 p-3">
              <p class="text-sm font-semibold text-slate-800">📄 Typed documents</p>
              <p class="text-xs text-slate-500 mt-1">PDF and Word text, including multi-page papers.</p>
            </div>
            <div class="rounded-xl border border-slate-200 p-3">
              <p class="text-sm font-semibold text-slate-800">✍️ Handwritten photos</p>
              <p class="text-xs text-slate-500 mt-1">Use a sharp, straight photo with good lighting.</p>
            </div>
            <div class="rounded-xl border border-slate-200 p-3">
              <p class="text-sm font-semibold text-slate-800">📊 Structured sheets</p>
              <p class="text-xs text-slate-500 mt-1">CSV/Excel uses fast deterministic parsing.</p>
            </div>
          </div>
        </section>

        <aside class="bg-white border border-slate-200 rounded-2xl shadow-sm p-5 lg:p-6 h-fit">
          <div class="mb-5">
            <h3 class="font-bold text-slate-900">2. Default metadata</h3>
            <p class="text-xs text-slate-500 mt-1">Used only when the file does not specify it</p>
          </div>
          <div class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1.5">Subject *</label>
              <select name="subject" required class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                <% SUBJECTS.forEach(subject => { %><option value="<%= subject %>"><%= subject %></option><% }) %>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1.5">Topic / Chapter</label>
              <input name="topic" type="text" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="e.g. Electrostatics"/>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1.5">Subtopic</label>
              <input name="subtopic" type="text" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Optional"/>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Difficulty</label>
                <select name="difficulty" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm">
                  <option>Easy</option>
                  <option selected>Medium</option>
                  <option>Hard</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Marks</label>
                <input name="marks" type="number" value="1" min="0.25" max="100" step="0.25" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-sm"/>
              </div>
            </div>
          </div>

          <button id="scanButton" type="submit" class="w-full mt-6 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl transition-colors flex items-center justify-center gap-2">
            <span>✨</span> Scan &amp; Review
          </button>
          <p class="text-[11px] leading-relaxed text-slate-400 mt-3 text-center">AI results can contain mistakes. Correct answers must be reviewed before publishing an exam.</p>
        </aside>
      </form>
    </div>
  </main>
</div>

<div id="scanOverlay" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-6">
  <div class="bg-white rounded-2xl p-7 max-w-sm w-full text-center shadow-2xl">
    <div class="w-14 h-14 border-4 border-indigo-100 border-t-indigo-600 rounded-full animate-spin mx-auto mb-5"></div>
    <h3 class="font-bold text-slate-900 text-lg">Scanning every question…</h3>
    <p class="text-sm text-slate-500 mt-2">Large PDFs and handwriting can take a few minutes. Keep this page open.</p>
    <div class="mt-5 bg-slate-100 rounded-full h-1.5 overflow-hidden"><div class="h-full bg-indigo-600 animate-pulse w-2/3 rounded-full"></div></div>
  </div>
</div>

<script>
const input = document.getElementById('questionFiles');
const dropZone = document.getElementById('dropZone');

function formatBytes(bytes) {
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

function showFiles(files) {
  const list = document.getElementById('fileList');
  if (!files.length) {
    list.classList.add('hidden');
    list.innerHTML = '';
    return;
  }
  list.classList.remove('hidden');
  list.innerHTML = Array.from(files).map((file, index) => `
    <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5">
      <span class="w-7 h-7 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-xs font-bold text-indigo-600">${index + 1}</span>
      <span class="text-sm text-slate-700 truncate flex-1">${escapeHtml(file.name)}</span>
      <span class="text-xs text-slate-400">${formatBytes(file.size)}</span>
    </div>`).join('');
}

function escapeHtml(value) {
  const node = document.createElement('div');
  node.textContent = value;
  return node.innerHTML;
}

['dragenter','dragover'].forEach(eventName => dropZone.addEventListener(eventName, event => {
  event.preventDefault();
  dropZone.classList.add('border-indigo-500','bg-indigo-50');
}));
['dragleave','drop'].forEach(eventName => dropZone.addEventListener(eventName, event => {
  event.preventDefault();
  dropZone.classList.remove('border-indigo-500','bg-indigo-50');
}));
dropZone.addEventListener('drop', event => {
  input.files = event.dataTransfer.files;
  showFiles(input.files);
});

function beginScan() {
  const files = Array.from(input.files);
  if (!files.length) return false;
  if (files.length > <%= maxFiles %>) {
    alert('Choose a maximum of <%= maxFiles %> files.');
    return false;
  }
  const total = files.reduce((sum, file) => sum + file.size, 0);
  if (total > <%= maxTotalSizeMb %> * 1024 * 1024) {
    alert('Combined file size must be below <%= maxTotalSizeMb %> MB.');
    return false;
  }
  document.getElementById('scanButton').disabled = true;
  document.getElementById('scanOverlay').classList.remove('hidden');
  return true;
}
</script>

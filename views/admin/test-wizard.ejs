<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto">
    <header class="sticky top-0 z-20 flex items-center gap-4 border-b border-slate-200 bg-white/90 px-5 py-4 backdrop-blur lg:px-8">
      <a href="/admin/tests" class="text-xl text-slate-400">←</a>
      <div class="flex-1"><h1 class="text-xl font-bold text-slate-950">Create Combined Test</h1><p class="text-sm text-slate-500">One clear decision at each step</p></div>
      <a href="/admin/tests/create/legacy" class="text-sm font-semibold text-slate-400 hover:text-slate-700">Open legacy creator</a>
    </header>

    <% const steps=[['parts','Test Parts'],['identity','Test Identity'],['audience','Batch'],['delivery','Delivery'],['review','Review']]; const currentIndex=steps.findIndex(item=>item[0]===step); %>
    <div class="mx-auto max-w-6xl p-5 lg:p-8">
      <nav class="mb-8 grid grid-cols-5 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-card">
        <% steps.forEach((item,index) => { %>
        <a href="<%= index<currentIndex ? `/admin/tests/create/${item[0]}` : '#' %>" class="border-r border-slate-100 px-2 py-4 text-center last:border-0 <%= index===currentIndex?'bg-navy-950 text-white':index<currentIndex?'bg-emerald-50 text-emerald-700':'text-slate-400' %>">
          <span class="mx-auto mb-1 flex h-7 w-7 items-center justify-center rounded-full text-sm font-bold <%= index===currentIndex?'bg-white text-navy-950':index<currentIndex?'bg-emerald-600 text-white':'bg-slate-100' %>"><%= index<currentIndex?'✓':index+1 %></span>
          <span class="hidden text-sm font-semibold sm:block"><%= item[1] %></span>
        </a>
        <% }) %>
      </nav>

      <%- include('../partials/flash') %>

      <% if (step==='parts') { %>
      <form method="POST" action="/admin/tests/create/parts" class="space-y-6">
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
          <div class="mb-6 flex flex-wrap items-start justify-between gap-4"><div><span class="text-sm font-bold uppercase tracking-wider text-indigo-600">Step 1 of 5</span><h2 class="mt-1 text-2xl font-bold text-slate-950">Which subject parts make this test?</h2><p class="mt-2 text-slate-500">Select one or more named Ready parts. Their question order and individual marks are preserved.</p></div><a href="/admin/test-parts/create" class="rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-2.5 font-semibold text-indigo-700">+ Build a new part</a></div>
          <% if (!parts.length) { %><div class="rounded-2xl border border-dashed border-slate-300 p-12 text-center"><h3 class="text-lg font-bold text-slate-800">No Ready parts available</h3><p class="mt-2 text-slate-500">Build a subject part, add its questions, then mark it Ready.</p><a href="/admin/test-parts/create" class="mt-5 inline-block rounded-xl bg-navy-950 px-5 py-3 font-semibold text-white">Build Subject Part</a></div><% } %>
          <div class="space-y-6">
            <% SUBJECTS.forEach(subject => { const subjectParts=parts.filter(part=>part.subject===subject); if(subjectParts.length) { %>
            <div><h3 class="mb-3 text-lg font-bold text-slate-900"><%= subject %></h3><div class="grid gap-3 md:grid-cols-2"><% subjectParts.forEach(part => { %>
              <label class="cursor-pointer rounded-2xl border border-slate-200 p-4 transition hover:border-indigo-300 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50">
                <div class="flex items-start gap-3"><input type="checkbox" name="partIds" value="<%= part._id %>" class="mt-1 h-5 w-5 rounded" <%= (wizard.partIds||[]).includes(String(part._id))?'checked':'' %>/><div class="flex-1"><strong class="block text-base text-slate-950"><%= part.name %></strong><span class="mt-1 block text-sm text-slate-500"><%= part.questionConfigs.length %> questions · <%= [part.topic,part.subtopic].filter(Boolean).join(' › ') || 'Mixed hierarchy' %></span></div></div>
              </label>
            <% }) %></div></div>
            <% } }) %>
          </div>
        </section>
        <% if (parts.length) { %><button class="w-full rounded-xl bg-navy-950 py-4 text-lg font-bold text-white">Next: Test Identity →</button><% } %>
      </form>
      <% } %>

      <% if (step==='identity') { const identity=wizard.identity||{}; const defaultPattern=patterns.find(pattern=>pattern.code==='CUSTOM') || patterns[0]; const defaultRanking=rankingSchemas.find(schema=>schema.code==='SCHEME_1') || rankingSchemas[0]; %>
      <form method="POST" action="/admin/tests/create/identity" class="space-y-6">
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
          <span class="text-sm font-bold uppercase tracking-wider text-indigo-600">Step 2 of 5</span><h2 class="mt-1 text-2xl font-bold text-slate-950">Name and exam identity</h2><p class="mt-2 text-slate-500">The subject content is already fixed. Now identify the final test.</p>
          <div class="mt-7 grid gap-5 md:grid-cols-2">
            <label class="font-semibold text-slate-700 md:col-span-2">Final test name *<input name="title" required maxlength="200" value="<%= identity.title||'' %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal" placeholder="e.g. MHT-CET Full Test 08 — 24 August"/></label>
            <fieldset class="md:col-span-2"><legend class="font-semibold text-slate-700">Exam stream</legend><div class="mt-2 flex flex-wrap gap-3"><% COURSES.forEach(course => { %><label class="rounded-xl border border-slate-200 px-4 py-3 font-semibold has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50"><input type="checkbox" name="courses" value="<%= course %>" class="mr-2" <%= (identity.courses||[]).includes(course)?'checked':'' %>/><%= course %></label><% }) %></div><p class="mt-2 text-sm text-slate-400">Optional here—this does not change the questions in the selected parts.</p></fieldset>
            <label class="font-semibold text-slate-700">Test type<select name="testType" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 font-normal"><% TEST_TYPES.forEach(type => { %><option value="<%= type %>" <%= (identity.testType||'CUSTOM')===type?'selected':'' %>><%= type.replaceAll('_',' ') %></option><% }) %></select></label>
            <label class="font-semibold text-slate-700">Exam pattern<select name="testPattern" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 font-normal"><% patterns.forEach(pattern => { %><option value="<%= pattern._id %>" <%= (identity.testPattern||String(defaultPattern?._id))===String(pattern._id)?'selected':'' %>><%= pattern.name %></option><% }) %></select></label>
            <label class="font-semibold text-slate-700">Ranking rule<select name="rankingSchema" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 font-normal"><% rankingSchemas.forEach(schema => { %><option value="<%= schema._id %>" <%= (identity.rankingSchema||String(defaultRanking?._id))===String(schema._id)?'selected':'' %>><%= schema.name %></option><% }) %></select></label>
            <label class="font-semibold text-slate-700 md:col-span-2">Short description<textarea name="description" rows="3" maxlength="1000" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"><%= identity.description||'' %></textarea></label>
          </div>
        </section>
        <div class="flex gap-3"><a href="/admin/tests/create/parts" class="rounded-xl border border-slate-200 px-6 py-4 font-semibold text-slate-600">← Back</a><button class="flex-1 rounded-xl bg-navy-950 py-4 text-lg font-bold text-white">Next: Select Batch →</button></div>
      </form>
      <% } %>

      <% if (step==='audience') { const audience=wizard.audience||{}; %>
      <form method="POST" action="/admin/tests/create/audience" class="space-y-6">
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
          <span class="text-sm font-bold uppercase tracking-wider text-indigo-600">Step 3 of 5</span><h2 class="mt-1 text-2xl font-bold text-slate-950">Who will take this test?</h2><p class="mt-2 text-slate-500">Choose the batches only. Timing and exam controls come next.</p>
          <div class="mt-7 grid gap-3 md:grid-cols-2"><% groups.forEach(group => { %><label class="cursor-pointer rounded-2xl border border-slate-200 p-4 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50"><input type="checkbox" name="groupIds" value="<%= group._id %>" class="mr-3 h-5 w-5 rounded" <%= (audience.groupIds||[]).includes(String(group._id))?'checked':'' %>/><span class="font-bold text-slate-900"><%= group.name %></span><% if(group.course){ %><span class="ml-2 text-sm text-slate-400"><%= group.course %></span><% } %></label><% }) %></div>
          <% if (!groups.length) { %><div class="mt-6 rounded-xl bg-amber-50 p-5 text-amber-800">Create an active batch before scheduling this test.</div><% } %>
          <div class="mt-6 grid gap-4 md:grid-cols-2"><label class="font-semibold text-slate-700">Passing marks (optional)<input name="passingMarks" type="number" min="0" step="0.25" value="<%= audience.passingMarks ?? '' %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label><label class="font-semibold text-slate-700 md:col-span-2">Student instructions<textarea name="instructions" rows="4" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal" placeholder="Instructions shown before the test starts"><%= audience.instructions||'' %></textarea></label></div>
        </section>
        <div class="flex gap-3"><a href="/admin/tests/create/identity" class="rounded-xl border border-slate-200 px-6 py-4 font-semibold text-slate-600">← Back</a><button class="flex-1 rounded-xl bg-navy-950 py-4 text-lg font-bold text-white" <%= groups.length?'':'disabled' %>>Next: Delivery Setup →</button></div>
      </form>
      <% } %>

      <% if (step==='delivery') { const delivery=wizard.delivery||{}; %>
      <form method="POST" action="/admin/tests/create/delivery" class="space-y-6">
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
          <span class="text-sm font-bold uppercase tracking-wider text-indigo-600">Step 4 of 5</span><h2 class="mt-1 text-2xl font-bold text-slate-950">When and how should it run?</h2><p class="mt-2 text-slate-500">Set the delivery rules once; questions and marks remain untouched.</p>
          <div class="mt-7 space-y-7">
            <div><h3 class="mb-3 text-lg font-bold text-slate-900">Timing</h3><div class="grid gap-4 md:grid-cols-3"><label class="font-semibold text-slate-700">Mode<select id="timingMode" name="timingMode" onchange="toggleTiming()" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 font-normal"><option value="PERSONAL_DURATION" <%= (delivery.timingMode||'PERSONAL_DURATION')==='PERSONAL_DURATION'?'selected':'' %>>Personal duration</option><option value="FIXED_WINDOW" <%= delivery.timingMode==='FIXED_WINDOW'?'selected':'' %>>Fixed window</option><option value="UNTIMED" <%= delivery.timingMode==='UNTIMED'?'selected':'' %>>Untimed</option></select></label><label id="durationWrap" class="font-semibold text-slate-700">Duration (minutes)<input name="duration" type="number" min="1" max="1440" value="<%= delivery.duration ?? 180 %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label><label class="font-semibold text-slate-700">Opens at (optional)<input name="startTime" type="datetime-local" value="<%= delivery.startTime ? delivery.startTime.slice(0,16) : '' %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label><label class="font-semibold text-slate-700">Closes at <span id="endRequired" class="text-slate-400">(optional)</span><input name="endTime" type="datetime-local" value="<%= delivery.endTime ? delivery.endTime.slice(0,16) : '' %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label></div></div>
            <div class="border-t border-slate-100 pt-6"><h3 class="mb-3 text-lg font-bold text-slate-900">Question delivery</h3><div class="grid gap-3 md:grid-cols-2"><label class="rounded-xl border border-slate-200 p-4 font-semibold"><input type="checkbox" name="shuffleQuestions" class="mr-2" <%= delivery.shuffleQuestions!==false?'checked':'' %>/> Shuffle question order</label><label class="rounded-xl border border-slate-200 p-4 font-semibold"><input type="checkbox" name="shuffleOptions" class="mr-2" <%= delivery.shuffleOptions?'checked':'' %>/> Shuffle answer options</label><label class="rounded-xl border border-slate-200 p-4 font-semibold"><input type="checkbox" name="blockCopyPaste" class="mr-2" <%= delivery.blockCopyPaste!==false?'checked':'' %>/> Block copy / paste</label><label class="rounded-xl border border-slate-200 p-4 font-semibold"><input type="checkbox" name="requireFullscreen" class="mr-2" <%= delivery.requireFullscreen?'checked':'' %>/> Require fullscreen</label></div></div>
            <div class="border-t border-slate-100 pt-6"><h3 class="mb-3 text-lg font-bold text-slate-900">Access &amp; anti-cheat</h3><div class="grid gap-4 md:grid-cols-2"><label class="rounded-xl border border-slate-200 p-4 font-semibold"><input id="accessEnabled" type="checkbox" name="testAccessEnabled" class="mr-2" onchange="toggleAccess()" <%= delivery.testAccessEnabled?'checked':'' %>/> Require test PIN</label><label id="accessPasswordWrap" class="font-semibold text-slate-700">Test PIN<input name="testAccessPassword" minlength="4" maxlength="64" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal" placeholder="4–64 characters"/></label><label class="rounded-xl border border-slate-200 p-4 font-semibold"><input type="checkbox" name="autoSubmitOnViolation" class="mr-2" <%= delivery.autoSubmitOnViolation?'checked':'' %>/> Auto-submit after violations</label><label class="font-semibold text-slate-700">Maximum tab switches<input name="maxTabSwitches" type="number" min="1" value="<%= delivery.maxTabSwitches||3 %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label><label class="font-semibold text-slate-700">Maximum focus losses<input name="maxFocusLosses" type="number" min="1" value="<%= delivery.maxFocusLosses||5 %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label></div></div>
            <div class="border-t border-slate-100 pt-6"><h3 class="mb-3 text-lg font-bold text-slate-900">Result release</h3><div class="grid gap-4 md:grid-cols-2"><label class="font-semibold text-slate-700">Release rule<select id="resultReleaseMode" name="resultReleaseMode" onchange="toggleRelease()" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 font-normal"><option value="IMMEDIATE" <%= (delivery.resultReleaseMode||'IMMEDIATE')==='IMMEDIATE'?'selected':'' %>>Immediately after submission</option><option value="AFTER_TEST_END" <%= delivery.resultReleaseMode==='AFTER_TEST_END'?'selected':'' %>>After test closes</option><option value="SCHEDULED" <%= delivery.resultReleaseMode==='SCHEDULED'?'selected':'' %>>Scheduled date &amp; time</option><option value="MANUAL" <%= delivery.resultReleaseMode==='MANUAL'?'selected':'' %>>Manual release</option></select></label><label id="releaseAtWrap" class="font-semibold text-slate-700">Release at<input name="resultReleaseAt" type="datetime-local" value="<%= delivery.resultReleaseAt ? delivery.resultReleaseAt.slice(0,16) : '' %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label></div></div>
          </div>
        </section>
        <div class="flex gap-3"><a href="/admin/tests/create/audience" class="rounded-xl border border-slate-200 px-6 py-4 font-semibold text-slate-600">← Back</a><button class="flex-1 rounded-xl bg-navy-950 py-4 text-lg font-bold text-white">Next: Review Test →</button></div>
      </form>
      <script>
      function toggleTiming(){const fixed=document.getElementById('timingMode').value==='FIXED_WINDOW',untimed=document.getElementById('timingMode').value==='UNTIMED';document.getElementById('durationWrap').classList.toggle('hidden',fixed||untimed);document.getElementById('endRequired').textContent=fixed?'(required)':'(optional)';}
      function toggleAccess(){document.getElementById('accessPasswordWrap').classList.toggle('hidden',!document.getElementById('accessEnabled').checked);}
      function toggleRelease(){document.getElementById('releaseAtWrap').classList.toggle('hidden',document.getElementById('resultReleaseMode').value!=='SCHEDULED');}
      toggleTiming();toggleAccess();toggleRelease();
      </script>
      <% } %>

      <% if (step==='review') { %>
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
        <span class="text-sm font-bold uppercase tracking-wider text-emerald-600">Step 5 of 5</span><h2 class="mt-1 text-2xl font-bold text-slate-950">Review before upload</h2><p class="mt-2 text-slate-500">Everything below will become one final ranked test.</p>
        <div class="mt-7 grid gap-4 md:grid-cols-4"><div class="rounded-xl bg-slate-50 p-4"><span class="text-sm text-slate-500">Questions</span><strong class="mt-1 block text-2xl text-slate-950"><%= combined.configs.length %></strong></div><div class="rounded-xl bg-slate-50 p-4"><span class="text-sm text-slate-500">Total marks</span><strong class="mt-1 block text-2xl text-slate-950"><%= totalMarks %></strong></div><div class="rounded-xl bg-slate-50 p-4"><span class="text-sm text-slate-500">Subject parts</span><strong class="mt-1 block text-2xl text-slate-950"><%= parts.length %></strong></div><div class="rounded-xl bg-slate-50 p-4"><span class="text-sm text-slate-500">Batches</span><strong class="mt-1 block text-2xl text-slate-950"><%= groups.length %></strong></div></div>
        <dl class="mt-6 divide-y divide-slate-100 rounded-2xl border border-slate-200"><div class="grid gap-2 p-4 sm:grid-cols-[180px_1fr]"><dt class="font-semibold text-slate-500">Test name</dt><dd class="font-bold text-slate-950"><%= wizard.identity.title %></dd></div><div class="grid gap-2 p-4 sm:grid-cols-[180px_1fr]"><dt class="font-semibold text-slate-500">Selected parts</dt><dd><% parts.forEach(part => { %><span class="mb-1 mr-1 inline-block rounded-lg bg-indigo-50 px-3 py-1.5 font-semibold text-indigo-700"><%= part.subject %>: <%= part.name %> (<%= part.questionConfigs.length %>Q)</span><% }) %></dd></div><div class="grid gap-2 p-4 sm:grid-cols-[180px_1fr]"><dt class="font-semibold text-slate-500">Batches</dt><dd class="font-semibold text-slate-800"><%= groups.map(group=>group.name).join(', ') %></dd></div><div class="grid gap-2 p-4 sm:grid-cols-[180px_1fr]"><dt class="font-semibold text-slate-500">Timing</dt><dd class="font-semibold text-slate-800"><%= wizard.delivery.timingMode.replaceAll('_',' ') %><%= wizard.delivery.duration ? ` · ${wizard.delivery.duration} minutes` : '' %></dd></div><div class="grid gap-2 p-4 sm:grid-cols-[180px_1fr]"><dt class="font-semibold text-slate-500">Result release</dt><dd class="font-semibold text-slate-800"><%= wizard.delivery.resultReleaseMode.replaceAll('_',' ') %></dd></div></dl>
        <% if (combined.duplicates.length) { %><div class="mt-5 rounded-xl bg-rose-50 p-4 font-semibold text-rose-700">Duplicate questions detected. Go back and correct the parts.</div><% } %>
      </section>
      <form method="POST" action="/admin/tests/create/finish" class="mt-6 grid gap-3 md:grid-cols-[auto_1fr_1fr]"><a href="/admin/tests/create/delivery" class="rounded-xl border border-slate-200 px-6 py-4 text-center font-semibold text-slate-600">← Back</a><button name="finalAction" value="draft" class="rounded-xl border border-navy-950 px-6 py-4 text-lg font-bold text-navy-950">Save as Draft</button><button name="finalAction" value="publish" class="rounded-xl bg-emerald-600 px-6 py-4 text-lg font-bold text-white" onclick="return confirm('Publish this test now and notify students?')">Upload &amp; Publish Test</button></form>
      <% } %>
    </div>
  </main>
</div>
</body></html>

<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto bg-slate-50/70">
    <header class="sticky top-0 z-10 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4 flex items-center gap-4">
      <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
      <div class="flex-1">
        <h1 class="text-lg font-bold text-slate-900">Syllabus Manager</h1>
        <p class="text-xs text-slate-400">Course → Subject → Unit → Subtopic hierarchy</p>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="openModal('importSyllabusModal')" class="hidden sm:flex items-center gap-2 border border-indigo-200 bg-indigo-50 text-indigo-700 px-4 py-2.5 rounded-xl text-sm font-semibold hover:bg-indigo-100 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5.002 5.002 0 0115.9 6L16 6a5 5 0 011 9.9M12 12v9m0-9l-3 3m3-3l3 3"/></svg>
          Upload PDF
        </button>
        <button onclick="openModal('addTopicModal')" class="flex items-center gap-1.5 bg-navy-950 text-white px-4 py-2.5 rounded-xl text-sm font-semibold hover:bg-navy-900 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Add Unit
        </button>
      </div>
    </header>

    <div class="p-5 lg:p-8 max-w-[1500px] mx-auto">
      <%- include('../partials/flash') %>

      <section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-indigo-950 to-indigo-700 text-white p-6 lg:p-8 mb-6 shadow-xl shadow-indigo-950/10">
        <div class="absolute -right-20 -top-24 w-72 h-72 rounded-full bg-white/10"></div>
        <div class="absolute right-36 -bottom-28 w-52 h-52 rounded-full bg-indigo-300/10"></div>
        <div class="relative flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
          <div class="max-w-3xl">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.18em] bg-white/10 border border-white/15 rounded-full px-3 py-1.5 mb-4">Structured syllabus library</span>
            <h2 class="text-2xl lg:text-3xl font-bold tracking-tight mb-3">Manage CET, JEE and NEET syllabus in one place.</h2>
            <p class="text-sm lg:text-base text-indigo-100 leading-relaxed">Add units manually or scan a complete syllabus PDF. This hierarchy becomes available automatically while selecting questions for a new test.</p>
          </div>
          <div class="flex flex-wrap gap-2 shrink-0">
            <button onclick="openModal('importSyllabusModal')" class="sm:hidden bg-white text-indigo-800 px-4 py-2.5 rounded-xl text-sm font-bold">Upload PDF</button>
            <span class="inline-flex items-center gap-2 bg-emerald-400/15 border border-emerald-300/20 text-emerald-100 rounded-xl px-3.5 py-2 text-xs font-semibold">
              <span class="w-2 h-2 rounded-full <%= aiEnabled ? 'bg-emerald-300' : 'bg-amber-300' %>"></span>
              <%= aiEnabled ? 'PDF scanner ready' : 'PDF scanner needs an AI key' %>
            </span>
          </div>
        </div>
      </section>

      <section class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <% const courseColours = { JEE:'blue', CET:'violet', NEET:'emerald' }; %>
        <% COURSES.forEach(course => { const stat = courseStats[course] || {units:0,subtopics:0}; const colour = courseColours[course]; %>
        <a href="/admin/topics?course=<%= course %>" class="group bg-white rounded-2xl border border-slate-200 p-5 hover:border-<%= colour %>-300 hover:shadow-lg hover:-translate-y-0.5 transition-all">
          <div class="flex items-center justify-between mb-4">
            <div class="w-10 h-10 rounded-xl bg-<%= colour %>-50 text-<%= colour %>-700 flex items-center justify-center font-black text-sm"><%= course %></div>
            <svg class="w-4 h-4 text-slate-300 group-hover:text-<%= colour %>-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </div>
          <div class="flex items-end gap-6">
            <div><p class="text-2xl font-bold text-slate-900"><%= stat.units %></p><p class="text-xs text-slate-400 font-medium">Units</p></div>
            <div><p class="text-2xl font-bold text-slate-900"><%= stat.subtopics %></p><p class="text-xs text-slate-400 font-medium">Subtopics</p></div>
          </div>
        </a>
        <% }) %>
      </section>

      <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100">
          <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-4">
            <div>
              <h3 class="font-bold text-slate-900">Syllabus Units <span class="text-slate-400 font-semibold">(<%= topics.length %>)</span></h3>
              <p class="text-xs text-slate-400 mt-1"><%= filterCourse || filterSubject ? [filterCourse, filterSubject].filter(Boolean).join(' / ') : 'All configured courses and subjects' %></p>
            </div>
            <div class="flex flex-col sm:flex-row gap-2.5">
              <div class="relative">
                <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m2.35-5.65a8 8 0 11-16 0 8 8 0 0116 0z"/></svg>
                <input id="unitSearch" oninput="filterUnits()" type="search" placeholder="Search unit or subtopic" class="w-full sm:w-60 border border-slate-200 rounded-xl pl-9 pr-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-400">
              </div>
              <form method="GET" action="/admin/topics" class="flex gap-2.5">
                <select name="course" onchange="this.form.submit()" class="border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm bg-white min-w-[110px] focus:outline-none focus:ring-2 focus:ring-indigo-500/20">
                  <option value="">All Courses</option>
                  <% COURSES.forEach(c => { %><option value="<%= c %>" <%= filterCourse===c?'selected':'' %>><%= c %></option><% }) %>
                </select>
                <select name="subject" onchange="this.form.submit()" class="border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm bg-white min-w-[145px] focus:outline-none focus:ring-2 focus:ring-indigo-500/20">
                  <option value="">All Subjects</option>
                  <% SUBJECTS.forEach(s => { %><option value="<%= s %>" <%= filterSubject===s?'selected':'' %>><%= s %></option><% }) %>
                </select>
                <% if (filterCourse || filterSubject) { %><a href="/admin/topics" class="border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm text-slate-500 hover:bg-slate-50">Clear</a><% } %>
              </form>
            </div>
          </div>
        </div>

        <% if (topics.length === 0) { %>
        <div class="py-20 px-6 text-center">
          <div class="w-14 h-14 bg-indigo-50 text-indigo-500 rounded-2xl flex items-center justify-center mx-auto mb-4"><svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg></div>
          <h4 class="font-bold text-slate-800">No syllabus units configured</h4>
          <p class="text-sm text-slate-400 mt-1 mb-4">Add a unit manually or upload the official syllabus PDF.</p>
          <button onclick="openModal('addTopicModal')" class="bg-navy-950 text-white rounded-xl px-4 py-2.5 text-sm font-semibold">Add first unit</button>
        </div>
        <% } else { %>
        <div id="unitList" class="divide-y divide-slate-100">
          <% topics.forEach(topic => { %>
          <article class="unit-row p-5 hover:bg-slate-50/80 transition-colors" data-search="<%= [topic.course, topic.subject, topic.name, ...(topic.subtopics||[])].join(' ').toLowerCase() %>">
            <div class="flex items-start justify-between gap-5">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="text-[10px] font-bold tracking-wide bg-indigo-50 text-indigo-700 border border-indigo-100 px-2.5 py-1 rounded-full"><%= topic.course %></span>
                  <span class="text-[10px] font-bold tracking-wide bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full"><%= topic.subject %></span>
                  <span class="text-[10px] font-semibold text-slate-400"><%= (topic.subtopics||[]).length %> subtopic<%= (topic.subtopics||[]).length===1?'':'s' %></span>
                </div>
                <h4 class="font-bold text-slate-900"><%= topic.name %></h4>
                <% if (topic.subtopics && topic.subtopics.length) { %>
                <div class="flex flex-wrap gap-1.5 mt-3">
                  <% topic.subtopics.forEach(sub => { %><span class="text-[11px] bg-amber-50 text-amber-800 border border-amber-100 px-2.5 py-1 rounded-lg"><%= sub %></span><% }) %>
                </div>
                <% } else { %><p class="text-xs text-slate-400 mt-2">No subtopics added yet.</p><% } %>
              </div>
              <div class="flex items-center gap-1 shrink-0">
                <button type="button" onclick="openEdit(this)" data-id="<%= topic.id %>" data-name="<%= topic.name %>" data-subtopics="<%= (topic.subtopics||[]).join('\n') %>" class="w-9 h-9 rounded-lg text-slate-400 hover:text-indigo-700 hover:bg-indigo-50 flex items-center justify-center" title="Edit unit"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7m-1.5-10.5a2.121 2.121 0 013 3L12 13l-4 1 1-4 7.5-7.5z"/></svg></button>
                <form action="/admin/topics/<%= topic.id %>/delete" method="POST" onsubmit="return confirm('Delete this syllabus unit?')"><button type="submit" class="w-9 h-9 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center" title="Delete unit"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button></form>
              </div>
            </div>
          </article>
          <% }) %>
        </div>
        <div id="noSearchResults" class="hidden py-14 text-center text-sm text-slate-400">No unit or subtopic matches your search.</div>
        <% } %>
      </section>
    </div>
  </main>
</div>

<div id="addTopicModal" class="hidden fixed inset-0 bg-slate-950/55 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-0 sm:p-4" onclick="closeFromBackdrop(event, 'addTopicModal')">
  <div class="bg-white rounded-t-3xl sm:rounded-2xl shadow-2xl w-full sm:max-w-xl overflow-hidden">
    <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100"><div><h3 class="font-bold text-slate-900">Add Syllabus Unit</h3><p class="text-xs text-slate-400 mt-0.5">Create or merge one unit and its subtopics.</p></div><button onclick="closeModal('addTopicModal')" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200">×</button></div>
    <form action="/admin/topics" method="POST" class="p-6 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div><label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Course *</label><select name="course" required id="topicCourse" onchange="loadSubjectsForCourse(this.value, 'topicSubject', false)" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm bg-white"><option value="">Select course</option><% COURSES.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %></select></div>
        <div><label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Subject *</label><select name="subject" required id="topicSubject" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm bg-white"><option value="">Select course first</option></select></div>
      </div>
      <div><label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Unit / Chapter Name *</label><input type="text" name="name" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-400 outline-none" placeholder="e.g. Kinematics"></div>
      <div><label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Subtopics <span class="text-slate-400 normal-case font-medium">(one per line)</span></label><textarea name="subtopics" rows="6" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-400 outline-none" placeholder="Uniform Motion&#10;Projectile Motion&#10;Relative Velocity"></textarea></div>
      <p class="text-[11px] text-slate-400 bg-slate-50 rounded-xl p-3">If this course, subject and unit already exist, new subtopics are merged without creating duplicates.</p>
      <div class="flex gap-3 pt-1"><button type="submit" class="flex-1 bg-navy-950 text-white font-semibold py-3 rounded-xl hover:bg-navy-900">Save Unit</button><button type="button" onclick="closeModal('addTopicModal')" class="flex-1 border border-slate-200 text-slate-700 font-semibold py-3 rounded-xl hover:bg-slate-50">Cancel</button></div>
    </form>
  </div>
</div>

<div id="importSyllabusModal" class="hidden fixed inset-0 bg-slate-950/55 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-0 sm:p-4" onclick="closeFromBackdrop(event, 'importSyllabusModal')">
  <div class="bg-white rounded-t-3xl sm:rounded-2xl shadow-2xl w-full sm:max-w-2xl overflow-hidden">
    <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100"><div><h3 class="font-bold text-slate-900">Import Syllabus PDF</h3><p class="text-xs text-slate-400 mt-0.5">AI extracts subjects, units and subtopics from typed or scanned PDFs.</p></div><button onclick="closeModal('importSyllabusModal')" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200">×</button></div>
    <form id="syllabusImportForm" action="/admin/topics/import-pdf" method="POST" enctype="multipart/form-data" class="p-6 space-y-5" onsubmit="startSyllabusImport()">
      <div class="grid sm:grid-cols-2 gap-4">
        <div><label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Course *</label><select name="course" required id="importCourse" onchange="loadSubjectsForCourse(this.value, 'importSubject', true)" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm bg-white"><option value="">Select course</option><% COURSES.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %></select></div>
        <div><label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Subject <span class="normal-case text-slate-400">(optional)</span></label><select name="subject" id="importSubject" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm bg-white"><option value="">Select course first</option></select><p class="text-[10px] text-slate-400 mt-1.5">Leave blank when one PDF contains multiple subjects.</p></div>
      </div>
      <label class="block cursor-pointer border-2 border-dashed border-indigo-200 bg-indigo-50/50 rounded-2xl p-7 text-center hover:bg-indigo-50 hover:border-indigo-300 transition-colors">
        <input id="syllabusPdf" type="file" name="syllabusPdf" accept="application/pdf,.pdf" required class="hidden" onchange="showSyllabusFile(this)">
        <span class="w-12 h-12 rounded-2xl bg-white shadow-sm text-indigo-600 flex items-center justify-center mx-auto mb-3"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5.002 5.002 0 0115.9 6L16 6a5 5 0 011 9.9M12 12v9m0-9l-3 3m3-3l3 3"/></svg></span>
        <span id="syllabusFileName" class="block font-bold text-slate-800 text-sm">Choose official syllabus PDF</span>
        <span id="syllabusFileMeta" class="block text-xs text-slate-400 mt-1">PDF only · Maximum 20 MB</span>
      </label>
      <div class="rounded-xl border <%= aiEnabled ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-amber-200 bg-amber-50 text-amber-800' %> p-3 text-xs leading-relaxed"><%= aiEnabled ? 'Scanner is configured. Imported units are merged safely with existing syllabus data.' : 'PDF scanning needs GEMINI_API_KEY or OPENAI_API_KEY. Manual unit entry remains available.' %></div>
      <div class="flex gap-3"><button id="importSubmitButton" type="submit" <%= aiEnabled ? '' : 'disabled' %> class="flex-1 bg-indigo-600 text-white font-semibold py-3 rounded-xl hover:bg-indigo-700 disabled:opacity-40 disabled:cursor-not-allowed"><span id="importButtonText">Scan &amp; Import Syllabus</span></button><button type="button" onclick="closeModal('importSyllabusModal')" class="flex-1 border border-slate-200 text-slate-700 font-semibold py-3 rounded-xl hover:bg-slate-50">Cancel</button></div>
    </form>
  </div>
</div>

<div id="editTopicModal" class="hidden fixed inset-0 bg-slate-950/55 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-0 sm:p-4" onclick="closeFromBackdrop(event, 'editTopicModal')">
  <div class="bg-white rounded-t-3xl sm:rounded-2xl shadow-2xl w-full sm:max-w-xl overflow-hidden">
    <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100"><div><h3 class="font-bold text-slate-900">Edit Syllabus Unit</h3><p class="text-xs text-slate-400 mt-0.5">Review the unit name and subtopic list.</p></div><button onclick="closeModal('editTopicModal')" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200">×</button></div>
    <form id="editTopicForm" action="" method="POST" class="p-6 space-y-4">
      <div><label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Unit / Chapter Name *</label><input type="text" name="name" id="editTopicName" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"></div>
      <div><label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Subtopics <span class="text-slate-400 normal-case font-medium">(one per line)</span></label><textarea name="subtopics" id="editTopicSubtopics" rows="7" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm"></textarea></div>
      <div class="flex gap-3 pt-1"><button type="submit" class="flex-1 bg-navy-950 text-white font-semibold py-3 rounded-xl hover:bg-navy-900">Save Changes</button><button type="button" onclick="closeModal('editTopicModal')" class="flex-1 border border-slate-200 text-slate-700 font-semibold py-3 rounded-xl hover:bg-slate-50">Cancel</button></div>
    </form>
  </div>
</div>

<script>
const subjectsByCourse = <%- JSON.stringify(SUBJECTS_BY_COURSE) %>;

function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
function closeFromBackdrop(event, id) { if (event.target.id === id) closeModal(id); }

function openEdit(button) {
  document.getElementById('editTopicName').value = button.dataset.name;
  document.getElementById('editTopicSubtopics').value = button.dataset.subtopics;
  document.getElementById('editTopicForm').action = '/admin/topics/' + button.dataset.id;
  openModal('editTopicModal');
}

function loadSubjectsForCourse(course, selectId, allowAutoDetect) {
  const select = document.getElementById(selectId);
  const firstOption = allowAutoDetect ? 'Auto-detect subjects' : 'Select subject';
  if (!course) {
    select.innerHTML = '<option value="">Select course first</option>';
    return;
  }
  select.innerHTML = `<option value="">${firstOption}</option>` + (subjectsByCourse[course] || []).map(subject => `<option value="${subject}">${subject}</option>`).join('');
}

function filterUnits() {
  const query = document.getElementById('unitSearch').value.trim().toLowerCase();
  const rows = Array.from(document.querySelectorAll('.unit-row'));
  let visible = 0;
  rows.forEach(row => {
    const show = !query || row.dataset.search.includes(query);
    row.style.display = show ? '' : 'none';
    if (show) visible += 1;
  });
  const empty = document.getElementById('noSearchResults');
  if (empty) empty.classList.toggle('hidden', visible > 0);
}

function showSyllabusFile(input) {
  const file = input.files[0];
  if (!file) return;
  document.getElementById('syllabusFileName').textContent = file.name;
  document.getElementById('syllabusFileMeta').textContent = `${(file.size / 1024 / 1024).toFixed(2)} MB · Ready to scan`;
}

function startSyllabusImport() {
  const button = document.getElementById('importSubmitButton');
  button.disabled = true;
  document.getElementById('importButtonText').textContent = 'Scanning complete PDF…';
}
</script>
</body>
</html>

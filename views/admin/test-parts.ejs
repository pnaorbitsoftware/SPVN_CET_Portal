<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto">
    <header class="sticky top-0 z-10 flex items-center gap-4 border-b border-slate-200 bg-white/90 px-5 py-4 backdrop-blur lg:px-8">
      <button onclick="openSidebar()" class="text-slate-500 lg:hidden">☰</button>
      <div class="flex-1">
        <h1 class="text-xl font-bold text-slate-950">Subject Test Parts</h1>
        <p class="text-sm text-slate-500">Build named subject papers now; combine and schedule them later.</p>
      </div>
      <a href="/admin/test-parts/create" class="rounded-xl bg-navy-950 px-4 py-2.5 font-semibold text-white hover:bg-navy-800">+ New Test Part</a>
    </header>

    <div class="p-5 lg:p-8">
      <%- include('../partials/flash') %>
      <section class="mb-6 rounded-2xl border border-indigo-100 bg-gradient-to-r from-indigo-50 to-white p-5">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div><h2 class="font-bold text-slate-950">Teacher workspace</h2><p class="mt-1 text-sm text-slate-600">No exam, batch, timing, or shuffle choices here—only subject hierarchy, questions, answers, and marks.</p></div>
          <a href="/admin/tests/create" class="rounded-xl border border-indigo-200 bg-white px-4 py-2.5 font-semibold text-indigo-700 hover:bg-indigo-50">Combine Ready Parts →</a>
        </div>
      </section>

      <form method="GET" class="mb-6 flex flex-wrap gap-3 rounded-2xl border border-slate-200 bg-white p-4">
        <select name="subject" onchange="this.form.submit()" class="rounded-xl border border-slate-200 px-4 py-2.5">
          <option value="">All subjects</option>
          <% SUBJECTS.forEach(subject => { %><option value="<%= subject %>" <%= filters.subject===subject?'selected':'' %>><%= subject %></option><% }) %>
        </select>
        <select name="status" onchange="this.form.submit()" class="rounded-xl border border-slate-200 px-4 py-2.5">
          <option value="">All statuses</option>
          <% ['draft','ready','archived'].forEach(status => { %><option value="<%= status %>" <%= filters.status===status?'selected':'' %>><%= status.charAt(0).toUpperCase()+status.slice(1) %></option><% }) %>
        </select>
        <% if (filters.subject || filters.status) { %><a href="/admin/test-parts" class="rounded-xl border border-slate-200 px-4 py-2.5 text-slate-600">Clear</a><% } %>
      </form>

      <% if (!parts.length) { %>
      <div class="rounded-3xl border border-dashed border-slate-300 bg-white py-20 text-center">
        <div class="text-5xl">🧩</div><h2 class="mt-4 text-xl font-bold text-slate-900">No subject test parts yet</h2>
        <p class="mt-2 text-slate-500">Create a named Physics, Chemistry, Mathematics, or Biology part.</p>
        <a href="/admin/test-parts/create" class="mt-5 inline-block rounded-xl bg-navy-950 px-5 py-3 font-semibold text-white">Create first part</a>
      </div>
      <% } else { %>
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        <% const subjectStyle={Physics:'bg-blue-100 text-blue-700',Chemistry:'bg-violet-100 text-violet-700',Mathematics:'bg-amber-100 text-amber-700',Biology:'bg-emerald-100 text-emerald-700'}; %>
        <% parts.forEach(part => { %>
        <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-card">
          <div class="flex items-start justify-between gap-3">
            <span class="rounded-full px-3 py-1 text-sm font-bold <%= subjectStyle[part.subject] %>"><%= part.subject %></span>
            <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= part.status==='ready'?'bg-emerald-100 text-emerald-700':part.status==='archived'?'bg-slate-100 text-slate-500':'bg-amber-100 text-amber-700' %>"><%= part.status.toUpperCase() %></span>
          </div>
          <h2 class="mt-4 text-lg font-bold text-slate-950"><%= part.name %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= [part.topic,part.subtopic].filter(Boolean).join(' › ') || 'Full / mixed hierarchy' %></p>
          <div class="mt-4 grid grid-cols-3 gap-2 rounded-xl bg-slate-50 p-3 text-center">
            <div><strong class="block text-lg text-slate-950"><%= part.questionConfigs.length %></strong><span class="text-xs text-slate-500">Questions</span></div>
            <div><strong class="block text-lg text-slate-950"><%= Number(part.defaultPositiveMarks) %></strong><span class="text-xs text-slate-500">Default +</span></div>
            <div><strong class="block text-lg text-slate-950"><%= Number(part.defaultNegativeMarks) %></strong><span class="text-xs text-slate-500">Default −</span></div>
          </div>
          <p class="mt-3 text-xs text-slate-400">Updated <%= new Date(part.updatedAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %><%= part.createdBy?.name ? ` · ${part.createdBy.name}` : '' %></p>
          <div class="mt-5 flex gap-2">
            <a href="/admin/test-parts/<%= part._id %>/edit" class="flex-1 rounded-xl bg-navy-950 py-2.5 text-center font-semibold text-white">Open Builder</a>
            <% if (part.status!=='archived') { %><form method="POST" action="/admin/test-parts/<%= part._id %>/archive" onsubmit="return confirm('Archive this test part? Existing tests will stay unchanged.')"><button class="rounded-xl border border-slate-200 px-3 py-2.5 text-slate-500">Archive</button></form><% } %>
          </div>
        </article>
        <% }) %>
      </div>
      <% } %>
    </div>
  </main>
</div>
</body></html>

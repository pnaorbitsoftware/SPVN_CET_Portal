<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto">
    <header class="sticky top-0 z-10 flex items-center gap-4 border-b border-slate-200 bg-white/90 px-5 py-4 backdrop-blur lg:px-8">
      <button onclick="openSidebar()" class="text-slate-500 lg:hidden">☰</button>
      <div class="flex-1">
        <h1 class="text-lg font-bold text-slate-900">Question Paper Library</h1>
        <p class="text-xs text-slate-400"><%= total %> reusable paper<%= total===1?'':'s' %> · independent from Question Bank</p>
      </div>
      <a href="/admin/question-papers/create" class="rounded-lg bg-navy-950 px-3 py-2 text-xs font-bold text-white hover:bg-navy-800">+ Create Paper</a>
    </header>

    <div class="p-5 lg:p-8">
      <%- include('../partials/flash') %>
      <form method="GET" class="mb-6 grid grid-cols-2 gap-2 rounded-2xl border border-slate-200 bg-white p-4 md:grid-cols-6">
        <input name="search" value="<%= filters.search || '' %>" placeholder="Search title, code, topic…" class="col-span-2 rounded-lg border border-slate-200 px-3 py-2 text-sm md:col-span-2"/>
        <select name="course" class="rounded-lg border border-slate-200 px-3 py-2 text-sm"><option value="">All courses</option><% COURSES.forEach(c => { %><option value="<%= c %>" <%= filters.course===c?'selected':'' %>><%= c %></option><% }) %></select>
        <select name="subject" class="rounded-lg border border-slate-200 px-3 py-2 text-sm"><option value="">All subjects</option><% SUBJECTS.forEach(s => { %><option value="<%= s %>" <%= filters.subject===s?'selected':'' %>><%= s %></option><% }) %></select>
        <select name="status" class="rounded-lg border border-slate-200 px-3 py-2 text-sm"><option value="">All statuses</option><% ['draft','ready','archived'].forEach(s => { %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= s %></option><% }) %></select>
        <select name="tag" class="rounded-lg border border-slate-200 px-3 py-2 text-sm"><option value="">All tags</option><% tags.forEach(tag => { %><option value="<%= tag %>" <%= filters.tag===tag?'selected':'' %>><%= tag %></option><% }) %></select>
        <div class="col-span-2 flex gap-2 md:col-span-6"><button class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-bold text-white">Apply Filters</button><a href="/admin/question-papers" class="rounded-lg border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-600">Clear</a></div>
      </form>

      <% if (!papers.length) { %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white py-20 text-center">
        <p class="font-semibold text-slate-500">No question papers match these filters.</p>
        <a href="/admin/question-papers/create" class="mt-3 inline-block text-sm font-semibold text-indigo-600">Create a reusable paper →</a>
      </div>
      <% } else { %>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
        <% papers.forEach(paper => { const d=paper.difficultyDistribution||{}; %>
        <article class="flex flex-col rounded-2xl border border-slate-100 bg-white p-5 shadow-card">
          <div class="flex items-start justify-between gap-3">
            <div><p class="text-[10px] font-bold uppercase tracking-widest text-indigo-500"><%= paper.code %></p><h2 class="mt-1 font-bold text-slate-900"><%= paper.title %></h2></div>
            <span class="rounded-full px-2.5 py-1 text-[10px] font-bold <%= paper.status==='ready'?'bg-emerald-100 text-emerald-700':paper.status==='archived'?'bg-slate-200 text-slate-600':'bg-amber-100 text-amber-700' %>"><%= paper.status %></span>
          </div>
          <% if (paper.description) { %><p class="mt-2 line-clamp-2 text-xs text-slate-500"><%= paper.description %></p><% } %>
          <div class="mt-4 grid grid-cols-3 gap-2 rounded-xl bg-slate-50 p-3 text-center">
            <div><p class="font-bold text-slate-900"><%= paper.totalQuestions %></p><p class="text-[10px] text-slate-400">Questions</p></div>
            <div><p class="font-bold text-slate-900"><%= paper.totalMarks %></p><p class="text-[10px] text-slate-400">Marks</p></div>
            <div><p class="font-bold text-slate-900"><%= d.Easy||0 %>/<%= d.Medium||0 %>/<%= d.Hard||0 %></p><p class="text-[10px] text-slate-400">E / M / H</p></div>
          </div>
          <div class="mt-3 flex flex-wrap gap-1"><% (paper.subjects||[]).forEach(subject => { %><span class="rounded bg-blue-50 px-2 py-0.5 text-[10px] font-semibold text-blue-700"><%= subject %></span><% }) %><% (paper.tags||[]).slice(0,5).forEach(tag => { %><span class="rounded bg-violet-50 px-2 py-0.5 text-[10px] text-violet-700">#<%= tag %></span><% }) %></div>
          <p class="mt-3 text-[10px] text-slate-400">Created <%= new Date(paper.createdAt).toLocaleDateString('en-IN') %><% if(paper.createdBy){ %> by <%= paper.createdBy.name %><% } %></p>
          <div class="mt-auto flex gap-2 pt-4">
            <a href="/admin/question-papers/<%= paper.id %>" class="flex-1 rounded-lg border border-slate-200 py-2 text-center text-xs font-bold text-slate-700">View</a>
            <a href="/admin/question-papers/<%= paper.id %>/edit" class="rounded-lg bg-indigo-50 px-3 py-2 text-xs font-bold text-indigo-700">Edit</a>
            <form action="/admin/question-papers/<%= paper.id %>/duplicate" method="POST"><button class="rounded-lg bg-slate-100 px-3 py-2 text-xs font-bold text-slate-600" title="Duplicate">Copy</button></form>
          </div>
        </article>
        <% }) %>
      </div>
      <% } %>

      <% if (totalPages > 1) { %>
      <nav class="mt-6 flex justify-center gap-2">
        <% for(let p=1;p<=totalPages;p+=1){ %><a href="?page=<%= p %>&search=<%= encodeURIComponent(filters.search||'') %>&course=<%= encodeURIComponent(filters.course||'') %>&subject=<%= encodeURIComponent(filters.subject||'') %>&status=<%= encodeURIComponent(filters.status||'') %>&tag=<%= encodeURIComponent(filters.tag||'') %>" class="flex h-9 w-9 items-center justify-center rounded-lg text-xs font-bold <%= p===page?'bg-navy-950 text-white':'border border-slate-200 bg-white text-slate-600' %>"><%= p %></a><% } %>
      </nav>
      <% } %>
    </div>
  </main>
</div>
</body></html>

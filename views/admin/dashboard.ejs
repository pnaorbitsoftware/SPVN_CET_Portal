<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto bg-slate-50">
    <header class="sticky top-0 z-20 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4 flex items-center justify-between gap-4">
      <div><h1 class="text-xl font-bold text-slate-900">Analytics Dashboard</h1><p class="text-xs text-slate-400 mt-0.5"><%= collegeName %> · live database metrics</p></div>
      <div class="flex gap-2"><a href="/admin/reports" class="border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50">Reports Center</a><a href="/admin/tests/create" class="bg-navy-950 text-white rounded-xl px-4 py-2.5 text-sm font-semibold">Create Test</a></div>
    </header>
    <div class="p-5 lg:p-8 space-y-6">
      <%- include('../partials/flash') %>
      <div class="grid grid-cols-2 md:grid-cols-4 xl:grid-cols-8 gap-3">
        <% [{label:'Total Students',value:analytics.stats.totalStudents},{label:'Active Students',value:analytics.stats.activeStudents},{label:'Total Tests',value:analytics.stats.totalTests},{label:'Published',value:analytics.stats.publishedTests},{label:'Attempts',value:analytics.stats.completedAttempts},{label:'Avg Score',value:analytics.stats.averagePercentage+'%'},{label:'Accuracy',value:analytics.stats.averageAccuracy+'%'},{label:'Participation',value:analytics.stats.overallParticipation+'%'}].forEach(card=>{ %>
        <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm"><p class="text-xl font-bold text-slate-900"><%= card.value %></p><p class="text-[11px] text-slate-400 font-semibold mt-1"><%= card.label %></p></div>
        <% }) %>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-gradient-to-br from-indigo-600 to-indigo-800 text-white rounded-2xl p-5"><p class="text-xs text-indigo-200 font-semibold">Top Performing Batch</p><p class="font-bold text-xl mt-2"><%= analytics.stats.topBatch %></p><p class="text-sm text-indigo-100 mt-1"><%= analytics.stats.topBatchPercentage %>% average</p></div>
        <div class="bg-gradient-to-br from-rose-600 to-rose-800 text-white rounded-2xl p-5"><p class="text-xs text-rose-200 font-semibold">Weakest Subject</p><p class="font-bold text-xl mt-2"><%= analytics.stats.weakestSubject %></p><p class="text-sm text-rose-100 mt-1"><%= analytics.stats.weakestSubjectPercentage %>% performance</p></div>
        <div class="bg-gradient-to-br from-emerald-600 to-emerald-800 text-white rounded-2xl p-5"><p class="text-xs text-emerald-200 font-semibold">Question Bank</p><p class="font-bold text-xl mt-2"><%= analytics.stats.questions %> questions</p><a href="/admin/questions" class="inline-block text-sm text-emerald-100 mt-1 hover:underline">Open question bank →</a></div>
      </div>
      <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
        <section class="bg-white border border-slate-200 rounded-2xl p-5"><div class="mb-4"><h2 class="font-bold text-slate-900">Score Trend</h2><p class="text-xs text-slate-400">Average percentage across recent attempted tests</p></div><div class="h-64"><canvas id="scoreTrendChart"></canvas></div></section>
        <section class="bg-white border border-slate-200 rounded-2xl p-5"><div class="mb-4"><h2 class="font-bold text-slate-900">Participation Trend</h2><p class="text-xs text-slate-400">Completed students versus scheduled students</p></div><div class="h-64"><canvas id="participationChart"></canvas></div></section>
        <section class="bg-white border border-slate-200 rounded-2xl p-5"><div class="mb-4"><h2 class="font-bold text-slate-900">Subject Performance</h2><p class="text-xs text-slate-400">Marks percentage from submitted attempts</p></div><div class="h-64"><canvas id="subjectChart"></canvas></div></section>
        <section class="bg-white border border-slate-200 rounded-2xl p-5"><div class="mb-4"><h2 class="font-bold text-slate-900">Batch Performance</h2><p class="text-xs text-slate-400">Average score and participation by batch</p></div><div class="h-64"><canvas id="batchChart"></canvas></div></section>
        <section class="bg-white border border-slate-200 rounded-2xl p-5"><div class="mb-4"><h2 class="font-bold text-slate-900">Score Distribution</h2><p class="text-xs text-slate-400">Number of completed attempts in each band</p></div><div class="h-56"><canvas id="scoreDistributionChart"></canvas></div></section>
        <section class="bg-white border border-slate-200 rounded-2xl p-5"><div class="mb-4"><h2 class="font-bold text-slate-900">Accuracy Distribution</h2><p class="text-xs text-slate-400">Correct answers among attempted questions</p></div><div class="h-56"><canvas id="accuracyDistributionChart"></canvas></div></section>
      </div>
      <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
        <section class="bg-white border border-slate-200 rounded-2xl overflow-hidden"><div class="px-5 py-4 border-b flex justify-between"><h2 class="font-bold text-slate-900">Top Performers</h2><a href="/admin/reports?reportType=student" class="text-xs font-semibold text-indigo-600">Full report</a></div><div class="divide-y"><% analytics.topPerformers.forEach((row,index)=>{ %><div class="px-5 py-3 flex items-center gap-3"><span class="w-8 text-sm font-bold text-slate-400">#<%= index+1 %></span><div class="flex-1"><p class="text-sm font-semibold"><%= row.student?.name %></p><p class="text-xs text-slate-400"><%= row.student?.rollNo %> · <%= row.testsCompleted %> tests · accuracy <%= row.averageAccuracy %>%</p></div><strong class="text-emerald-600"><%= row.averagePercentage %>%</strong></div><% }) %><% if(!analytics.topPerformers.length){ %><p class="p-10 text-center text-sm text-slate-400">No completed attempts.</p><% } %></div></section>
        <section class="bg-white border border-slate-200 rounded-2xl overflow-hidden"><div class="px-5 py-4 border-b flex justify-between"><h2 class="font-bold text-slate-900">Students Needing Attention</h2><span class="text-xs text-slate-400">Below 40% average</span></div><div class="divide-y"><% analytics.needsAttention.forEach(row=>{ %><div class="px-5 py-3 flex items-center gap-3"><div class="w-9 h-9 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center font-bold"><%= row.student?.name?.charAt(0)||'?' %></div><div class="flex-1"><p class="text-sm font-semibold"><%= row.student?.name %></p><p class="text-xs text-slate-400"><%= row.student?.rollNo %> · trend <%= row.trend>=0?'+':'' %><%= row.trend %> pts</p></div><strong class="text-rose-600"><%= row.averagePercentage %>%</strong></div><% }) %><% if(!analytics.needsAttention.length){ %><p class="p-10 text-center text-sm text-slate-400">No student is currently below the attention threshold.</p><% } %></div></section>
      </div>
      <section class="bg-white border border-slate-200 rounded-2xl overflow-hidden"><div class="px-5 py-4 border-b flex justify-between"><h2 class="font-bold text-slate-900">Recent Tests</h2><a href="/admin/tests" class="text-xs font-semibold text-indigo-600">Manage tests</a></div><div class="overflow-x-auto"><table class="w-full text-sm"><thead class="bg-slate-50 text-xs text-slate-500 uppercase"><tr><th class="px-5 py-3 text-left">Test</th><th class="px-5 py-3 text-left">Status</th><th class="px-5 py-3 text-left">Attempts</th><th class="px-5 py-3 text-left">Completion</th><th class="px-5 py-3 text-left">Average</th><th class="px-5 py-3"></th></tr></thead><tbody class="divide-y"><% analytics.recentTests.forEach(test=>{ %><tr><td class="px-5 py-3 font-semibold"><%= test.title %></td><td class="px-5 py-3"><span class="rounded-full bg-slate-100 px-2 py-1 text-xs"><%= test.status %></span></td><td class="px-5 py-3"><%= test.report.attempts %></td><td class="px-5 py-3"><%= test.report.completionRate %>%</td><td class="px-5 py-3"><%= test.report.averagePercentage %>%</td><td class="px-5 py-3 text-right"><a href="/admin/tests/<%= test._id %>" class="text-indigo-600 text-xs font-semibold">Open</a></td></tr><% }) %><% if(!analytics.recentTests.length){ %><tr><td colspan="6" class="p-10 text-center text-slate-400">No tests created.</td></tr><% } %></tbody></table></div></section>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const dashboardCharts = <%- JSON.stringify(analytics.charts).replace(/</g,'\\u003c') %>;
Chart.defaults.font.family = 'Inter, ui-sans-serif, system-ui';
Chart.defaults.color = '#64748b';
function chart(id, type, labels, datasets, options={}) {
  const canvas=document.getElementById(id); if(!canvas) return;
  new Chart(canvas,{type,data:{labels,datasets},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:datasets.length>1,position:'bottom'}},scales:type==='doughnut'?{}:{y:{beginAtZero:true,grid:{color:'#f1f5f9'}},x:{grid:{display:false},ticks:{maxRotation:25,minRotation:0}}},...options}});
}
chart('scoreTrendChart','line',dashboardCharts.scoreTrend.map(row=>row.label),[{label:'Average %',data:dashboardCharts.scoreTrend.map(row=>row.value),borderColor:'#4f46e5',backgroundColor:'rgba(79,70,229,.12)',fill:true,tension:.35}]);
chart('participationChart','bar',dashboardCharts.participationTrend.map(row=>row.label),[{label:'Participation %',data:dashboardCharts.participationTrend.map(row=>row.value),backgroundColor:'#0f766e'}]);
chart('subjectChart','bar',dashboardCharts.subjects.map(row=>row.label),[{label:'Performance %',data:dashboardCharts.subjects.map(row=>row.value),backgroundColor:'#7c3aed'},{label:'Accuracy %',data:dashboardCharts.subjects.map(row=>row.accuracy),backgroundColor:'#c4b5fd'}]);
chart('batchChart','bar',dashboardCharts.batches.map(row=>row.label),[{label:'Average %',data:dashboardCharts.batches.map(row=>row.value),backgroundColor:'#2563eb'},{label:'Participation %',data:dashboardCharts.batches.map(row=>row.participation),backgroundColor:'#93c5fd'}]);
chart('scoreDistributionChart','doughnut',dashboardCharts.scoreDistribution.map(row=>row.label),[{data:dashboardCharts.scoreDistribution.map(row=>row.count),backgroundColor:['#fb7185','#fbbf24','#60a5fa','#34d399']}]);
chart('accuracyDistributionChart','doughnut',dashboardCharts.accuracyDistribution.map(row=>row.label),[{data:dashboardCharts.accuracyDistribution.map(row=>row.count),backgroundColor:['#f43f5e','#f59e0b','#3b82f6','#10b981']}]);
</script>
</body></html>

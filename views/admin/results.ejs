<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto">
    <header class="sticky top-0 z-20 flex items-center gap-4 border-b border-slate-200 bg-white/90 px-5 py-4 backdrop-blur lg:px-8">
      <button onclick="openSidebar()" class="text-slate-500 lg:hidden">☰</button>
      <div class="flex-1"><h1 class="text-xl font-bold text-slate-950">Batch-wise Ranked Results</h1><p class="text-sm text-slate-500">Select a completed test and see its rank list.</p></div>
      <% if (selectedTestId) { %><a href="/admin/results/export?testId=<%= encodeURIComponent(selectedTestId) %>" class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2.5 font-semibold text-emerald-700">Download Excel</a><% } %>
    </header>

    <div class="p-5 lg:p-8">
      <%- include('../partials/flash') %>
      <form method="GET" action="/admin/results" class="mb-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
        <label class="block text-lg font-bold text-slate-950">Choose test by date</label>
        <p class="mb-3 mt-1 text-sm text-slate-500">Only tests with submitted student results appear here.</p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <select name="testId" required class="min-w-0 flex-1 rounded-xl border border-slate-200 bg-white px-4 py-3 font-semibold" onchange="this.form.submit()">
            <% if (!tests.length) { %><option value="">No completed test results yet</option><% } %>
            <% let lastDate=''; tests.forEach(test => { const date=new Date(test.startTime||test.createdAt); const dateKey=date.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}); if(dateKey!==lastDate){ if(lastDate){ %></optgroup><% } %><optgroup label="<%= dateKey %>"><% lastDate=dateKey; } %><option value="<%= test._id %>" <%= selectedTestId===String(test._id)?'selected':'' %>><%= test.title %></option><% }); if(lastDate){ %></optgroup><% } %>
          </select>
          <button class="rounded-xl bg-navy-950 px-6 py-3 font-bold text-white">Show Rank List</button>
        </div>
      </form>

      <% if (selectedTest) { %>
      <section class="mb-5 rounded-2xl bg-gradient-to-r from-navy-950 to-indigo-900 p-6 text-white shadow-card-lg">
        <div class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-semibold text-indigo-200">SELECTED TEST</p><h2 class="mt-1 text-2xl font-bold"><%= selectedTest.title %></h2><p class="mt-2 text-indigo-200"><%= new Date(selectedTest.startTime||selectedTest.createdAt).toLocaleDateString('en-IN',{weekday:'long',day:'2-digit',month:'long',year:'numeric'}) %></p></div><div class="rounded-xl bg-white/10 px-5 py-3 text-center"><strong class="block text-2xl"><%= results.length %></strong><span class="text-sm text-indigo-200">Students ranked</span></div></div>
      </section>
      <% } %>

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-card">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[980px]">
            <thead class="bg-slate-50 text-sm font-bold uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-4 text-center">Rank</th><th class="px-5 py-4 text-left">Student</th><th class="px-5 py-4 text-center">Physics</th><th class="px-5 py-4 text-center">Chemistry</th><th class="px-5 py-4 text-center">Mathematics</th><th class="px-5 py-4 text-center">Biology</th><th class="px-5 py-4 text-center">Total</th><th class="px-5 py-4 text-center">Percentile</th></tr></thead>
            <tbody class="divide-y divide-slate-100">
              <% results.forEach(result => { const subjects=['Physics','Chemistry','Mathematics','Biology']; %>
              <tr class="transition hover:bg-slate-50 <%= result.displayRank===1?'bg-amber-50/50':'' %>">
                <td class="px-5 py-4 text-center"><span class="inline-flex h-10 min-w-10 items-center justify-center rounded-xl font-bold <%= result.displayRank===1?'bg-amber-400 text-slate-950':result.displayRank===2?'bg-slate-300 text-slate-800':result.displayRank===3?'bg-orange-200 text-orange-900':'bg-slate-100 text-slate-700' %>">#<%= result.displayRank %></span></td>
                <td class="px-5 py-4"><strong class="block text-base text-slate-950"><%= result.studentId?.name || 'Student' %></strong><span class="text-sm text-slate-400"><%= result.studentId?.rollNo || '' %></span></td>
                <% subjects.forEach(subject => { const score=result.subjectScores?.[subject]; %><td class="px-5 py-4 text-center font-semibold <%= score?.status==='ABSENT'?'text-rose-600':'text-slate-700' %>"><%= score?.status==='ABSENT'?'Absent':score?`${Number(score.marks||0)}/${Number(score.total||0)}`:'—' %></td><% }) %>
                <td class="px-5 py-4 text-center"><strong class="text-lg text-slate-950"><%= Number(result.score||0) %></strong><span class="text-sm text-slate-400"> / <%= Number(result.fullTotalMarks||result.totalMarks||0) %></span></td>
                <td class="px-5 py-4 text-center"><span class="rounded-xl bg-indigo-50 px-3 py-2 text-lg font-bold text-indigo-700"><%= Number(result.displayPercentile).toFixed(2) %></span></td>
              </tr>
              <% }) %>
              <% if (!results.length) { %><tr><td colspan="8" class="px-6 py-20 text-center"><div class="text-4xl">🏆</div><h3 class="mt-3 text-lg font-bold text-slate-700">No submitted results for this test</h3><p class="mt-1 text-slate-400">The rank list will appear here after students submit.</p></td></tr><% } %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
</div>
</body></html>

<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto">
    <header class="sticky top-0 z-10 bg-white/90 backdrop-blur border-b border-slate-200 px-5 lg:px-8 py-4">
      <button onclick="openSidebar()" class="lg:hidden text-slate-500 hover:text-slate-800 mr-3 shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/admin/tests" class="text-slate-400 hover:text-slate-600">←</a>
          <div>
            <h1 class="text-lg font-bold text-slate-900"><%= test.title %></h1>
            <p class="text-sm text-slate-500"><%= timingLabel(test) %> · <%= test.totalMarks %> marks<% if(test.course){%> · <%= test.course %><% } %><% if(test.subject){%> / <%= test.subject %><% } %></p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-xs px-3 py-1.5 rounded-full font-semibold
            <%= test.status==='published'?'bg-green-100 text-green-700':test.status==='draft'?'bg-slate-100 text-slate-600':'bg-blue-100 text-blue-700' %>">
            <%= test.status.toUpperCase() %>
          </span>
          <% if(test.status==='draft') { %>
          <form action="/admin/tests/<%= test.id %>/publish" method="POST">
            <button class="bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-green-700">Publish</button>
          </form>
          <% } %>
          <a href="/admin/tests/<%= test.id %>/edit" class="border border-slate-200 text-slate-700 px-4 py-2 rounded-lg text-sm font-semibold hover:bg-slate-50">Edit</a>
          <button onclick="document.getElementById('deleteTestModal').classList.remove('hidden')" class="bg-rose-50 text-rose-600 px-4 py-2 rounded-lg text-sm font-semibold hover:bg-rose-100">Delete</button>
          <a href="/results/leaderboard/<%= test.id %>" class="bg-navy-950 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-navy-800">Leaderboard</a>
        </div>
      </div>
    </header>
    <div class="p-5 lg:p-8">
      <%- include('../partials/flash') %>
      <!-- Stats -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <% [{icon:'❓',label:'Questions',val:test.questions.length},{icon:'⏱',label:'Timing',val:timingLabel(test)},{icon:'👨‍🎓',label:'Attempts',val:results.length},{icon:'📊',label:'Avg Score',val:results.length?(results.reduce((s,r)=>s+r.score,0)/results.length).toFixed(1)+'/'+test.totalMarks:'N/A'}].forEach(c=>{ %>
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
          <p class="text-xl mb-2"><%= c.icon %></p>
          <p class="text-xl font-bold text-slate-900"><%= c.val %></p>
          <p class="text-xs text-slate-500 mt-0.5"><%= c.label %></p>
        </div>
        <% }) %>
      </div>

      <!-- Anti-cheat settings badge row -->
      <div class="flex flex-wrap gap-3 mb-6">
        <div class="flex items-center gap-2 bg-indigo-50 border border-indigo-100 rounded-xl px-4 py-2.5 text-sm"><span class="font-bold text-indigo-700"><%= (test.testType||'CUSTOM').replaceAll('_',' ') %></span><span class="text-indigo-400">·</span><span class="text-indigo-700"><%= test.patternSnapshot?.name||'Legacy Custom Pattern' %></span><span class="text-indigo-400">·</span><span class="text-indigo-700"><%= test.rankingSchemaSnapshot?.name||'Score, then Time' %></span></div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm"><span>🔑</span><span class="text-slate-600">Test Password:</span><strong class="<%= test.testAccessEnabled?'text-emerald-600':'text-slate-400' %>"><%= test.testAccessEnabled?'ENABLED':'OFF' %></strong></div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm"><span>📊</span><span class="text-slate-600">Student Results:</span><strong class="<%= releaseLabel(test)==='Available'?'text-emerald-600':'text-amber-600' %>"><%= releaseLabel(test) %></strong></div>
        <% if (releaseLabel(test) !== 'Available') { %>
        <form action="/admin/tests/<%= test.id %>/results/release" method="POST" onsubmit="return confirm('Release marks, answers, ranks, PDFs and leaderboard to all submitted students now?')">
          <button class="bg-emerald-600 text-white rounded-xl px-4 py-2.5 text-sm font-semibold hover:bg-emerald-700">Release Results Now</button>
        </form>
        <% } %>
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm">
          <span class="text-base">🔒</span>
          <span class="text-slate-600 font-medium">Auto-Submit on Violation:</span>
          <% if (test.autoSubmitOnViolation) { %>
          <span class="bg-red-100 text-red-700 font-semibold px-2 py-0.5 rounded-full text-xs">ON — after <%= test.maxTabSwitches || 3 %> tab switches</span>
          <% } else { %>
          <span class="bg-slate-100 text-slate-500 font-semibold px-2 py-0.5 rounded-full text-xs">OFF (log only)</span>
          <% } %>
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm">
          <span class="text-base"><%= test.blockCopyPaste !== false ? '🚫' : '✅' %></span>
          <span class="text-slate-600"><%= test.blockCopyPaste !== false ? 'Copy/Paste Blocked' : 'Copy/Paste Allowed' %></span>
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm">
          <span class="text-base"><%= test.requireFullscreen ? '🖥' : '📱' %></span>
          <span class="text-slate-600"><%= test.requireFullscreen ? 'Fullscreen Required' : 'Fullscreen Optional' %></span>
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm">
          <span class="text-base">⚠</span>
          <span class="text-slate-600">Max Tab Switches: <strong class="text-red-600"><%= test.maxTabSwitches || 3 %></strong></span>
        </div>
        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-xl px-4 py-2.5 text-sm shadow-sm">
          <span class="text-base">👁</span>
          <span class="text-slate-600">Max Focus Losses: <strong class="text-orange-600"><%= test.maxFocusLosses || 5 %></strong></span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Questions list -->
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="px-5 py-4 border-b bg-slate-50"><h3 class="font-semibold text-slate-900 text-sm">Questions (<%= test.questions.length %>)</h3></div>
          <div class="divide-y divide-slate-100 max-h-96 overflow-y-auto">
            <% test.questions.forEach((q,i) => { %>
            <div class="px-5 py-3 hover:bg-slate-50">
              <p class="math-clamp-2 text-xs text-slate-800 leading-snug"><span><%= i+1 %>.</span> <span class="math-content"><%= q.question %></span></p>
              <div class="flex gap-2 mt-1">
                <span class="text-xs bg-green-100 text-green-700 px-1.5 py-0.5 rounded">Ans: <%= answerForDisplay(q) %></span>
                <span class="text-xs text-slate-400"><%= q.subject %></span>
              </div>
            </div>
            <% }) %>
          </div>
        </div>

        <!-- Results -->
        <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b flex items-center justify-between">
            <h3 class="font-semibold text-slate-900">Student Results</h3>
            <a href="/admin/results/export?testId=<%= test.id %>" class="text-xs text-navy-600 hover:underline font-medium">Export This Test to Excel</a>
          </div>
          <% if (!results.length) { %>
          <p class="px-6 py-12 text-center text-slate-400">No submissions yet.</p>
          <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-xs sm:text-sm">
              <thead class="bg-slate-50 text-xs text-slate-500 uppercase tracking-wider">
                <tr><th class="px-5 py-3 text-left">Rank</th><th class="px-5 py-3 text-left">Student</th><th class="px-5 py-3 text-left">Physics</th><th class="px-5 py-3 text-left">Chemistry</th><th class="px-5 py-3 text-left">Mathematics</th><th class="px-5 py-3 text-left">Total</th><th class="px-5 py-3 text-left">%</th><th class="px-5 py-3 text-left">Action</th></tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% results.forEach((r,i) => { const pct=r.totalMarks>0?((r.score/r.totalMarks)*100).toFixed(1):0 %>
                <tr class="hover:bg-slate-50">
                  <td class="px-5 py-3"><%= i===0?'🥇':i===1?'🥈':i===2?'🥉':'#'+(i+1) %></td>
                  <td class="px-5 py-3"><p class="font-medium"><%= r.student?.name %></p><p class="text-xs text-slate-400"><%= r.student?.rollNo %></p></td>
                  <% ['Physics','Chemistry','Mathematics'].forEach(subject => { const subjectResult=r.subjectScores?.[subject]; %>
                  <td class="px-5 py-3 text-xs font-semibold <%= subjectResult?.status==='ABSENT'?'text-rose-600':'text-slate-600' %>"><%= subjectResult?.status==='ABSENT'?'ABSENT':subjectResult?`${subjectResult.marks||0}/${subjectResult.total||0}`:'—' %></td>
                  <% }) %>
                  <td class="px-5 py-3 font-bold"><%= r.score %>/<%= r.totalMarks %></td>
                  <td class="px-5 py-3 font-semibold <%= pct>=60?'text-green-600':pct>=40?'text-yellow-600':'text-red-500' %>"><%= pct %>%</td>
                  <td class="px-5 py-3"><a href="/results/<%= r.id %>" class="text-navy-600 hover:underline text-xs font-medium">View</a></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>

      <% if (results.length) { %>
      <section class="mt-6 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <h3 class="font-semibold text-slate-900">Result Recalculation Audit</h3>
            <p class="text-xs text-slate-500 mt-1">Use after correcting an answer key, marks, or bonus rule. Saved answers and submission times are preserved.</p>
          </div>
          <button type="button" onclick="document.getElementById('recalculationModal').classList.remove('hidden')" class="bg-amber-500 text-white px-4 py-2.5 rounded-lg text-sm font-semibold hover:bg-amber-600">Recalculate Results</button>
        </div>
        <% if (!recalculations.length) { %>
        <p class="px-6 py-6 text-sm text-slate-400">No recalculation has been run for this test.</p>
        <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-5 py-3 text-left">When</th><th class="px-5 py-3 text-left">Admin</th><th class="px-5 py-3 text-left">Reason</th><th class="px-5 py-3 text-left">Status</th><th class="px-5 py-3 text-left">Impact</th></tr></thead>
            <tbody class="divide-y">
              <% recalculations.forEach(run => { %>
              <tr><td class="px-5 py-3 whitespace-nowrap"><%= new Date(run.createdAt).toLocaleString('en-IN') %></td><td class="px-5 py-3"><%= run.initiatedBy?.name || run.initiatedBy?.email || 'Admin' %></td><td class="px-5 py-3 max-w-sm"><%= run.reason %></td><td class="px-5 py-3"><span class="px-2 py-1 rounded-full text-xs font-semibold <%= run.status==='COMPLETED'?'bg-emerald-100 text-emerald-700':run.status==='FAILED'?'bg-rose-100 text-rose-700':'bg-amber-100 text-amber-700' %>"><%= run.status %></span></td><td class="px-5 py-3"><%= run.affectedResults %> checked, <%= run.changedResults %> changed</td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </section>
      <% } %>
    </div>
  </main>
</div>
<div id="recalculationModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg p-6">
    <h3 class="font-bold text-slate-900 text-lg">Recalculate submitted results?</h3>
    <p class="text-sm text-slate-500 mt-2">Scores, subject/topic analysis, ranks and percentiles will be recomputed from the current answer key and marking rules. This action is recorded.</p>
    <form action="/admin/tests/<%= test.id %>/results/recalculate" method="POST" class="mt-5 space-y-4" onsubmit="return confirm('Run the verified recalculation now?')">
      <label class="block"><span class="text-sm font-semibold text-slate-700">Reason</span><textarea name="reason" minlength="10" maxlength="1000" required rows="3" class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2" placeholder="Example: Question 12 answer key corrected after review"></textarea></label>
      <label class="block"><span class="text-sm font-semibold text-slate-700">Type RECALCULATE to confirm</span><input name="confirmation" required autocomplete="off" pattern="RECALCULATE" class="mt-1 w-full border border-slate-200 rounded-xl px-3 py-2 font-mono" /></label>
      <div class="flex gap-3"><button class="flex-1 bg-amber-500 text-white font-semibold py-3 rounded-xl hover:bg-amber-600">Confirm Recalculation</button><button type="button" onclick="document.getElementById('recalculationModal').classList.add('hidden')" class="flex-1 border border-slate-200 text-slate-700 font-semibold py-3 rounded-xl">Cancel</button></div>
    </form>
  </div>
</div>
<!-- Delete Test Modal -->
<div id="deleteTestModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6 text-center">
    <div class="w-14 h-14 bg-rose-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
      <svg class="w-7 h-7 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
    </div>
    <h3 class="font-bold text-slate-900 mb-1.5">Delete this test?</h3>
    <p class="text-sm text-slate-500 mb-5">This cannot be undone. Existing results will remain.</p>
    <form action="/admin/tests/<%= test.id %>/delete" method="POST" class="flex gap-3">
      <button type="submit" class="flex-1 bg-rose-600 text-white font-semibold py-3 rounded-xl hover:bg-rose-700">Yes, Delete</button>
      <button type="button" onclick="document.getElementById('deleteTestModal').classList.add('hidden')" class="flex-1 border border-slate-200 text-slate-700 font-semibold py-3 rounded-xl hover:bg-slate-50">Cancel</button>
    </form>
  </div>
</div>
</body></html>

<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto">
    <header class="sticky top-0 z-20 flex items-center gap-4 border-b border-slate-200 bg-white/90 px-5 py-4 backdrop-blur lg:px-8">
      <a href="/admin/test-parts" class="text-xl text-slate-400">←</a>
      <div class="flex-1"><h1 class="text-xl font-bold text-slate-950"><%= part ? part.name : 'New Subject Test Part' %></h1><p class="text-sm text-slate-500"><%= part ? `${part.subject} · ${part.questionConfigs.length} questions` : 'Name and organise the reusable subject paper first.' %></p></div>
      <% if (part) { %><a href="/admin/tests/create" class="rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-2.5 font-semibold text-indigo-700">Combine in Test →</a><% } %>
    </header>

    <div class="mx-auto max-w-7xl p-5 lg:p-8">
      <%- include('../partials/flash') %>
      <form id="partForm" method="POST" action="<%= part ? `/admin/test-parts/${part._id}` : '/admin/test-parts' %>" class="space-y-6">
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
          <div class="mb-5"><h2 class="text-lg font-bold text-slate-950">1. Name &amp; subject hierarchy</h2><p class="text-sm text-slate-500">This identity makes the part easy to find when combining a final test.</p></div>
          <div class="grid gap-4 md:grid-cols-2">
            <label class="font-semibold text-slate-700 md:col-span-2">Test part name *<input name="name" required maxlength="180" value="<%= part?.name || '' %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal" placeholder="e.g. Physics — Electrostatics Set 03"/></label>
            <label class="font-semibold text-slate-700">Subject *<select id="partSubject" name="subject" required class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 font-normal"><% SUBJECTS.forEach(subject => { %><option value="<%= subject %>" <%= (part?.subject || selectedSubject || 'Physics')===subject?'selected':'' %>><%= subject %></option><% }) %></select></label>
            <label class="font-semibold text-slate-700">Status<select name="status" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 font-normal"><option value="draft" <%= !part||part.status==='draft'?'selected':'' %>>Draft — still building</option><option value="ready" <%= part?.status==='ready'?'selected':'' %>>Ready — available to combine</option><option value="archived" <%= part?.status==='archived'?'selected':'' %>>Archived</option></select></label>
            <label class="font-semibold text-slate-700">Topic / chapter<input name="topic" list="topicOptions" value="<%= part?.topic || '' %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal" placeholder="e.g. Electrostatics"/></label>
            <label class="font-semibold text-slate-700">Subtopic<input name="subtopic" list="subtopicOptions" value="<%= part?.subtopic || '' %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal" placeholder="e.g. Coulomb's law"/></label>
            <datalist id="topicOptions"><% hierarchy.forEach(topic => { %><option value="<%= topic.name %>"></option><% }) %></datalist>
            <datalist id="subtopicOptions"><% hierarchy.flatMap(topic => topic.subtopics || []).forEach(subtopic => { %><option value="<%= subtopic.name || subtopic %>"></option><% }) %></datalist>
            <label class="font-semibold text-slate-700">Default marks for every question<input name="defaultPositiveMarks" type="number" min="0" step="0.25" value="<%= part?.defaultPositiveMarks ?? 1 %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label>
            <label class="font-semibold text-slate-700">Default negative marks<input name="defaultNegativeMarks" type="number" min="0" step="0.25" value="<%= part?.defaultNegativeMarks ?? 0 %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label>
            <label class="font-semibold text-slate-700 md:col-span-2">Notes<textarea name="description" rows="2" maxlength="1000" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal" placeholder="Optional teacher note"><%= part?.description || '' %></textarea></label>
          </div>
        </section>

        <% if (part) { %>
        <section id="questions" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-card">
          <div class="mb-5 flex flex-wrap items-center justify-between gap-3"><div><h2 class="text-lg font-bold text-slate-950">2. Questions &amp; individual marks</h2><p class="text-sm text-slate-500">Default marks are applied automatically. Edit only the exceptional question.</p></div><div id="partSummary" class="rounded-xl bg-indigo-50 px-4 py-2 font-bold text-indigo-700"></div></div>
          <div class="grid gap-5 xl:grid-cols-[1fr_430px]">
            <div>
              <div class="mb-3 grid gap-2 rounded-xl bg-slate-50 p-3 sm:grid-cols-2 lg:grid-cols-4">
                <input id="filterSearch" class="rounded-lg border border-slate-200 px-3 py-2 sm:col-span-2" placeholder="Search <%= part.subject %> question…"/>
                <input id="filterTopic" class="rounded-lg border border-slate-200 px-3 py-2" placeholder="Topic" value="<%= part.topic || '' %>"/>
                <input id="filterSubtopic" class="rounded-lg border border-slate-200 px-3 py-2" placeholder="Subtopic" value="<%= part.subtopic || '' %>"/>
                <select id="filterDifficulty" class="rounded-lg border border-slate-200 bg-white px-3 py-2"><option value="">All difficulty</option><option>Easy</option><option>Medium</option><option>Hard</option></select>
                <button type="button" onclick="loadQuestions(1)" class="rounded-lg bg-slate-900 px-3 py-2 font-semibold text-white">Search</button>
                <button type="button" onclick="selectPage()" class="rounded-lg bg-emerald-50 px-3 py-2 font-semibold text-emerald-700 sm:col-span-2">Add filtered page</button>
              </div>
              <div id="questionResults" class="max-h-[560px] space-y-2 overflow-y-auto rounded-xl border border-slate-200 p-2"></div>
              <div class="mt-3 flex justify-between"><button type="button" id="prevPage" onclick="loadQuestions(currentPage-1)" class="rounded-lg border px-3 py-2">← Previous</button><span id="pageInfo" class="py-2 text-sm text-slate-500"></span><button type="button" id="nextPage" onclick="loadQuestions(currentPage+1)" class="rounded-lg border px-3 py-2">Next →</button></div>
            </div>
            <aside class="rounded-xl border border-indigo-100 bg-indigo-50/40 p-3"><h3 class="mb-3 font-bold text-indigo-950">Selected order</h3><div id="selectedQuestions" class="max-h-[650px] space-y-3 overflow-y-auto"></div><div id="questionInputs"></div></aside>
          </div>
        </section>

        <div class="flex gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-card"><button class="flex-1 rounded-xl bg-navy-950 py-3.5 text-lg font-bold text-white">Save Test Part</button><a href="/admin/test-parts" class="rounded-xl border border-slate-200 px-6 py-3.5 font-semibold text-slate-600">Close</a></div>
        <% } else { %>
        <div class="flex gap-3"><button class="flex-1 rounded-xl bg-navy-950 py-3.5 text-lg font-bold text-white">Create &amp; Add Questions →</button><a href="/admin/test-parts" class="rounded-xl border border-slate-200 px-6 py-3.5 font-semibold text-slate-600">Cancel</a></div>
        <% } %>
      </form>

      <% if (part) { %>
      <section id="new-question" class="mt-8 rounded-2xl border border-emerald-200 bg-emerald-50/40 p-6">
        <div class="mb-5"><h2 class="text-lg font-bold text-slate-950">3. Write a new question &amp; answer</h2><p class="text-sm text-slate-600">The new MCQ is saved to the Question Bank and added to this <%= part.subject %> part.</p></div>
        <form method="POST" action="/admin/test-parts/<%= part._id %>/questions" class="grid gap-4 md:grid-cols-2">
          <input type="hidden" name="questionType" value="SINGLE_CORRECT"/>
          <label class="font-semibold text-slate-700 md:col-span-2">Question *<textarea name="question" required rows="3" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal" placeholder="Type the complete question"></textarea></label>
          <% ['A','B','C','D'].forEach(letter => { %><label class="font-semibold text-slate-700">Option <%= letter %> *<input name="option<%= letter %>" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label><% }) %>
          <label class="font-semibold text-slate-700">Correct answer *<select name="correctAnswer" required class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 font-normal"><% ['A','B','C','D'].forEach(letter => { %><option><%= letter %></option><% }) %></select></label>
          <label class="font-semibold text-slate-700">Difficulty<select name="difficulty" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 font-normal"><option>Easy</option><option selected>Medium</option><option>Hard</option></select></label>
          <label class="font-semibold text-slate-700">Topic<input name="topic" value="<%= part.topic || '' %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label>
          <label class="font-semibold text-slate-700">Subtopic<input name="subtopic" value="<%= part.subtopic || '' %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label>
          <label class="font-semibold text-slate-700">Marks for this question<input name="positiveMarks" type="number" min="0" step="0.25" value="<%= part.defaultPositiveMarks %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label>
          <label class="font-semibold text-slate-700">Negative marks<input name="negativeMarks" type="number" min="0" step="0.25" value="<%= part.defaultNegativeMarks %>" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"/></label>
          <label class="font-semibold text-slate-700 md:col-span-2">Answer explanation<textarea name="explanation" rows="2" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 font-normal"></textarea></label>
          <button class="rounded-xl bg-emerald-600 px-5 py-3.5 font-bold text-white md:col-span-2">Add Question &amp; Answer</button>
        </form>
      </section>
      <% } %>
    </div>
  </main>
</div>

<% if (part) { %>
<script>
const PART_SUBJECT=<%- JSON.stringify(part.subject) %>;
const DEFAULT_POSITIVE=<%- JSON.stringify(Number(part.defaultPositiveMarks)) %>;
const DEFAULT_NEGATIVE=<%- JSON.stringify(Number(part.defaultNegativeMarks)) %>;
const INITIAL_QUESTIONS=<%- JSON.stringify(initialQuestions).replace(/</g,'\\u003c') %>;
const INITIAL_SELECTED=<%- JSON.stringify(selectedQuestions).replace(/</g,'\\u003c') %>;
const selected=new Map(INITIAL_SELECTED.map(question=>[question.id,question]));
let pageQuestions=INITIAL_QUESTIONS,currentPage=1,totalPages=1;
const el=(tag,className,text)=>{const node=document.createElement(tag);if(className)node.className=className;if(text!==undefined)node.textContent=text;return node;};

function params(page){const p=new URLSearchParams({page,limit:50,subject:PART_SUBJECT});[['search','filterSearch'],['topic','filterTopic'],['subtopic','filterSubtopic'],['difficulty','filterDifficulty']].forEach(([key,id])=>{const value=document.getElementById(id).value.trim();if(value)p.set(key,value);});return p;}
async function loadQuestions(page=1){if(page<1)return;const root=document.getElementById('questionResults');root.textContent='Loading…';try{const response=await fetch(`/admin/question-papers/questions/search?${params(page)}`);const data=await response.json();if(!response.ok)throw new Error(data.error||'Search failed');pageQuestions=data.questions;currentPage=data.page;totalPages=data.totalPages;renderResults();document.getElementById('pageInfo').textContent=`Page ${currentPage} of ${totalPages} · ${data.total} questions`;document.getElementById('prevPage').disabled=currentPage<=1;document.getElementById('nextPage').disabled=currentPage>=totalPages;}catch(error){root.textContent=error.message;}}
function renderResults(){const root=document.getElementById('questionResults');root.replaceChildren();if(!pageQuestions.length)return root.append(el('p','p-8 text-center text-slate-400','No matching questions.'));pageQuestions.forEach(question=>{const card=el('label','flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 bg-white p-3');const box=el('input','mt-1 rounded');box.type='checkbox';box.checked=selected.has(question.id);box.onchange=()=>{if(box.checked)selected.set(question.id,{...question,positiveMarks:DEFAULT_POSITIVE,negativeMarks:DEFAULT_NEGATIVE});else selected.delete(question.id);renderSelected();};const content=el('div','min-w-0 flex-1');content.append(el('p','font-medium leading-snug text-slate-800',question.question),el('p','mt-1 text-xs text-slate-500',`${question.topic||'No topic'} · ${question.difficulty} · Answer ${question.answer||'—'}`));card.append(box,content);root.append(card);});}
function renderSelected(){const root=document.getElementById('selectedQuestions'),inputs=document.getElementById('questionInputs');root.replaceChildren();inputs.replaceChildren();let total=0;[...selected.values()].forEach((question,index)=>{const positive=Number(question.positiveMarks??DEFAULT_POSITIVE),negative=Number(question.negativeMarks??DEFAULT_NEGATIVE);total+=positive;const card=el('div','rounded-xl border border-indigo-100 bg-white p-3');const top=el('div','flex items-start gap-2');top.append(el('span','flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-indigo-100 text-xs font-bold text-indigo-700',index+1),el('p','line-clamp-2 flex-1 text-sm font-medium text-slate-800',question.question));const remove=el('button','text-lg font-bold text-rose-500','×');remove.type='button';remove.onclick=()=>{selected.delete(question.id);renderSelected();renderResults();};top.append(remove);const marks=el('div','mt-3 grid grid-cols-2 gap-2');[['Marks',positive,'positiveMarks'],['Negative',negative,'negativeMarks']].forEach(([label,value,key])=>{const wrap=el('label','text-xs font-semibold text-slate-500',label);const input=el('input','mt-1 w-full rounded-lg border border-slate-200 px-2 py-2 text-sm text-slate-900');input.type='number';input.min='0';input.step='0.25';input.value=value;input.oninput=()=>{question[key]=Number(input.value)||0;renderSummary();};wrap.append(input);marks.append(wrap);});card.append(top,marks);root.append(card);const id=el('input');id.type='hidden';id.name='questionIds';id.value=question.id;inputs.append(id);marks.querySelectorAll('input').forEach((visible,markIndex)=>{visible.name=`${markIndex===0?'positiveMarks':'negativeMarks'}[${question.id}]`;});});if(!selected.size)root.append(el('p','py-12 text-center text-sm text-slate-400','Select questions from the left or write a new one below.'));renderSummary();}
function renderSummary(){const total=[...selected.values()].reduce((sum,q)=>sum+Number(q.positiveMarks??DEFAULT_POSITIVE),0);document.getElementById('partSummary').textContent=`${selected.size} question${selected.size===1?'':'s'} · ${total.toFixed(2)} marks`;}
function selectPage(){pageQuestions.forEach(q=>{if(!selected.has(q.id))selected.set(q.id,{...q,positiveMarks:DEFAULT_POSITIVE,negativeMarks:DEFAULT_NEGATIVE});});renderSelected();renderResults();}
let timer;document.getElementById('filterSearch').addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>loadQuestions(1),300);});['filterTopic','filterSubtopic','filterDifficulty'].forEach(id=>document.getElementById(id).addEventListener('change',()=>loadQuestions(1)));
renderResults();renderSelected();
</script>
<% } %>
</body></html>

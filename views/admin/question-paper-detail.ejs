<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-admin') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto">
    <header class="sticky top-0 z-10 flex flex-wrap items-center gap-3 border-b border-slate-200 bg-white/90 px-5 py-4 backdrop-blur lg:px-8">
      <a href="/admin/question-papers" class="text-slate-400">←</a>
      <div class="min-w-0 flex-1"><p class="text-[10px] font-bold uppercase tracking-widest text-indigo-500"><%= paper.code %></p><h1 class="truncate text-lg font-bold text-slate-900"><%= paper.title %></h1></div>
      <% if(paper.status!=='archived'){ %><a href="/admin/question-papers/<%= paper.id %>/create-test" class="rounded-lg bg-emerald-600 px-3 py-2 text-xs font-bold text-white">Create Test from Paper</a><% } %>
      <a href="/admin/question-papers/<%= paper.id %>/edit" class="rounded-lg bg-navy-950 px-3 py-2 text-xs font-bold text-white">Edit</a>
    </header>
    <div class="mx-auto max-w-5xl p-5 lg:p-8">
      <%- include('../partials/flash') %>
      <section class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div><span class="rounded-full px-2.5 py-1 text-[10px] font-bold <%= paper.status==='ready'?'bg-emerald-100 text-emerald-700':paper.status==='archived'?'bg-slate-200 text-slate-600':'bg-amber-100 text-amber-700' %>"><%= paper.status %></span><% if(paper.autoGenerated){ %><span class="ml-2 rounded-full bg-indigo-100 px-2.5 py-1 text-[10px] font-bold text-indigo-700">Auto generated</span><% } %></div>
          <p class="text-xs text-slate-400">Updated <%= new Date(paper.updatedAt).toLocaleString('en-IN') %><% if(paper.createdBy){ %> · <%= paper.createdBy.name %><% } %></p>
        </div>
        <% if(paper.description){ %><p class="mt-4 text-sm leading-relaxed text-slate-600"><%= paper.description %></p><% } %>
        <div class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-5">
          <div class="rounded-xl bg-slate-50 p-3"><p class="text-xl font-bold"><%= paper.totalQuestions %></p><p class="text-[10px] uppercase text-slate-400">Questions</p></div>
          <div class="rounded-xl bg-slate-50 p-3"><p class="text-xl font-bold"><%= paper.totalMarks %></p><p class="text-[10px] uppercase text-slate-400">Marks</p></div>
          <div class="rounded-xl bg-emerald-50 p-3"><p class="text-xl font-bold text-emerald-700"><%= paper.difficultyDistribution?.Easy||0 %></p><p class="text-[10px] uppercase text-emerald-500">Easy</p></div>
          <div class="rounded-xl bg-amber-50 p-3"><p class="text-xl font-bold text-amber-700"><%= paper.difficultyDistribution?.Medium||0 %></p><p class="text-[10px] uppercase text-amber-500">Medium</p></div>
          <div class="rounded-xl bg-rose-50 p-3"><p class="text-xl font-bold text-rose-700"><%= paper.difficultyDistribution?.Hard||0 %></p><p class="text-[10px] uppercase text-rose-500">Hard</p></div>
        </div>
        <div class="mt-4 flex flex-wrap gap-1"><% (paper.subjects||[]).forEach(value=>{ %><span class="rounded bg-blue-50 px-2 py-1 text-[10px] font-bold text-blue-700"><%= value %></span><% }) %><% (paper.topics||[]).forEach(value=>{ %><span class="rounded bg-slate-100 px-2 py-1 text-[10px] text-slate-600"><%= value %></span><% }) %><% (paper.tags||[]).forEach(value=>{ %><span class="rounded bg-violet-50 px-2 py-1 text-[10px] text-violet-700">#<%= value %></span><% }) %></div>
        <div class="mt-5 flex flex-wrap gap-2">
          <form action="/admin/question-papers/<%= paper.id %>/duplicate" method="POST"><button class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-bold text-slate-600">Duplicate</button></form>
          <form action="/admin/question-papers/<%= paper.id %>/archive" method="POST"><button class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-bold text-slate-600"><%= paper.status==='archived'?'Restore as Draft':'Archive' %></button></form>
          <form action="/admin/question-papers/<%= paper.id %>/delete" method="POST" onsubmit="return confirm('Remove this paper from the library? Linked tests will remain unchanged.')"><button class="rounded-lg bg-rose-50 px-3 py-2 text-xs font-bold text-rose-600">Delete Safely</button></form>
        </div>
      </section>

      <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="mb-4 font-bold text-slate-900">Questions in Paper</h2>
        <div class="space-y-3">
          <% questions.forEach((item,index)=>{ const q=item.question; %>
          <article class="rounded-xl border border-slate-200 p-4">
            <div class="flex items-start gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-navy-950 text-xs font-bold text-white"><%= index+1 %></span><div class="min-w-0 flex-1"><p class="math-content text-sm font-medium leading-relaxed text-slate-800"><%= q.question %></p><p class="mt-1 text-[10px] text-slate-400"><%= q.subject %> · <%= q.topic||'No topic' %> · <%= q.difficulty %> · <%= (q.questionType||'SINGLE_CORRECT').replaceAll('_',' ') %> · <%= q.marks %> mark(s)</p><details class="mt-2 rounded-lg bg-slate-50 p-2"><summary class="cursor-pointer text-[10px] font-bold text-indigo-700">Answer &amp; explanation</summary><p class="mt-2 text-xs font-semibold text-emerald-700">Answer: <%= item.answer||'—' %></p><p class="math-content mt-1 text-xs text-slate-600"><%= q.explanation||'No explanation saved.' %></p></details></div></div>
          </article>
          <% }) %>
        </div>
      </section>
    </div>
  </main>
</div>
</body></html>

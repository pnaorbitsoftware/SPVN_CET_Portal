<%- include('../partials/head') %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/sidebar-student') %>
  <main class="lg:ml-64 flex-1 overflow-y-auto">
    <header class="sticky top-0 z-20 bg-white border-b px-8 py-4"><h1 class="text-xl font-bold">My Results</h1></header>
    <div class="p-5 lg:p-8 space-y-6">
      <% if (pendingResults.length) { %>
      <section class="bg-amber-50 border border-amber-200 rounded-2xl overflow-hidden">
        <div class="px-6 py-4 border-b border-amber-200"><h2 class="font-bold text-amber-950">Submitted — Result Pending</h2><p class="text-xs text-amber-700 mt-1">No marks, answers or ranks are shown before release.</p></div>
        <div class="divide-y divide-amber-200">
          <% pendingResults.forEach(item => { %>
          <div class="px-6 py-4 flex flex-col sm:flex-row sm:items-center gap-3">
            <div class="flex-1"><p class="font-semibold text-slate-900"><%= item.submission.testTitle %></p><p class="text-xs text-amber-700 mt-1"><%= item.release.message %></p><p class="text-[11px] text-slate-500 mt-1">Submitted <%= item.submission.submittedAt ? new Date(item.submission.submittedAt).toLocaleString('en-IN',{timeZone:appTimeZone}) : '' %></p></div>
            <a href="/results/<%= item.submission.id %>" class="text-center text-sm font-semibold text-amber-900 border border-amber-300 rounded-xl px-4 py-2.5 hover:bg-amber-100">View Submission</a>
          </div>
          <% }) %>
        </div>
      </section>
      <% } %>
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-xs sm:text-sm">
            <thead class="bg-gray-50 text-xs text-gray-500 uppercase tracking-wider">
              <tr><th class="px-6 py-3 text-left">Test</th><th class="px-6 py-3 text-left">Physics</th><th class="px-6 py-3 text-left">Chemistry</th><th class="px-6 py-3 text-left">Mathematics</th><th class="px-6 py-3 text-left">Total</th><th class="px-6 py-3 text-left">%</th><th class="px-6 py-3 text-left">Rank</th><th class="px-6 py-3 text-left">Date</th><th class="px-6 py-3 text-left">Action</th></tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              <% results.forEach(r => { const total=r.totalMarks||r.testId?.totalMarks||0; const pct=total>0?((r.score/total)*100).toFixed(1):0 %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium max-w-xs truncate"><%= r.testId?.title || '—' %></td>
                <% ['Physics','Chemistry','Mathematics'].forEach(subject => { const subjectResult=r.subjectScores?.[subject]; %>
                <td class="px-6 py-4 text-xs font-semibold <%= subjectResult?.status==='ABSENT'?'text-rose-600':'text-slate-600' %>"><%= subjectResult?.status==='ABSENT'?'ABSENT':subjectResult?`${subjectResult.marks||0}/${subjectResult.total||0}`:'—' %></td>
                <% }) %>
                <td class="px-6 py-4 font-bold"><%= r.score %>/<%= total %></td>
                <td class="px-6 py-4 font-semibold <%= pct>=60?'text-green-600':pct>=40?'text-yellow-600':'text-red-500' %>"><%= pct %>%</td>
                <td class="px-6 py-4 text-gray-600">#<%= r.rank||'—' %></td>
                <td class="px-6 py-4 text-xs text-gray-400"><%= r.submittedAt?new Date(r.submittedAt).toLocaleDateString('en-IN'):'—' %></td>
                <td class="px-6 py-4 flex gap-2">
                  <a href="/results/<%= r.id %>" class="text-indigo-600 hover:underline text-xs font-medium">View</a>
                  <a href="/results/<%= r.id %>/pdf" class="text-red-500 hover:underline text-xs font-medium">PDF</a>
                </td>
              </tr>
              <% }) %>
              <% if (!results.length) { %><tr><td colspan="9" class="px-6 py-12 text-center text-gray-400"><%= pendingResults.length?'Released results will appear here.':'No results yet.' %></td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>
</body></html>

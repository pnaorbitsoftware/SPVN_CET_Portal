<%- include('../partials/head') %>

<main class="spvn-auth-shell">
  <section class="auth-story" aria-labelledby="auth-story-title">
    <div class="story-grid" aria-hidden="true"></div>
    <div class="story-glow story-glow-one" aria-hidden="true"></div>
    <div class="story-glow story-glow-two" aria-hidden="true"></div>
    <img class="story-watermark" src="/brand/spvn-logo.png" alt="" aria-hidden="true" />

    <a class="story-brand" href="/" aria-label="Return to SPVN home">
      <span class="story-brand-mark"><img src="/brand/spvn-logo.png" alt="SPVN emblem" /></span>
      <span>
        <strong><%= collegeShort %></strong>
        <small>Student Examination Portal</small>
      </span>
    </a>

    <div class="story-copy">
      <div class="live-pill"><i></i> Portal is live</div>
      <p class="story-kicker">Shardabai Pawar Vidya Niketan · Shardanagar</p>
      <h1 id="auth-story-title">Focused learning.<br /><em>Confident progress.</em></h1>
      <p class="story-lead">
        A secure examination space designed for calm attempts, fair assessment
        and meaningful academic growth.
      </p>
    </div>

    <div class="story-features" aria-label="Portal highlights">
      <article>
        <span class="feature-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-5 9 5-9 5-9-5Z"/><path d="M7 12.5V17c2.8 2 7.2 2 10 0v-4.5"/></svg>
        </span>
        <strong>Students</strong><small>Secure access</small>
      </article>
      <article>
        <span class="feature-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18H6z"/><path d="M9 7h6M9 11h6M9 15h3"/></svg>
        </span>
        <strong>Live exams</strong><small>Focused attempts</small>
      </article>
      <article>
        <span class="feature-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v4a5 5 0 0 1-10 0V4Z"/><path d="M7 6H4v2a4 4 0 0 0 4 4M17 6h3v2a4 4 0 0 1-4 4"/></svg>
        </span>
        <strong>Results</strong><small>Clear insights</small>
      </article>
    </div>

    <div class="story-footer">
      <span>© <%= new Date().getFullYear() %> <%= collegeName %></span>
      <span>विद्या · संस्कार · प्रगती</span>
    </div>
  </section>

  <section class="auth-form-panel" aria-label="Student login area">
    <div class="panel-texture" aria-hidden="true"></div>
    <img class="panel-watermark" src="/brand/spvn-logo.png" alt="" aria-hidden="true" />

    <a class="mobile-brand" href="/" aria-label="Return to SPVN home">
      <span><img src="/brand/spvn-logo.png" alt="SPVN emblem" /></span>
      <div><strong><%= collegeShort %></strong><small>Student Portal</small></div>
    </a>

    <div class="auth-form-wrap">
      <div class="auth-card">
        <header class="auth-card-header">
          <div class="auth-card-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-5 9 5-9 5-9-5Z"/><path d="M7 12.5V17c2.8 2 7.2 2 10 0v-4.5"/></svg>
          </div>
          <span class="auth-eyebrow">Welcome to SPVN</span>
          <h2>Student Login</h2>
          <p>Enter your roll number and password to continue.</p>
        </header>

        <%- include('../partials/flash') %>

        <form action="/auth/login" method="POST" class="auth-form">
          <input type="hidden" name="role" value="student" />

          <div class="auth-field">
            <label for="studentRollNumber">Roll number</label>
            <div class="field-control">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-5"/><path d="M10 6V5a2 2 0 0 1 4 0v1a2 2 0 0 1-4 0ZM8 15c.5-1.2 1.5-2 3-2s2.5.8 3 2"/><circle cx="11" cy="10" r="1.5"/></svg>
              <input id="studentRollNumber" type="text" name="identifier" required autofocus autocomplete="username" placeholder="e.g. 2024CE001" />
            </div>
          </div>

          <div class="auth-field">
            <label for="sPw">Password</label>
            <div class="field-control">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg>
              <input id="sPw" type="password" name="password" required autocomplete="current-password" placeholder="Enter your password" />
              <button class="password-toggle" id="passwordToggle" type="button" aria-label="Show password" aria-pressed="false">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.7"/></svg>
              </button>
            </div>
          </div>

          <div class="password-note">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
            <p>Default password: <strong>CET@XXXX</strong> (last 4 digits of your roll number). You will be asked to change it on first login.</p>
          </div>

          <button class="login-submit" type="submit">
            <span>Sign in to portal</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </form>

        <div class="install-card">
          <button id="pwa-install-trigger" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 20h14"/></svg>
            <span>Install SPVN App</span>
          </button>
          <p id="pwa-install-status" aria-live="polite">Install the complete portal on Android for quick access.</p>
        </div>

        <div class="admin-access">
          <a href="/auth/admin">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-3.5 7-10V5l-7-3-7 3v6c0 6.5 7 10 7 10Z"/><path d="m9 12 2 2 4-4"/></svg>
            Are you an administrator?
          </a>
        </div>
      </div>

      <p class="auth-meta"><%= collegeName %> · Academic Year <%= academicYear %></p>
    </div>
  </section>
</main>

<script src="/auth-login.js?v=1.0" defer></script>
</body></html>

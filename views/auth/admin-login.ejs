<%- include('../partials/head') %>

<main class="admin-auth-shell">
  <div class="admin-background-grid" aria-hidden="true"></div>
  <div class="admin-background-glow admin-glow-one" aria-hidden="true"></div>
  <div class="admin-background-glow admin-glow-two" aria-hidden="true"></div>
  <div class="admin-watermark-wrap" aria-hidden="true">
    <img src="/brand/spvn-logo.png" alt="" />
  </div>

  <a class="admin-page-brand" href="/" aria-label="Return to SPVN home">
    <span><img src="/brand/spvn-logo.png" alt="SPVN emblem" /></span>
    <div><strong><%= collegeShort %></strong><small>Administration Portal</small></div>
  </a>

  <a class="admin-home-link" href="/">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 19-7-7 7-7M3 12h18"/></svg>
    Back to website
  </a>

  <section class="admin-login-card" aria-labelledby="admin-login-title">
    <header class="admin-login-header">
      <div class="admin-shield">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-3.5 7-10V5l-7-3-7 3v6c0 6.5 7 10 7 10Z"/><path d="m9 12 2 2 4-4"/></svg>
      </div>
      <div class="admin-label"><i></i> Secure administration</div>
      <h1 id="admin-login-title">Administrator Login</h1>
      <p>Authorised SPVN personnel only.</p>
    </header>

    <%- include('../partials/flash') %>

    <form class="admin-login-form" action="/auth/admin" method="POST">
      <div class="admin-field">
        <label for="adminEmail">Email address</label>
        <div class="admin-field-control">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M16 12v1.5a2.5 2.5 0 0 0 5 0V12a9 9 0 1 0-9 9c2 0 3.5-.45 4.5-1.2"/></svg>
          <input id="adminEmail" type="email" name="email" required autofocus autocomplete="username" placeholder="admin@spvn.edu.in" />
        </div>
      </div>

      <div class="admin-field">
        <label for="aPw">Password</label>
        <div class="admin-field-control">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg>
          <input id="aPw" type="password" name="password" required autocomplete="current-password" placeholder="Enter admin password" />
          <button class="admin-password-toggle" id="adminPasswordToggle" type="button" aria-label="Show password" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.7"/></svg>
          </button>
        </div>
      </div>

      <div class="admin-security-note">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-3.5 7-10V5l-7-3-7 3v6c0 6.5 7 10 7 10Z"/><path d="M12 8v5M12 16h.01"/></svg>
        <p>This is a restricted area. Unauthorised access attempts are logged and monitored.</p>
      </div>

      <button class="admin-submit" type="submit">
        <span>Access Admin Panel</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
    </form>

    <footer class="admin-card-footer">
      <a href="/auth/login">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 19-7-7 7-7M3 12h18"/></svg>
        Go to Student Login
      </a>
    </footer>
  </section>

  <p class="admin-page-meta">© <%= new Date().getFullYear() %> <%= collegeName %> · Academic Year <%= academicYear %></p>
</main>

<script src="/admin-login.js?v=1.0" defer></script>
</body></html>

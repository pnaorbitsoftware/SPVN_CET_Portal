<%- include('../partials/head') %>
<style>
  body{overflow:hidden}
  .opt-box{border:2px solid #e2e8f0;border-radius:12px;padding:16px;transition:border-color .15s,background .15s;cursor:pointer}
  .opt-box:hover{border-color:#8199f8;background:#f8faff}
  .opt-box.selected{border-color:#131330;background:#f0f4ff}
  .palette-btn{width:34px;height:34px;font-size:11px;font-weight:700;border-radius:8px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s}
  #timer.warning{background:rgba(253,230,138,.3);color:#d97706}
  #timer.urgent{background:rgba(254,202,202,.4);color:#dc2626;animation:pulse 1s infinite}
  @keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.04)}}
  .timer-warning{animation:pulse 1s infinite}
</style>

<div class="h-screen flex flex-col bg-slate-100" id="examContainer">

  <!-- Topbar -->
  <div class="bg-navy-950 text-white px-4 py-2.5 flex items-center justify-between flex-shrink-0 select-none">
    <div class="flex items-center gap-3 min-w-0">
      <span class="font-bold text-sm hidden sm:block text-white/80 shrink-0"><%= collegeShort %></span>
      <span class="text-white/30 hidden sm:block">|</span>
      <span class="text-sm font-medium truncate"><%= test.title %></span>
      <% if (cetSectionFlow && currentSection) { %>
      <span class="hidden sm:inline-flex bg-indigo-500/30 border border-indigo-300/30 text-indigo-100 text-[10px] font-bold px-2.5 py-1 rounded-full"><%= currentSection.name %> Section</span>
      <% } %>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      <div id="violationBar" class="<%= violations>0?'flex':'hidden' %> items-center gap-1.5 bg-rose-600 rounded-lg px-3 py-1.5 text-xs font-bold">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <span id="violationCount"><%= violations %></span> Violation<span id="violPlural"><%= violations!==1?'s':'' %></span>
      </div>
      <button onclick="toggleFullscreen()" class="text-white/60 hover:text-white text-xs hidden sm:flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
        Fullscreen
      </button>
      <div id="timer" class="flex items-center gap-2 bg-white/15 border border-white/20 rounded-lg px-3 py-1.5 font-mono font-bold text-sm">
        <svg class="w-4 h-4 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span id="timerDisplay">--:--:--</span>
      </div>
      <span class="text-xs text-white/50 hidden md:block"><%= currentUser.rollNo %></span>
    </div>
  </div>

  <!-- Warn banner -->
  <div id="warnBanner" class="hidden bg-rose-600 text-white text-center text-sm font-semibold py-2 px-4 flex-shrink-0"></div>
  <% if (cetSectionFlow && currentSection && sectionQuestionNumber===1) { %>
  <div class="bg-indigo-50 border-b border-indigo-100 text-indigo-800 text-center text-xs font-semibold py-2 px-4 flex-shrink-0">
    <%= ['Physics','Chemistry'].includes(currentSection.name) ? 'Physics and Chemistry are both available. Visit every question in both subjects to unlock Mathematics/Biology.' : `${currentSection.name} is now unlocked.` %>
  </div>
  <% } %>

  <div class="flex flex-1 overflow-hidden">
    <!-- Question panel -->
    <div class="flex-1 flex flex-col overflow-hidden bg-white">

      <!-- Question header -->
      <div class="flex items-center justify-between px-5 py-3 border-b border-slate-100 bg-slate-50 flex-shrink-0">
        <div class="flex items-center gap-2.5">
          <span id="questionNumberHeader" class="bg-navy-950 text-white text-xs font-bold px-3 py-1 rounded-full">Q <%= questionNumber %> / <%= totalQuestions %></span>
          <span id="sectionHeader" class="<%= (cetSectionFlow && currentSection) ? '' : 'hidden' %> bg-indigo-100 text-indigo-700 text-xs font-bold px-3 py-1 rounded-full">
            <%= (cetSectionFlow && currentSection) ? `${currentSection.name} ${sectionQuestionNumber}/${currentSection.questionIds.length}` : '' %>
          </span>
          <span id="questionMeta" class="text-xs text-slate-400 hidden sm:block">
            <%= question.subject %><% if(question.topic){%> &rsaquo; <%= question.topic %><% } %> &middot; <%= question.difficulty %> &middot; <%= question.marks %> mark(s)
          </span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs text-slate-400 hidden sm:block">This Q: <span id="qTimer" class="font-mono font-semibold text-slate-600">0s</span></span>
          <button id="markReviewBtn" onclick="toggleMark()"
            class="text-xs font-semibold px-3 py-1.5 rounded-lg border transition-colors <%= isMarked?'bg-violet-600 text-white border-violet-600':'border-slate-200 text-slate-600 hover:border-violet-300' %>">
            <%= isMarked?'Marked':'Mark for Review' %>
          </button>
          <button onclick="clearAnswer()" class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50">Clear</button>
        </div>
      </div>

      <!-- Question content -->
      <div class="flex-1 overflow-y-auto px-5 lg:px-8 py-5">
        <p id="questionText" class="math-content text-base font-medium text-slate-900 leading-relaxed mb-4"><%= question.question %></p>
        <div id="questionImageContainer" class="overflow-x-auto mb-4 <%= question.questionImage ? '' : 'hidden' %>">
          <% if (question.questionImage) { %>
            <img src="<%= question.questionImage %>" alt="Question" class="block w-auto h-auto max-w-full rounded-xl border border-slate-200 bg-white" loading="eager" decoding="async"/>
          <% } %>
        </div>

        <div class="space-y-3" id="optionsContainer">
          <% options.forEach(opt => { %>
          <div class="opt-box <%= selectedAnswer===opt.key?'selected':'' %>" onclick="selectOption('<%= opt.key %>', this)">
            <div class="flex items-start gap-3">
              <span class="opt-key w-7 h-7 rounded-full border-2 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5
                <%= selectedAnswer===opt.key?'bg-navy-950 border-navy-950 text-white':'border-slate-300 text-slate-500' %>">
                <%= opt.key %>
              </span>
              <span class="math-content text-sm text-slate-800 leading-relaxed pt-0.5"><%= opt.value %></span>
            </div>
            <% if (opt.image) { %>
            <img src="<%= opt.image %>" alt="Option <%= opt.key %>" class="max-w-full max-h-36 rounded-xl border border-slate-200 object-contain mt-2 ml-10"/>
            <% } %>
          </div>
          <% }) %>
        </div>
      </div>

      <!-- Navigation -->
      <div id="navButtonsContainer" class="border-t border-slate-100 px-5 py-4 flex items-center bg-white flex-shrink-0 relative">
        <!-- Prev Button (Left) -->
        <% if (questionNumber > 1) { %>
        <button type="button" onclick="navigateToQuestion(<%= questionNumber-2 %>)"
          class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-5 py-2.5 rounded-xl transition-colors text-sm absolute left-5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>Back
        </button>
        <% } %>

        <!-- Center: Save & Next OR Save & Review -->
        <div class="mx-auto">
          <% if (questionNumber < totalQuestions) { %>
            <!-- Normal: Save & Next -->
            <button type="button" onclick="navigateToQuestion(<%= questionNumber %>)"
              class="flex items-center gap-2 bg-navy-950 hover:bg-navy-900 text-white font-semibold px-6 py-2.5 rounded-xl transition-colors text-sm">
              <% const isSectionLast = cetSectionFlow && currentSection && currentSection.questionNumbers[currentSection.questionNumbers.length-1]===questionNumber; %>
              <% const nextSection = isSectionLast ? sectionState.sections[currentSection.index+1] : null; %>
              <%= nextSection && !nextSection.locked ? `Save & Start ${nextSection.name}` : 'Save & Next' %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </button>
          <% } else { %>
            <!-- Last Question: Save & Review -->
            <button type="button" onclick="openReviewModal()" 
              class="flex items-center gap-2 bg-violet-600 hover:bg-violet-700 text-white font-semibold px-6 py-2.5 rounded-xl transition-colors text-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              Save &amp; Review
            </button>
          <% } %>
        </div>

        <!-- Right: Submit Exam (only on last question) -->
        <% if (questionNumber === totalQuestions) { %>
        <button type="button" onclick="submitConfirm()" class="absolute right-5 bg-rose-600 hover:bg-rose-700 text-white font-semibold px-5 py-2.5 rounded-xl transition-colors text-sm flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Submit Exam
        </button>
        <% } %>
      </div>
    </div>

    <!-- Palette panel -->
    <div id="paletteSidebar" class="fixed md:relative inset-y-0 right-0 w-72 md:w-56 bg-white border-l border-slate-200 flex flex-col flex-shrink-0 overflow-hidden z-40 transform translate-x-full md:translate-x-0 transition-transform duration-300 shadow-2xl md:shadow-none">
      <div class="px-4 py-3 border-b border-slate-100 bg-slate-50">
        <p class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Question Palette</p>
        <div class="grid grid-cols-2 gap-1 text-[10px] text-slate-500">
          <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-emerald-500 inline-block"></span>Answered</span>
          <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-rose-500 inline-block"></span>Not Ans.</span>
          <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-violet-500 inline-block"></span>Marked</span>
          <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-slate-300 inline-block"></span>Not Visited</span>
        </div>
      </div>
      <div class="flex-1 overflow-y-auto p-3">
        <div class="<%= cetSectionFlow?'space-y-3':'flex flex-wrap gap-1.5' %>" id="paletteContainer">
          <% let paletteSubject=''; paletteStatus.forEach(p => {
            const bg = p.status==='answered'?'background:#10b981;color:#fff':p.status==='marked'?'background:#8b5cf6;color:#fff':p.status==='answered-marked'?'background:#6d28d9;color:#fff':p.status==='not-answered'?'background:#f43f5e;color:#fff':'background:#e2e8f0;color:#475569';
          %>
          <% if (cetSectionFlow && p.subject!==paletteSubject) { paletteSubject=p.subject; %>
          <% if (p.num!==1) { %></div><% } %>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5"><%= p.subject %> <%= p.locked?'🔒':'' %></p>
            <div class="flex flex-wrap gap-1.5">
          <% } %>
          <% if (p.locked) { %>
          <span class="palette-btn bg-slate-100 text-slate-300 cursor-not-allowed" title="Visit every Physics and Chemistry question first"><%= p.num %></span>
          <% } else { %>
          <a href="/exam/<%= test.id %>/question/<%= p.num %>" onclick="event.preventDefault(); navigateToQuestion(<%= p.num-1 %>);"
            class="palette-btn <%= p.num===questionNumber?'ring-2 ring-offset-1 ring-navy-950 scale-110':'' %>"
            style="<%= bg %>"><%= p.num %></a>
          <% } %>
          <% }) %>
          <% if (cetSectionFlow && paletteStatus.length) { %></div></div><% } %>
        </div>
      </div>
      <div class="border-t border-slate-100 p-4 text-xs text-slate-600 space-y-1.5">
        <% const answered=paletteStatus.filter(p=>['answered','answered-marked'].includes(p.status)).length %>
        <% const marked=paletteStatus.filter(p=>['marked','answered-marked'].includes(p.status)).length %>
        <div class="flex justify-between"><span>Answered</span><span class="font-bold text-emerald-600" id="paletteAnsweredCount"><%= answered %></span></div>
        <div class="flex justify-between"><span>Unanswered</span><span class="font-bold text-rose-500" id="paletteUnansweredCount"><%= totalQuestions-answered %></span></div>
        <div class="flex justify-between"><span>Marked</span><span class="font-bold text-violet-600" id="paletteMarkedCount"><%= marked %></span></div>
        <div class="flex justify-between border-t border-slate-100 pt-1.5"><span>Total</span><span class="font-bold"><%= totalQuestions %></span></div>
      </div>
    </div>
  </div>
</div>

<!-- Review Modal -->
<div id="reviewModal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-card-lg w-full max-w-lg p-6 max-h-[85vh] flex flex-col">
    <div class="flex items-center justify-between mb-4 flex-shrink-0">
      <h3 class="text-lg font-bold text-slate-900">Review Your Answers</h3>
      <button onclick="closeReviewModal()" class="text-slate-400 hover:text-slate-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="bg-slate-50 rounded-xl p-4 mb-4 grid grid-cols-3 gap-3 text-center text-sm flex-shrink-0">
      <div>
        <p class="text-2xl font-bold text-emerald-600" id="reviewAnsweredCount"><%= paletteStatus.filter(p=>['answered','answered-marked'].includes(p.status)).length %></p>
        <p class="text-xs text-slate-500">Answered</p>
      </div>
      <div>
        <p class="text-2xl font-bold text-rose-500" id="reviewUnansweredCount"><%= totalQuestions - paletteStatus.filter(p=>['answered','answered-marked'].includes(p.status)).length %></p>
        <p class="text-xs text-slate-500">Unanswered</p>
      </div>
      <div>
        <p class="text-2xl font-bold text-violet-600" id="reviewMarkedCount"><%= paletteStatus.filter(p=>['marked','answered-marked'].includes(p.status)).length %></p>
        <p class="text-xs text-slate-500">Marked</p>
      </div>
    </div>

    <div class="flex-1 overflow-y-auto mb-4 space-y-1" id="reviewModalList">
      <% paletteStatus.forEach(p => { 
        const statusColor = p.status==='answered'?'text-emerald-600':p.status==='marked'?'text-violet-600':p.status==='answered-marked'?'text-purple-700':p.status==='not-answered'?'text-rose-500':'text-slate-400';
        const statusText = p.status==='answered'?'Answered':p.status==='marked'?'Marked':p.status==='answered-marked'?'Ans+Marked':p.status==='not-answered'?'Not Answered':'Not Visited';
      %>
      <a href="/exam/<%= test.id %>/question/<%= p.num %>" onclick="event.preventDefault(); navigateToQuestion(<%= p.num-1 %>); closeReviewModal();" 
        class="flex items-center justify-between px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors border border-transparent hover:border-slate-200">
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-full text-xs font-bold flex items-center justify-center <%= p.status==='answered'?'bg-emerald-500 text-white':p.status==='marked'?'bg-violet-500 text-white':p.status==='answered-marked'?'bg-purple-700 text-white':p.status==='not-answered'?'bg-rose-500 text-white':'bg-slate-200 text-slate-500' %>">
            <%= p.num %>
          </span>
          <span class="text-sm font-medium text-slate-700">Question <%= p.num %></span>
        </div>
        <span class="text-xs font-semibold <%= statusColor %>"><%= statusText %></span>
      </a>
      <% }) %>
    </div>

    <div class="flex gap-3 flex-shrink-0">
      <button onclick="closeReviewModal()" class="flex-1 border-2 border-slate-200 text-slate-700 font-semibold py-2.5 rounded-xl hover:bg-slate-50 transition-colors text-sm">Back to Exam</button>
      <button onclick="submitConfirm(); closeReviewModal();" class="flex-1 bg-rose-600 text-white font-bold py-2.5 rounded-xl hover:bg-rose-700 transition-colors text-sm">Submit Exam</button>
    </div>
  </div>
</div>

<!-- Submit confirm modal -->
<div id="submitModal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-card-lg w-full max-w-md p-8 text-center">
    <div class="w-14 h-14 bg-rose-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
      <svg class="w-7 h-7 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
    </div>
    <h3 class="text-xl font-bold text-slate-900 mb-2">Submit Exam?</h3>
    <p class="text-slate-500 text-sm mb-5">Once submitted, you cannot change your answers.</p>
    <div class="grid grid-cols-3 gap-3 bg-slate-50 rounded-xl p-4 mb-5 text-sm">
      <div><p class="text-2xl font-bold text-emerald-600" id="submitAnsweredCount"><%= paletteStatus.filter(p=>['answered','answered-marked'].includes(p.status)).length %></p><p class="text-xs text-slate-500">Answered</p></div>
      <div><p class="text-2xl font-bold text-rose-500" id="submitUnansweredCount"><%= totalQuestions-paletteStatus.filter(p=>['answered','answered-marked'].includes(p.status)).length %></p><p class="text-xs text-slate-500">Unanswered</p></div>
      <div><p class="text-2xl font-bold text-violet-600" id="submitMarkedCount"><%= paletteStatus.filter(p=>['marked','answered-marked'].includes(p.status)).length %></p><p class="text-xs text-slate-500">Marked</p></div>
    </div>
    <div class="flex gap-3">
      <button onclick="saveAndSubmit()" class="flex-1 bg-rose-600 text-white font-bold py-3 rounded-xl hover:bg-rose-700 transition-colors">Yes, Submit</button>
      <button onclick="document.getElementById('submitModal').classList.add('hidden')" class="flex-1 border-2 border-slate-200 text-slate-700 font-semibold py-3 rounded-xl hover:bg-slate-50 transition-colors">Cancel</button>
    </div>
  </div>
</div>

<!-- Tab-switch auto-submit overlay -->
<div id="tabSwitchOverlay" class="hidden fixed inset-0 z-[999] bg-black/90 flex items-center justify-center p-6">
  <div class="bg-white rounded-3xl max-w-sm w-full p-8 text-center shadow-card-lg">
    <div class="w-16 h-16 bg-rose-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
    </div>
    <h2 class="text-xl font-bold text-slate-900 mb-2">Tab Switch Detected</h2>
    <p class="text-slate-600 text-sm mb-6 leading-relaxed">You have left the exam window. This is a violation.<br><strong class="text-rose-600">Auto-submitting in:</strong></p>
    <div class="text-6xl font-bold text-rose-600 mb-6 timer-warning" id="tabCountdown">3</div>
    <p class="text-xs text-slate-400">This incident has been logged.</p>
  </div>
</div>

<!-- Manual submit form -->
<form id="manualSubmitForm" action="/exam/<%= test.id %>/submit" method="POST" class="hidden">
  <input type="hidden" name="answers" id="manualAnswersInput" />
  <input type="hidden" name="markedForReview" id="manualMarkedInput" />
  <input type="hidden" name="questionTimings" id="manualTimingsInput" />
  <input type="hidden" name="visitedQuestionIds" id="manualVisitedInput" />
</form>

<!-- Single auto-submit form (only one!) -->
<form id="autoSubmitForm" action="/exam/<%= test.id %>/submit" method="POST" class="hidden">
  <input type="hidden" name="auto" value="true"/>
  <input type="hidden" name="answers" id="autoAnswersInput" />
  <input type="hidden" name="markedForReview" id="autoMarkedInput" />
  <input type="hidden" name="questionTimings" id="autoTimingsInput" />
  <input type="hidden" name="visitedQuestionIds" id="autoVisitedInput" />
</form>

<script>
// ── Core vars ──────────────────────────────────────────────────────────────
const TEST_ID     = '<%= test.id %>';
const questions   = <%- JSON.stringify(clientQuestions) %>;
const answers     = <%- JSON.stringify(result.answers || {}) %>;
const markedForReview = <%- JSON.stringify(result.markedForReview || []) %>;
const visitedQuestionIds = new Set(<%- JSON.stringify(result.visitedQuestionIds || []) %>);
const questionTimings = <%- JSON.stringify(result.questionTimings || {}) %>;
let currentQuestionIndex = <%= questionNumber - 1 %>;
let qElapsed = 0;
let navInProgress = false;
const cetSectionFlow = <%- cetSectionFlow ? 'true' : 'false' %>;
let sectionState = <%- JSON.stringify(sectionState) %>;
let currentSection = <%- JSON.stringify(currentSection) %>;

// ── Per-test anti-cheat settings (from admin) ────────────────────────────
const SETTINGS = {
  autoSubmitOnViolation: <%- test.autoSubmitOnViolation ? 'true' : 'false' %>,
  maxTabSwitches: <%= test.maxTabSwitches || 3 %>,
  maxFocusLosses:  <%= test.maxFocusLosses  || 5 %>,
  blockCopyPaste:  <%- test.blockCopyPaste  !== false ? 'true' : 'false' %>,
  requireFullscreen: <%- test.requireFullscreen ? 'true' : 'false' %>,
};
let tabSwitchCount  = <%= (result && result.cheatingFlags && result.cheatingFlags.tabSwitches)  || 0 %>;
let focusLossCount  = <%= (result && result.cheatingFlags && result.cheatingFlags.focusLosses)  || 0 %>;

// ── Timer ──────────────────────────────────────────────────────────────────
const fmt = s => `${String(Math.floor(s/3600)).padStart(2,'0')}:${String(Math.floor((s%3600)/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`;
let remaining = <%= remaining %>;
const timerEl = document.getElementById('timer');
const timerDisplay = document.getElementById('timerDisplay');
timerDisplay.textContent = fmt(remaining);

const countdown = setInterval(() => {
  remaining--;
  timerDisplay.textContent = fmt(Math.max(0, remaining));
  timerEl.classList.remove('warning', 'urgent');
  if (remaining <= 60)       timerEl.classList.add('urgent');
  else if (remaining <= 300) timerEl.classList.add('warning');
  if (remaining <= 0) { clearInterval(countdown); allowLeave(); triggerAutoSubmit(); }
}, 1000);

// Per-question timer
const qTimerEl = document.getElementById('qTimer');
setInterval(() => {
  qElapsed++;
  qTimerEl.textContent = qElapsed > 60 ? `${Math.floor(qElapsed/60)}m ${qElapsed%60}s` : `${qElapsed}s`;
}, 1000);

// ── Select option (click on box) ───────────────────────────────────────────
function selectOption(key, boxEl) {
  const currentQId = String(questions[currentQuestionIndex]._id);

  // Clear all boxes
  document.querySelectorAll('.opt-box').forEach(b => {
    b.classList.remove('selected');
    const keySpan = b.querySelector('.opt-key');
    if (keySpan) { keySpan.className = keySpan.className.replace('bg-navy-950 border-navy-950 text-white','').trim() + ' border-slate-300 text-slate-500'; }
  });
  // Select clicked
  boxEl.classList.add('selected');
  const keySpan = boxEl.querySelector('.opt-key');
  if (keySpan) { keySpan.className = keySpan.className.replace('border-slate-300 text-slate-500','').trim() + ' bg-navy-950 border-navy-950 text-white'; }
  
  answers[currentQId] = { answer: key, savedAt: new Date() };

  // Auto-clear "Mark for Review" when student answers — answered takes priority
  const markedIdx = markedForReview.indexOf(currentQId);
  if (markedIdx !== -1) {
    markedForReview.splice(markedIdx, 1);
    const btn = document.getElementById('markReviewBtn');
    btn.className = 'text-xs font-semibold px-3 py-1.5 rounded-lg border transition-colors border-slate-200 text-slate-600 hover:border-violet-300';
    btn.textContent = 'Mark for Review';
  }

  saveToServer(key);
  renderPalette();
}

// ── Clear answer ───────────────────────────────────────────────────────────
function clearAnswer() {
  const currentQId = String(questions[currentQuestionIndex]._id);
  document.querySelectorAll('.opt-box').forEach(b => {
    b.classList.remove('selected');
    const ks = b.querySelector('.opt-key');
    if (ks) { ks.className = ks.className.replace('bg-navy-950 border-navy-950 text-white','').trim() + ' border-slate-300 text-slate-500'; }
  });
  answers[currentQId] = { answer: '', savedAt: new Date() };
  saveToServer('');
  renderPalette();
}

// ── Mark for review ────────────────────────────────────────────────────────
function toggleMark() {
  const currentQId = String(questions[currentQuestionIndex]._id);
  const idx = markedForReview.indexOf(currentQId);
  if (idx === -1) {
    markedForReview.push(currentQId);
  } else {
    markedForReview.splice(idx, 1);
  }
  
  const btn = document.getElementById('markReviewBtn');
  const isMarked = markedForReview.includes(currentQId);
  if (isMarked) {
    btn.className = 'text-xs font-semibold px-3 py-1.5 rounded-lg border transition-colors bg-violet-600 text-white border-violet-600';
    btn.textContent = 'Marked';
  } else {
    btn.className = 'text-xs font-semibold px-3 py-1.5 rounded-lg border transition-colors border-slate-200 text-slate-600 hover:border-violet-300';
    btn.textContent = 'Mark for Review';
  }
  saveToServer(answers[currentQId]?.answer || '');
  renderPalette();
}

// ── Save to server (with offline fallback) ───────────────────────────────
function saveToServer(ans) {
  const currentQId = String(questions[currentQuestionIndex]._id);
  const payload = {
    questionId: currentQId,
    answer: ans,
    markForReview: markedForReview.includes(currentQId),
    timeSpent: qElapsed
  };
  qElapsed = 0; // Reset question timer elapsed since we just synced it
  const url = `/exam/${TEST_ID}/save-answer`;

  if (!navigator.onLine) {
    if (typeof window.queueOfflineAnswer === 'function') {
      window.queueOfflineAnswer(url, payload);
    }
    console.warn('[Exam] Offline — answer queued for sync');
    return Promise.resolve();
  }

  return fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
  }).then(r => r.json()).catch(() => {
    if (typeof window.queueOfflineAnswer === 'function') {
      window.queueOfflineAnswer(url, payload);
    }
  });
}

// ── Client-Side Navigation ──────────────────────────────────────────────────
function isPrerequisiteVisited() {
  const physAndChemIds = questions
    .filter(q => q.subject === 'Physics' || q.subject === 'Chemistry')
    .map(q => String(q._id));
  if (physAndChemIds.length === 0) return true;
  return physAndChemIds.every(id => visitedQuestionIds.has(id));
}

function updateSectionState() {
  if (!cetSectionFlow || !sectionState) return;
  const isPrereqVisited = isPrerequisiteVisited();
  sectionState.sections.forEach(sec => {
    sec.locked = !['Physics', 'Chemistry'].includes(sec.name) && !isPrereqVisited;
  });
  
  // Re-calculate firstPendingQuestionNumber
  const firstUnlockedSection = sectionState.sections.find(sec => !sec.locked) || null;
  sectionState.firstPendingQuestionNumber = firstUnlockedSection
    ? firstUnlockedSection.questionIds.reduce((pendingNumber, questionId, questionIndex) => {
        if (pendingNumber) return pendingNumber;
        return visitedQuestionIds.has(questionId)
          ? null
          : firstUnlockedSection.questionNumbers[questionIndex];
      }, null) || firstUnlockedSection.questionNumbers[0]
    : 1;
}

function navigateToQuestion(newIndex) {
  if (newIndex < 0 || newIndex >= questions.length) return;
  if (navInProgress) return;

  // Check section locks for CET section tests
  if (cetSectionFlow && sectionState) {
    const targetQ = questions[newIndex];
    const targetQId = String(targetQ._id);
    const subject = sectionState.subjectById[targetQId] || targetQ.subject;
    const section = sectionState.sections.find(s => s.name === subject);
    if (section && section.locked) {
      navigateToQuestion(sectionState.firstPendingQuestionNumber - 1);
      return;
    }
  }

  // Save timing for current question
  const currentQId = String(questions[currentQuestionIndex]._id);
  questionTimings[currentQId] = (questionTimings[currentQId] || 0) + qElapsed;

  // Sync current question to server
  const currentAns = answers[currentQId]?.answer || '';
  saveToServer(currentAns);

  // Transition index
  currentQuestionIndex = newIndex;
  const nextQId = String(questions[currentQuestionIndex]._id);
  visitedQuestionIds.add(nextQId);

  // Update section states
  updateSectionState();

  // Render question UI
  renderQuestion(currentQuestionIndex);

  // Update history URL
  const newUrl = `/exam/${TEST_ID}/question/${currentQuestionIndex + 1}`;
  history.pushState({ index: currentQuestionIndex }, '', newUrl);
}

function renderQuestion(index) {
  const question = questions[index];
  const qId = String(question._id);

  // 1. Update header
  document.getElementById('questionNumberHeader').textContent = `Q ${index + 1} / ${questions.length}`;

  if (cetSectionFlow && sectionState) {
    const subject = sectionState.subjectById[qId] || question.subject;
    currentSection = sectionState.sections.find(sec => sec.name === subject);
    if (currentSection) {
      const secQNumber = currentSection.questionIds.indexOf(qId) + 1;
      const secHeader = document.getElementById('sectionHeader');
      secHeader.textContent = `${currentSection.name} ${secQNumber}/${currentSection.questionIds.length}`;
      secHeader.classList.remove('hidden');
    }
  } else {
    document.getElementById('sectionHeader').classList.add('hidden');
  }

  const topicInfo = question.topic ? ` › ${question.topic}` : '';
  document.getElementById('questionMeta').textContent = `${question.subject}${topicInfo} · ${question.difficulty} · ${question.marks} mark(s)`;

  // 2. Update question text and image
  const questionTextEl = document.getElementById('questionText');
  questionTextEl.textContent = question.question;
  delete questionTextEl.dataset.mathSource;
  delete questionTextEl.dataset.mathRendered;

  const questionImageContainer = document.getElementById('questionImageContainer');
  if (question.questionImage) {
    questionImageContainer.innerHTML = `<img src="${question.questionImage}" alt="Question" class="block w-auto h-auto max-w-full rounded-xl border border-slate-200 bg-white" loading="eager" decoding="async"/>`;
    questionImageContainer.classList.remove('hidden');
  } else {
    questionImageContainer.innerHTML = '';
    questionImageContainer.classList.add('hidden');
  }

  // 3. Update options
  const optionsContainer = document.getElementById('optionsContainer');
  optionsContainer.innerHTML = '';

  const selectedKey = answers[qId]?.answer || null;

  question.options.forEach(opt => {
    const optBox = document.createElement('div');
    optBox.className = `opt-box ${selectedKey === opt.key ? 'selected' : ''}`;
    optBox.onclick = () => selectOption(opt.key, optBox);

    const flexDiv = document.createElement('div');
    flexDiv.className = 'flex items-start gap-3';

    const keySpan = document.createElement('span');
    keySpan.className = `opt-key w-7 h-7 rounded-full border-2 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5 ${selectedKey === opt.key ? 'bg-navy-950 border-navy-950 text-white' : 'border-slate-300 text-slate-500'}`;
    keySpan.textContent = opt.key;

    const valSpan = document.createElement('span');
    valSpan.className = 'math-content text-sm text-slate-800 leading-relaxed pt-0.5';
    valSpan.textContent = opt.value;

    flexDiv.appendChild(keySpan);
    flexDiv.appendChild(valSpan);
    optBox.appendChild(flexDiv);

    if (opt.image) {
      const img = document.createElement('img');
      img.src = opt.image;
      img.alt = `Option ${opt.key}`;
      img.className = 'max-w-full max-h-36 rounded-xl border border-slate-200 object-contain mt-2 ml-10';
      optBox.appendChild(img);
    }

    optionsContainer.appendChild(optBox);
  });

  // 4. Update Mark for Review button
  const isMarked = markedForReview.includes(qId);
  const markReviewBtn = document.getElementById('markReviewBtn');
  if (isMarked) {
    markReviewBtn.className = 'text-xs font-semibold px-3 py-1.5 rounded-lg border transition-colors bg-violet-600 text-white border-violet-600';
    markReviewBtn.textContent = 'Marked';
  } else {
    markReviewBtn.className = 'text-xs font-semibold px-3 py-1.5 rounded-lg border transition-colors border-slate-200 text-slate-600 hover:border-violet-300';
    markReviewBtn.textContent = 'Mark for Review';
  }

  // 5. Update Navigation Buttons
  renderNavigationButtons(index);

  // 6. Update Palette
  renderPalette();

  // 7. Render KaTeX Math
  if (window.SPVNMath && typeof window.SPVNMath.renderStaticMath === 'function') {
    window.SPVNMath.renderStaticMath();
  }
}

function renderNavigationButtons(index) {
  const navContainer = document.getElementById('navButtonsContainer');
  if (!navContainer) return;
  navContainer.innerHTML = '';

  // 1. Back button
  if (index > 0) {
    const backBtn = document.createElement('button');
    backBtn.type = 'button';
    backBtn.className = 'flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-5 py-2.5 rounded-xl transition-colors text-sm absolute left-5';
    backBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>Back`;
    backBtn.onclick = () => navigateToQuestion(index - 1);
    navContainer.appendChild(backBtn);
  }

  // 2. Next button
  const centerDiv = document.createElement('div');
  centerDiv.className = 'mx-auto';

  if (index < questions.length - 1) {
    const nextBtn = document.createElement('button');
    nextBtn.type = 'button';
    nextBtn.className = 'flex items-center gap-2 bg-navy-950 hover:bg-navy-900 text-white font-semibold px-6 py-2.5 rounded-xl transition-colors text-sm';
    
    let nextBtnText = 'Save & Next';
    if (cetSectionFlow && currentSection) {
      const isSectionLast = currentSection.questionIds[currentSection.questionIds.length - 1] === String(questions[index]._id);
      const nextSec = isSectionLast ? sectionState.sections[currentSection.index + 1] : null;
      if (nextSec && !nextSec.locked) {
        nextBtnText = `Save & Start ${nextSec.name}`;
      }
    }
    nextBtn.innerHTML = `${nextBtnText}<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>`;
    nextBtn.onclick = () => navigateToQuestion(index + 1);
    centerDiv.appendChild(nextBtn);
  } else {
    const reviewBtn = document.createElement('button');
    reviewBtn.type = 'button';
    reviewBtn.className = 'flex items-center gap-2 bg-violet-600 hover:bg-violet-700 text-white font-semibold px-6 py-2.5 rounded-xl transition-colors text-sm';
    reviewBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>Save &amp; Review`;
    reviewBtn.onclick = () => openReviewModal();
    centerDiv.appendChild(reviewBtn);
  }
  navContainer.appendChild(centerDiv);

  // 3. Submit Exam button
  if (index === questions.length - 1) {
    const submitBtn = document.createElement('button');
    submitBtn.type = 'button';
    submitBtn.className = 'absolute right-5 bg-rose-600 hover:bg-rose-700 text-white font-semibold px-5 py-2.5 rounded-xl transition-colors text-sm flex items-center gap-2';
    submitBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>Submit Exam`;
    submitBtn.onclick = () => submitConfirm();
    navContainer.appendChild(submitBtn);
  }
}

function renderPalette() {
  const paletteContainer = document.getElementById('paletteContainer');
  if (!paletteContainer) return;
  paletteContainer.innerHTML = '';

  const isPrereqVisited = isPrerequisiteVisited();

  if (cetSectionFlow && sectionState) {
    const subjects = [];
    const questionsBySubject = {};

    questions.forEach((q, idx) => {
      const subject = q.subject || 'General';
      if (!questionsBySubject[subject]) {
        subjects.push(subject);
        questionsBySubject[subject] = [];
      }
      questionsBySubject[subject].push({ q, idx });
    });

    subjects.forEach(subject => {
      const isSubjectLocked = !['Physics', 'Chemistry'].includes(subject) && !isPrereqVisited;

      const sectionDiv = document.createElement('div');
      const header = document.createElement('p');
      header.className = 'text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5';
      header.textContent = `${subject} ${isSubjectLocked ? '🔒' : ''}`;
      sectionDiv.appendChild(header);

      const buttonsDiv = document.createElement('div');
      buttonsDiv.className = 'flex flex-wrap gap-1.5';

      questionsBySubject[subject].forEach(({ q, idx }) => {
        const qId = String(q._id);
        const answered = !!(answers[qId]?.answer);
        const marked = markedForReview.includes(qId);
        
        let bgStyle = 'background:#e2e8f0;color:#475569';
        if (answered && marked) bgStyle = 'background:#6d28d9;color:#fff';
        else if (answered) bgStyle = 'background:#10b981;color:#fff';
        else if (marked) bgStyle = 'background:#8b5cf6;color:#fff';
        else if (visitedQuestionIds.has(qId)) bgStyle = 'background:#f43f5e;color:#fff';

        if (isSubjectLocked) {
          const span = document.createElement('span');
          span.className = 'palette-btn bg-slate-100 text-slate-300 cursor-not-allowed';
          span.title = 'Visit every Physics and Chemistry question first';
          span.textContent = idx + 1;
          buttonsDiv.appendChild(span);
        } else {
          const a = document.createElement('a');
          a.href = `/exam/${TEST_ID}/question/${idx + 1}`;
          a.className = `palette-btn ${idx === currentQuestionIndex ? 'ring-2 ring-offset-1 ring-navy-950 scale-110' : ''}`;
          a.style = bgStyle;
          a.textContent = idx + 1;
          a.onclick = (e) => {
            e.preventDefault();
            navigateToQuestion(idx);
          };
          buttonsDiv.appendChild(a);
        }
      });

      sectionDiv.appendChild(buttonsDiv);
      paletteContainer.appendChild(sectionDiv);
    });
  } else {
    questions.forEach((q, idx) => {
      const qId = String(q._id);
      const answered = !!(answers[qId]?.answer);
      const marked = markedForReview.includes(qId);
      
      let bgStyle = 'background:#e2e8f0;color:#475569';
      if (answered && marked) bgStyle = 'background:#6d28d9;color:#fff';
      else if (answered) bgStyle = 'background:#10b981;color:#fff';
      else if (marked) bgStyle = 'background:#8b5cf6;color:#fff';
      else if (visitedQuestionIds.has(qId)) bgStyle = 'background:#f43f5e;color:#fff';

      const a = document.createElement('a');
      a.href = `/exam/${TEST_ID}/question/${idx + 1}`;
      a.className = `palette-btn ${idx === currentQuestionIndex ? 'ring-2 ring-offset-1 ring-navy-950 scale-110' : ''}`;
      a.style = bgStyle;
      a.textContent = idx + 1;
      a.onclick = (e) => {
        e.preventDefault();
        navigateToQuestion(idx);
      };
      paletteContainer.appendChild(a);
    });
  }

  const answeredCount = questions.filter(q => !!answers[String(q._id)]?.answer).length;
  const markedCount = markedForReview.length;
  document.getElementById('paletteAnsweredCount').textContent = answeredCount;
  document.getElementById('paletteUnansweredCount').textContent = questions.length - answeredCount;
  document.getElementById('paletteMarkedCount').textContent = markedCount;
}

window.addEventListener('popstate', (event) => {
  if (event.state && typeof event.state.index === 'number') {
    navigateToQuestion(event.state.index);
  } else {
    const match = window.location.pathname.match(/\/question\/(\d+)/);
    if (match) {
      const qNum = parseInt(match[1]);
      navigateToQuestion(qNum - 1);
    }
  }
});

// ── Submit confirm ─────────────────────────────────────────────────────────
function submitConfirm() {
  const answeredCount = questions.filter(q => !!answers[String(q._id)]?.answer).length;
  const markedCount = markedForReview.length;
  document.getElementById('submitAnsweredCount').textContent = answeredCount;
  document.getElementById('submitUnansweredCount').textContent = questions.length - answeredCount;
  document.getElementById('submitMarkedCount').textContent = markedCount;
  document.getElementById('submitModal').classList.remove('hidden');
}

// ── Review Modal Functions ────────────────────────────────────────────────
function openReviewModal() {
  const container = document.getElementById('reviewModalList');
  if (container) {
    container.innerHTML = '';
    questions.forEach((q, idx) => {
      const qId = String(q._id);
      const answered = !!(answers[qId]?.answer);
      const marked = markedForReview.includes(qId);
      
      let statusColor = 'text-slate-400';
      let statusText = 'Not Visited';
      let badgeBg = 'bg-slate-200 text-slate-500';

      if (answered && marked) {
        statusColor = 'text-purple-700';
        statusText = 'Ans+Marked';
        badgeBg = 'bg-purple-700 text-white';
      } else if (answered) {
        statusColor = 'text-emerald-600';
        statusText = 'Answered';
        badgeBg = 'bg-emerald-500 text-white';
      } else if (marked) {
        statusColor = 'text-violet-600';
        statusText = 'Marked';
        badgeBg = 'bg-violet-500 text-white';
      } else if (visitedQuestionIds.has(qId)) {
        statusColor = 'text-rose-500';
        statusText = 'Not Answered';
        badgeBg = 'bg-rose-500 text-white';
      }

      const a = document.createElement('a');
      a.href = `/exam/${TEST_ID}/question/${idx + 1}`;
      a.className = 'flex items-center justify-between px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors border border-transparent hover:border-slate-200';
      a.onclick = (e) => {
        e.preventDefault();
        navigateToQuestion(idx);
        closeReviewModal();
      };

      a.innerHTML = `
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-full text-xs font-bold flex items-center justify-center ${badgeBg}">
            ${idx + 1}
          </span>
          <span class="text-sm font-medium text-slate-700">Question ${idx + 1}</span>
        </div>
        <span class="text-xs font-semibold ${statusColor}">${statusText}</span>
      `;
      container.appendChild(a);
    });
  }

  const answeredCount = questions.filter(q => !!answers[String(q._id)]?.answer).length;
  const markedCount = markedForReview.length;
  document.getElementById('reviewAnsweredCount').textContent = answeredCount;
  document.getElementById('reviewUnansweredCount').textContent = questions.length - answeredCount;
  document.getElementById('reviewMarkedCount').textContent = markedCount;

  document.getElementById('reviewModal').classList.remove('hidden');
}

function closeReviewModal() {
  document.getElementById('reviewModal').classList.add('hidden');
}

// ── Fullscreen ─────────────────────────────────────────────────────────────
function toggleFullscreen() {
  if (!document.fullscreenElement) document.documentElement.requestFullscreen?.().catch(()=>{});
  else document.exitFullscreen?.();
}
window.addEventListener('load', () => setTimeout(() => document.documentElement.requestFullscreen?.().catch(()=>{}), 600));
document.addEventListener('fullscreenchange', () => {
  if (!document.fullscreenElement && SETTINGS.requireFullscreen) {
    reportViolation('fullscreenExit');
    showWarnBanner('⚠ Fullscreen exited! Click the fullscreen button to re-enter.', 'danger');
  }
});

// ── Violation report ───────────────────────────────────────────────────────
function reportViolation(type, onAutoSubmit) {
  return fetch(`/exam/${TEST_ID}/report-violation`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ type }),
  }).then(r => r.json()).then(d => {
    if (d.violations !== undefined) {
      document.getElementById('violationCount').textContent = d.violations;
      document.getElementById('violPlural').textContent = d.violations !== 1 ? 's' : '';
      document.getElementById('violationBar').classList.remove('hidden');
      document.getElementById('violationBar').classList.add('flex');
    }
    if (type === 'tabSwitch') tabSwitchCount = d.tabSwitches || tabSwitchCount + 1;
    if (type === 'focusLoss') focusLossCount = d.focusLosses || focusLossCount + 1;

    if (SETTINGS.autoSubmitOnViolation && type === 'tabSwitch') {
      const remaining = Math.max(0, SETTINGS.maxTabSwitches - tabSwitchCount);
      if (remaining > 0) {
        showWarnBanner(`⚠ Tab switch detected! ${remaining} more allowed before auto-submit.`, d.warningLevel === 'danger' ? 'danger' : 'warning');
      }
    }
    if (d.autoSubmit) {
      showAutoSubmitOverlay(d.warningMsg || 'Exam auto-submitted due to violations.');
    }
    return d;
  }).catch(() => {});
}

function showWarnBanner(msg, level = 'warning') {
  const b = document.getElementById('warnBanner');
  b.textContent = msg;
  b.className = b.className.replace(/bg-\S+/g, '');
  b.classList.add(level === 'danger' ? 'bg-red-700' : 'bg-amber-600');
  b.classList.remove('hidden');
  setTimeout(() => b.classList.add('hidden'), 6000);
}

function showAutoSubmitOverlay(msg) {
  const overlay = document.getElementById('tabSwitchOverlay');
  const msgEl = document.getElementById('tabSwitchMsg');
  if (msgEl) msgEl.textContent = msg;
  overlay.classList.remove('hidden');
  let count = 5;
  document.getElementById('tabCountdown').textContent = count;
  const t = setInterval(() => {
    count--;
    document.getElementById('tabCountdown').textContent = count;
    if (count <= 0) {
      clearInterval(t);
      triggerAutoSubmit();
    }
  }, 1000);
}

// ── Anti-cheat: tab switch detection ────────────────────────────────────
document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'hidden') {
    reportViolation('tabSwitch');
  }
});
let blurTimer;
window.addEventListener('blur', () => {
  blurTimer = setTimeout(() => {
    if (!document.hasFocus()) reportViolation('focusLoss');
  }, 800);
});
window.addEventListener('focus', () => clearTimeout(blurTimer));

// Block copy/paste if enabled by admin
if (SETTINGS.blockCopyPaste) {
  document.addEventListener('contextmenu', e => e.preventDefault());
  document.addEventListener('copy',  e => e.preventDefault());
  document.addEventListener('cut',   e => e.preventDefault());
  document.addEventListener('paste', e => e.preventDefault());
  document.addEventListener('keydown', e => {
    if (e.key==='F12' || (e.ctrlKey&&e.shiftKey&&e.key==='I') || (e.ctrlKey&&e.key==='u') || (e.ctrlKey&&e.key==='s')) e.preventDefault();
  });
}

// Fullscreen: only force if admin enabled requireFullscreen
if (SETTINGS.requireFullscreen) {
  window.addEventListener('load', () => setTimeout(() => document.documentElement.requestFullscreen?.().catch(()=>{}), 600));
}
window.addEventListener('focus', () => clearTimeout(blurTimer));

// ── Security ───────────────────────────────────────────────────────────────
document.addEventListener('contextmenu', e => e.preventDefault());
document.addEventListener('copy',  e => e.preventDefault());
document.addEventListener('cut',   e => e.preventDefault());
document.addEventListener('keydown', e => {
  if (e.key==='F12' || (e.ctrlKey&&e.shiftKey&&['I','J','C'].includes(e.key)) || (e.ctrlKey&&['u','s','a'].includes(e.key))) e.preventDefault();
});
// ── Auto-submit on leave (beacon) ──────────────────────────────────────────
let _leaveAllowed = false;
function allowLeave() { _leaveAllowed = true; }

function _beforeUnload(e) {
  if (_leaveAllowed) return;
  const activeQId = String(questions[currentQuestionIndex]._id);
  const blob = new Blob([JSON.stringify({
    questionId: activeQId,
    answer: answers[activeQId]?.answer || '',
    markForReview: markedForReview.includes(activeQId) ? 'true' : 'false',
    timeSpent: qElapsed,
  })], { type: 'application/json' });
  navigator.sendBeacon(`/exam/${TEST_ID}/leave`, blob);
  e.preventDefault();
  e.returnValue = 'Your current answer will be saved, but please use the in-app Prev/Next buttons to navigate.';
}
window.addEventListener('beforeunload', _beforeUnload);

function prepareSubmitForm(formId) {
  const currentQId = String(questions[currentQuestionIndex]._id);
  questionTimings[currentQId] = (questionTimings[currentQId] || 0) + qElapsed;
  qElapsed = 0;

  const prefix = formId === 'manualSubmitForm' ? 'manual' : 'auto';
  document.getElementById(prefix + 'AnswersInput').value = JSON.stringify(answers);
  document.getElementById(prefix + 'MarkedInput').value = JSON.stringify(markedForReview);
  document.getElementById(prefix + 'TimingsInput').value = JSON.stringify(questionTimings);
  document.getElementById(prefix + 'VisitedInput').value = JSON.stringify(Array.from(visitedQuestionIds));
}

function saveAndSubmit() {
  allowLeave();
  prepareSubmitForm('manualSubmitForm');
  document.getElementById('manualSubmitForm').submit();
}

function triggerAutoSubmit() {
  allowLeave();
  prepareSubmitForm('autoSubmitForm');
  document.getElementById('autoSubmitForm').submit();
}

function saveAndNav(e, href) {
  e.preventDefault();
  // Deprecated/stub for compatibility
}
</script>
<div id="paletteOverlay" class="hidden fixed inset-0 bg-black/40 z-30 md:hidden" onclick="togglePalette()"></div>

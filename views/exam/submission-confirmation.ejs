<%- include('../partials/head') %>
<div class="min-h-screen bg-slate-50 flex items-center justify-center px-5 py-10">
  <div class="w-full max-w-xl bg-white border border-slate-200 rounded-3xl shadow-xl overflow-hidden">
    <div class="bg-emerald-600 px-7 py-8 text-white text-center">
      <div class="w-16 h-16 mx-auto rounded-full bg-white/20 flex items-center justify-center text-3xl mb-4">✓</div>
      <h1 class="text-2xl font-bold">Submission Confirmed</h1>
      <p class="text-emerald-50 text-sm mt-2">Your answers have been saved successfully.</p>
    </div>
    <div class="p-7 space-y-5">
      <div class="rounded-2xl bg-slate-50 border border-slate-100 p-5">
        <p class="text-xs uppercase tracking-wider font-bold text-slate-400">Test</p>
        <p class="font-bold text-slate-900 mt-1"><%= submission.testTitle %></p>
        <div class="grid grid-cols-2 gap-4 mt-4 text-sm">
          <div><p class="text-xs text-slate-400">Status</p><p class="font-semibold text-emerald-700"><%= (submission.status||'submitted').replaceAll('_',' ').toUpperCase() %></p></div>
          <div><p class="text-xs text-slate-400">Submitted</p><p class="font-semibold text-slate-700"><%= submission.submittedAt ? new Date(submission.submittedAt).toLocaleString('en-IN',{timeZone:appTimeZone}) : 'Saved' %></p></div>
        </div>
      </div>
      <div class="rounded-2xl bg-amber-50 border border-amber-200 p-5">
        <p class="font-bold text-amber-900">Result not released yet</p>
        <p class="text-sm text-amber-800 mt-1"><%= release.message %></p>
        <p class="text-xs text-amber-700 mt-3">Marks, answers, rank, PDF and leaderboard remain hidden until release.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="/student/tests" class="text-center bg-navy-950 text-white rounded-xl py-3 font-semibold text-sm hover:bg-navy-800">Back to My Tests</a>
        <a href="/student/results" class="text-center border border-slate-200 text-slate-700 rounded-xl py-3 font-semibold text-sm hover:bg-slate-50">My Submissions</a>
      </div>
    </div>
  </div>
</div>
</body></html>

<%- include('../partials/head') %>
<div class="min-h-screen bg-slate-50 flex items-center justify-center p-5">
  <div class="w-full max-w-md bg-white rounded-2xl border border-slate-200 shadow-xl overflow-hidden">
    <div class="bg-navy-950 p-7 text-white text-center">
      <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center text-2xl mx-auto mb-4">🔑</div>
      <h1 class="text-xl font-bold"><%= test.title %></h1>
      <p class="text-sm text-white/60 mt-1"><%= timingLabel %> · <%= test.totalMarks %> marks</p>
    </div>
    <div class="p-7">
      <%- include('../partials/flash') %>
      <h2 class="font-bold text-slate-900">Password-protected test</h2>
      <p class="text-sm text-slate-500 mt-1 mb-5">Enter the password or PIN provided by your administrator. Repeated invalid attempts are temporarily rate-limited.</p>
      <form action="/exam/<%= test.id %>/unlock" method="POST" class="space-y-4">
        <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Test Password / PIN</label><input type="password" name="testAccessPassword" required maxlength="64" autocomplete="one-time-code" autofocus class="w-full border border-slate-300 rounded-xl px-4 py-3 text-lg tracking-wider focus:outline-none focus:ring-2 focus:ring-indigo-500"/></div>
        <button class="w-full rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5">Verify &amp; Continue</button>
      </form>
      <a href="/student/tests" class="block text-center text-sm text-slate-500 hover:text-slate-800 mt-4">Back to My Tests</a>
    </div>
  </div>
</div>
</body></html>
